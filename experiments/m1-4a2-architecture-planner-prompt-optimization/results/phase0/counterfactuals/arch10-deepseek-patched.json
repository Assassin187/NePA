  "modules": [
    {
      "consumes_contracts": [
        "contract-types"
      ],
      "id": "module-codec",
      "name": "Codec",
      "non_goals": [
        "Do not close network connections directly.",
        "Do not interpret subscriptions or match topics.",
        "Do not implement application-level keep-alive decisions."
      ],
      "owns_files": [
        "src/codec/codec_connack.c",
        "src/codec/codec_connect.c",
        "src/codec/codec_disconnect.c",
        "src/codec/codec_pingreq.c",
        "src/codec/codec_pingresp.c",
        "src/codec/codec_publish.c",
        "src/codec/codec_suback.c",
        "src/codec/codec_subscribe.c",
        "src/codec/codec_unsuback.c",
        "src/codec/codec_unsubscribe.c"
      ],
      "provides_contracts": [],
      "purpose": "Implement deterministic per-message encoding and validation for every MQTT control packet behind the frozen codec header.",
      "responsibilities": [
        "Implement mqtt_encode_* and mqtt_decode_* functions for the ten control packets.",
        "Validate fixed-header flags, remaining length, and message-specific field constraints.",
        "Reject malformed packets with a result the application maps to connection close.",
        "Encode big-endian integers, Variable Byte Integers, and MQTT UTF-8 strings."
      ]
    },
    {
      "consumes_contracts": [
        "contract-types"
      ],
      "id": "module-session",
      "name": "Session",
      "non_goals": [
        "Do not parse or encode MQTT packets.",
        "Do not own sockets or the application event loop.",
        "Do not route packets to other connections."
      ],
      "owns_files": [
        "src/session/mqtt_session.c"
      ],
      "provides_contracts": [],
      "purpose": "Own per-client session state, subscriptions, and topic matching rules.",
      "responsibilities": [
        "Track session lifecycle per clean-session policy.",
        "Store and remove subscriptions by exact UTF-8 filter.",
        "Match topic names against filters without normalization.",
        "Determine granted QoS for each accepted subscription."
      ]
    },
    {
      "consumes_contracts": [
        "contract-types"
      ],
      "id": "module-network",
      "name": "Network",
      "non_goals": [
        "Do not decode MQTT packet payloads.",
        "Do not maintain subscriptions or sessions.",
        "Do not decide application-level routing."
      ],
      "owns_files": [
        "src/net/mqtt_net.c"
      ],
      "provides_contracts": [],
      "purpose": "Own ordered byte-stream transport and per-connection lifecycle.",
      "responsibilities": [
        "Accept up to max_connections clients over TCP.",
        "Deliver incoming bytes as connection-tagged events.",
        "Write output batches to the correct connection.",
        "Close connections on protocol, resource, keep-alive, and disconnect conditions.",
        "Enforce keep-alive timeouts."
      ]
    },
    {
      "consumes_contracts": [
        "contract-types",
        "contract-codec",
        "contract-session",
        "contract-network"
      ],
      "id": "module-app",
      "name": "Application",
      "non_goals": [
        "Do not implement wire encoding or parsing.",
        "Do not own TCP sockets or byte-stream read/write primitives.",
        "Do not store subscription state."
      ],
      "owns_files": [
        "apps/mqtt_server_main.c"
      ],
      "provides_contracts": [],
      "purpose": "Own the server entry point and orchestrate codecs, sessions, and network events.",
      "responsibilities": [
        "Validate connection establishment and issue the first CONNACK.",
        "Dispatch decoded packets to session and network operations.",
        "Generate SUBACK, PINGRESP, and UNSUBACK responses.",
        "Contain transient errors so one client does not affect another."
      ]
    }
  ],
