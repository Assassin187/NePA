{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://NePA.local/schemas/specs-requirements.schema.json",
  "title": "Application Protocol Specification Ledger",
  "description": "Protocol-independent wire-format model and traceable ledger of selected specification requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "gold_set_id", "description", "source_sha256", "wire_format_reference", "requirements"],
  "properties": {
    "$schema": {"const": "https://NePA.local/schemas/specs-requirements.schema.json"},
    "gold_set_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wire_format_reference": {"$ref": "#/$defs/wire_format_reference"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[._:-][A-Za-z0-9]+)+$"
    },
    "structure_reference": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:/[a-z][a-z0-9]*(?:-[a-z0-9]+)*)*$"
    },
    "wire_format_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "wire_format_id"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[^/]+-wire-format[.]json$"
        },
        "wire_format_id": {"$ref": "#/$defs/identifier"}
      }
    },
    "non_empty_string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "locator", "excerpt"],
      "properties": {
        "section": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1},
        "locator": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 1}
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "unit", "definition"],
      "properties": {
        "kind": {"enum": ["binary", "text", "mixed"]},
        "unit": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1}
      }
    },
    "transport_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transport", "definition", "pdu_refs", "framing_refs", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "transport": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "pdu_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/structure_reference"}
        },
        "framing_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/structure_reference"}
        },
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "wire_data_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "representation", "definition", "constraints", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "representation": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "constraints": {"$ref": "#/$defs/non_empty_string_array"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "occurrence", "location", "representation", "definition", "constraints"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "occurrence": {"enum": ["one", "zero_or_one", "zero_or_more", "one_or_more"]},
        "location": {"type": "string", "minLength": 1},
        "representation": {"type": "string", "minLength": 1},
        "data_type_ref": {"$ref": "#/$defs/structure_reference"},
        "definition": {"type": "string", "minLength": 1},
        "constraints": {"$ref": "#/$defs/non_empty_string_array"},
        "source": {"$ref": "#/$defs/source"},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/field"}
        }
      }
    },
    "layout_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "order", "occurrence", "definition"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "occurrence": {"enum": ["one", "zero_or_one", "zero_or_more", "one_or_more"]},
        "definition": {"type": "string", "minLength": 1},
        "fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/field"}
        }
      }
    },
    "framing_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "applies_when", "definition", "field_refs", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": [
            "fixed_length",
            "length_prefixed",
            "delimiter_terminated",
            "transport_delimited",
            "connection_delimited",
            "syntax_delimited",
            "composite"
          ]
        },
        "applies_when": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "field_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/structure_reference"}
        },
        "delimiter": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1}
      }
    },
    "field_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_ref", "representation", "definition"],
      "properties": {
        "field_ref": {"$ref": "#/$defs/structure_reference"},
        "value": {"type": ["string", "integer"]},
        "representation": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1}
      }
    },
    "type_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "name", "status", "definition", "directions", "field_overrides"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "value": {"type": ["string", "integer"]},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["defined", "reserved", "forbidden"]},
        "definition": {"type": "string", "minLength": 1},
        "directions": {
          "type": "array",
          "items": {"$ref": "#/$defs/direction"}
        },
        "field_overrides": {
          "type": "array",
          "items": {"$ref": "#/$defs/field_override"}
        },
        "layout": {
          "type": "array",
          "items": {"$ref": "#/$defs/layout_component"}
        }
      }
    },
    "type_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "selection_method", "definition", "source", "types"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "selection_method": {"enum": ["field_value", "syntax", "context", "transport", "other"]},
        "field_ref": {"$ref": "#/$defs/structure_reference"},
        "definition": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/type_option"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"selection_method": {"const": "field_value"}},
            "required": ["selection_method"]
          },
          "then": {"required": ["field_ref"]}
        }
      ]
    },
    "protocol_data_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "definition",
        "encoding",
        "source",
        "framing",
        "layout",
        "type_selectors"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "encoding": {"$ref": "#/$defs/encoding"},
        "source": {"$ref": "#/$defs/source"},
        "framing": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/framing_rule"}
        },
        "layout": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/layout_component"}
        },
        "type_selectors": {
          "type": "array",
          "items": {"$ref": "#/$defs/type_selector"}
        }
      }
    },
    "wire_format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_version", "description", "data_types", "protocol_data_units"],
      "properties": {
        "model_version": {"const": "1.1"},
        "description": {"type": "string", "minLength": 1},
        "data_types": {
          "type": "array",
          "items": {"$ref": "#/$defs/wire_data_type"}
        },
        "transport_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/transport_binding"}
        },
        "protocol_data_units": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/protocol_data_unit"}
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "modality", "statement", "preconditions", "constraints", "exceptions", "references", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/requirement_id"},
        "source": {"$ref": "#/$defs/source"},
        "modality": {"enum": ["MUST", "MUST_NOT", "SHOULD", "SHOULD_NOT", "MAY", "REQUIRED", "PROHIBITED", "INFORMATIVE"]},
        "statement": {"type": "string", "minLength": 1},
        "preconditions": {"$ref": "#/$defs/non_empty_string_array"},
        "constraints": {"$ref": "#/$defs/non_empty_string_array"},
        "exceptions": {"$ref": "#/$defs/non_empty_string_array"},
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirement_id"}
        },
        "structure_references": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/structure_reference"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
