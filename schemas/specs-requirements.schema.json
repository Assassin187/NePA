{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://NePA.local/schemas/specs-requirements.schema.json",
  "title": "MQTT 3.1.1 Specification Requirements",
  "description": "Traceable MQTT 3.1.1 packet structure and ledger of selected specification requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "gold_set_id", "description", "source_sha256", "packet_structure", "requirements"],
  "properties": {
    "$schema": {"const": "https://NePA.local/schemas/specs-requirements.schema.json"},
    "gold_set_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packet_structure": {"$ref": "#/$defs/packet_structure"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    }
  },
  "$defs": {
    "requirement_id": {
      "type": "string",
      "pattern": "^MQTT-(?:[0-9]+\\.)+[0-9]+-[0-9]+$"
    },
    "non_empty_string_array": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "page", "locator", "excerpt"],
      "properties": {
        "section": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1},
        "locator": {"type": "string", "minLength": 1},
        "excerpt": {"type": "string", "minLength": 1}
      }
    },
    "packet_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "location", "representation", "definition"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "representation": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1}
      }
    },
    "packet_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "order", "presence", "definition", "fields"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "presence": {"enum": ["always", "conditional"]},
        "definition": {"type": "string", "minLength": 1},
        "fields": {
          "type": "array",
          "items": {"$ref": "#/$defs/packet_field"}
        }
      }
    },
    "packet_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_data_unit", "definition", "source", "components"],
      "properties": {
        "protocol_data_unit": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/source"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/packet_component"}
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "modality", "statement", "preconditions", "constraints", "exceptions", "references", "confidence"],
      "properties": {
        "id": {"$ref": "#/$defs/requirement_id"},
        "source": {"$ref": "#/$defs/source"},
        "modality": {"enum": ["MUST", "MUST_NOT", "SHOULD", "SHOULD_NOT", "MAY", "REQUIRED", "PROHIBITED", "INFORMATIVE"]},
        "statement": {"type": "string", "minLength": 1},
        "preconditions": {"$ref": "#/$defs/non_empty_string_array"},
        "constraints": {"$ref": "#/$defs/non_empty_string_array"},
        "exceptions": {"$ref": "#/$defs/non_empty_string_array"},
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/requirement_id"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
