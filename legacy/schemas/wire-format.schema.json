{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://NePA.local/schemas/wire-format.schema.json",
  "title": "Application Protocol Wire Format",
  "description": "Protocol-independent, traceable wire-format specification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "wire_format_id", "protocol", "protocol_version", "source_sha256", "model_version", "description", "data_types", "protocol_data_units"],
  "properties": {
    "$schema": {"const": "https://NePA.local/schemas/wire-format.schema.json"},
    "wire_format_id": {"$ref": "specs-requirements.schema.json#/$defs/identifier"},
    "protocol": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_version": {"const": "1.1"},
    "description": {"type": "string", "minLength": 1},
    "data_types": {
      "type": "array",
      "items": {"$ref": "specs-requirements.schema.json#/$defs/wire_data_type"}
    },
    "transport_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "specs-requirements.schema.json#/$defs/transport_binding"}
    },
    "protocol_data_units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "specs-requirements.schema.json#/$defs/protocol_data_unit"}
    }
  }
}
