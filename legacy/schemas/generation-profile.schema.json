{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://NePA.local/schemas/generation-profile.schema.json",
  "title": "Protocol Code Generation Profile",
  "description": "A product-scope contract that selects a closed implementation subset from protocol fact specifications without adding facts to those specifications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "profile_id",
    "profile_version",
    "protocol",
    "protocol_version",
    "role",
    "description",
    "conformance_claim",
    "spec_references",
    "transport",
    "packet_scope",
    "capabilities",
    "evaluation_input_contract"
  ],
  "properties": {
    "$schema": {
      "const": "https://NePA.local/schemas/generation-profile.schema.json"
    },
    "profile_id": {
      "$ref": "specs-requirements.schema.json#/$defs/identifier"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+[.][0-9]+$"
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "conformance_claim": {
      "type": "string",
      "minLength": 1
    },
    "spec_references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wire_format", "requirements"],
      "properties": {
        "wire_format": {
          "$ref": "#/$defs/spec_reference"
        },
        "requirements": {
          "$ref": "#/$defs/spec_reference"
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "stream_properties", "endpoint"],
      "properties": {
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "stream_properties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packet_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_to_server", "server_to_client"],
      "properties": {
        "client_to_server": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/packet_entry"
          }
        },
        "server_to_client": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/packet_entry"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "evaluation_input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_profile_inputs",
        "excluded_valid_inputs",
        "malformed_input_expectation"
      ],
      "properties": {
        "in_profile_inputs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "excluded_valid_inputs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "malformed_input_expectation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "spec_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "id"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[^/]+[.]json$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "packet_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "support", "constraints", "requirement_refs"],
      "properties": {
        "type": {
          "enum": [
            "CONNECT",
            "CONNACK",
            "PUBLISH",
            "PUBACK",
            "PUBREC",
            "PUBREL",
            "PUBCOMP",
            "SUBSCRIBE",
            "SUBACK",
            "UNSUBSCRIBE",
            "UNSUBACK",
            "PINGREQ",
            "PINGRESP",
            "DISCONNECT"
          ]
        },
        "support": {
          "enum": ["required", "excluded"]
        },
        "constraints": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "requirement_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "specs-requirements.schema.json#/$defs/requirement_id"
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "support", "statement", "constraints", "requirement_refs"],
      "properties": {
        "id": {
          "$ref": "specs-requirements.schema.json#/$defs/identifier"
        },
        "support": {
          "enum": ["required", "excluded"]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "requirement_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "specs-requirements.schema.json#/$defs/requirement_id"
          }
        }
      }
    }
  }
}
