{
  "schema_version": "1.0",
  "roles": [
    "server"
  ],
  "language": {
    "name": "C",
    "version": "C99"
  },
  "clean": [
    "make",
    "clean"
  ],
  "builds": [
    {
      "id": "release",
      "argv": [
        "make",
        "release"
      ],
      "artifact": "build/release/protocol-server",
      "required_flags": [
        "-std=c99",
        "-Wall",
        "-Wextra",
        "-Werror"
      ]
    },
    {
      "id": "san",
      "argv": [
        "make",
        "san"
      ],
      "artifact": "build/san/protocol-server",
      "required_flags": [
        "-std=c99",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-fsanitize=address,undefined",
        "-fno-pie",
        "-no-pie"
      ]
    }
  ],
  "run": [
    "{artifact}"
  ],
  "description": "Public terminating C99 tool fixture. Server role and artifact names are retained solely for Target1 compatibility; execute without arguments, print the fixture stdout, exit zero within two seconds. No listener or server loop."
}
