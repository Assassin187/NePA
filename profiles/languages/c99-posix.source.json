{
  "schema_version": "1.0",
  "asset": {
    "id": "c99-posix",
    "version": "1.0.0",
    "description": "Protocol-neutral C99 on Linux/POSIX sockets with warning-clean make variants."
  },
  "language": {"id": "c", "standard": "c99", "extensions": []},
  "platform": {"os": "linux", "api_families": ["posix-sockets", "posix-select"]},
  "toolchain": {
    "build_system": "gnu-make",
    "compiler": "gcc",
    "archiver": "ar",
    "build_file_template": {"path": "profiles/templates/c99-posix/Makefile.j2"}
  },
  "build_variants": [
    {
      "id": "release",
      "description": "Warning-clean debug-friendly build.",
      "command": ["make"],
      "compiler_flags": ["-std=c99", "-Wall", "-Wextra", "-Werror", "-O0", "-g"],
      "sanitizers": [],
      "required": true
    },
    {
      "id": "san",
      "description": "AddressSanitizer and UndefinedBehaviorSanitizer build.",
      "command": ["make", "SAN=1"],
      "compiler_flags": ["-std=c99", "-Wall", "-Wextra", "-Werror", "-O0", "-g"],
      "sanitizers": ["address", "undefined"],
      "required": true
    }
  ],
  "file_types": {
    "source_extensions": [".c"],
    "header_extensions": [".h"],
    "include_directories": ["include"]
  },
  "type_mappings": [
    {
      "id": "uint8-scalar",
      "match": {"spec_type_id": "uint8", "shape": "scalar"},
      "representation": "uint8_t",
      "mechanical_rule": "Use stdint.h uint8_t."
    },
    {
      "id": "uint16-scalar",
      "match": {"spec_type_id": "uint16_be", "shape": "scalar"},
      "representation": "uint16_t",
      "mechanical_rule": "Store host order; convert only in codec code."
    },
    {
      "id": "uint32-scalar",
      "match": {"spec_type_id": "uint32_be", "shape": "scalar"},
      "representation": "uint32_t",
      "mechanical_rule": "Store host order; convert only in codec code."
    },
    {
      "id": "decoded-varint",
      "match": {"encoding_kind": "varint", "shape": "scalar"},
      "representation": "uint32_t",
      "mechanical_rule": "Store the decoded scalar; encode only at the wire boundary."
    }
  ],
  "runtime_constraints": {
    "third_party_dependencies": "forbidden",
    "threads": "forbidden",
    "dynamic_allocation": "restricted",
    "network_apis": ["socket", "select"],
    "constraints": [
      "Codec paths never allocate dynamically.",
      "One-time caller-owned storage allocation for opaque session/core objects is allowed.",
      "Check external lengths before access."
    ]
  },
  "style": {
    "indent_spaces": 4,
    "max_function_lines": 80,
    "max_file_lines": 400,
    "warnings_as_errors": true,
    "production_assertions": "forbidden"
  }
}
