{"asset":{"description":"MQTT 3.1.1 client, CLI tools, and bounded single-thread broker delivery.","id":"mqtt-client-broker","version":"1.0.0"},"constraints":["Connection id zero is invalid; live connections use stable non-zero uint32 identifiers.","Every broker event starts with an empty output batch.","Capacity failure is atomic: return no partial outputs and never report success.","Oversized input or output returns MQTT_ERR_RESOURCE_LIMIT and closes its source connection.","The network layer routes output by conn_id and contains no subscription semantics."],"deliverables":[{"entry_contract_ids":["codec-cli"],"id":"codec-tool","kind":"adapter","protocol_role":"client","purpose":"Expose packet encoding and decoding to black-box tests."},{"entry_contract_ids":["client-cli"],"id":"client-cli-app","kind":"client","protocol_role":"client","purpose":"Publish and subscribe through the frozen command-line contract."},{"entry_contract_ids":["broker-process"],"id":"broker-app","kind":"broker","protocol_role":"broker","purpose":"Serve bounded MQTT connections over IPv4 TCP."}],"external_contracts":[{"entrypoints":[{"description":"Run the selected make variant.","id":"make-all","kind":"build"}],"id":"build-system","interface_files":["Makefile"],"purpose":"Build all required targets and variants.","ready_gate":"s5"},{"entrypoints":[{"description":"Invoke encode or decode.","id":"codec-command","kind":"cli"}],"id":"codec-cli","interface_files":["include/mqtt/mqtt_codec.h","apps/mqtt_codec_cli.c"],"purpose":"Encode and decode MQTT packets through the public CLI.","ready_gate":"task"},{"entrypoints":[{"description":"Invoke pub or sub.","id":"client-command","kind":"cli"}],"id":"client-cli","interface_files":["apps/mqtt_client_cli.c"],"purpose":"Publish or subscribe through the public client CLI.","ready_gate":"task"},{"entrypoints":[{"description":"Start the broker on a port.","id":"broker-command","kind":"network"}],"id":"broker-process","interface_files":["apps/mqtt_broker_main