CC ?= cc
CFLAGS ?= -std=c99 -Wall -Wextra -Werror -O0 -g -fno-pie -no-pie
SOURCES := {{ sources }}
TARGET := {{ target }}
all: $(TARGET)
$(TARGET): $(SOURCES)
	mkdir -p $(dir $(TARGET))
	$(CC) $(CFLAGS) $(SOURCES) -o $(TARGET)
clean:
	rm -f $(TARGET)
release: all
san: CFLAGS += -fsanitize=address,undefined
san: all
