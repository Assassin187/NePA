{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/lease-authorization.schema.json",
  "title": "NePA bounded S6 F1 lease authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "active_plan_ref", "baseline_commit", "baseline_tree", "current_task_id", "current_task_uid", "lenders"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "active_plan_ref": {"$ref": "#/$defs/planRef"},
    "baseline_commit": {"$ref": "#/$defs/commit"},
    "baseline_tree": {"$ref": "#/$defs/sha256"},
    "current_task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
    "current_task_uid": {"$ref": "#/$defs/uid"},
    "lenders": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/lender"}},
    "authorization_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "planRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "version", "revision_seq", "epoch"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}, "revision_seq": {"type": "integer", "minimum": 0}, "epoch": {"type": "string", "pattern": "^E[0-9]+$"}}},
    "lender": {"type": "object", "additionalProperties": false, "required": ["task_id", "task_uid", "paths", "evidence_refs"], "properties": {"task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}, "task_uid": {"$ref": "#/$defs/uid"}, "paths": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}}}
  }
}
