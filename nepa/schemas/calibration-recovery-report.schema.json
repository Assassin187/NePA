{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-recovery-report.schema.json","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","version","attempt","model_id","trial_count","calibration_report_ref","schema_after_format_repair_rate","p0","p1","truncations","infrastructure_valid","repair_regressions","locality_complete","screening_pass"],"properties":{"schema_version":{"const":"1.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version":{"enum":["r0","r1","r2"]},"attempt":{"type":"integer","minimum":1},"model_id":{"enum":["qwen","deepseek"]},"trial_count":{"const":5},"calibration_report_ref":{"$ref":"#/$defs/ref"},"schema_after_format_repair_rate":{"type":"number","minimum":0,"maximum":1},"p0":{"type":"number","minimum":0,"maximum":1},"p1":{"type":"number","minimum":0,"maximum":1},"truncations":{"type":"integer","minimum":0},"infrastructure_valid":{"type":"boolean"},"repair_regressions":{"type":"integer","minimum":0},"locality_complete":{"type":"boolean"},"screening_pass":{"type":"boolean"}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
