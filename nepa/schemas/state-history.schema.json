{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/state-history.schema.json",
  "title": "NePA sequential Plan State history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_seq", "event_type", "plan_ref", "event", "state"],
      "properties": {
        "event_seq": {"type": "integer", "minimum": 1},
        "event_type": {"type": "string", "minLength": 1},
        "plan_ref": {"type": "object", "required": ["path", "sha256", "version", "revision_seq", "epoch"]},
        "event": {"type": "object"},
        "state": {"type": "object", "required": ["schema_version", "plan_ref", "tasks", "evidence_counters", "s6_attempts_used"]}
      }
    }
  }
}
