{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/migration-report.schema.json",
  "title": "NePA complete Plan migration report",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "from_version", "to_version", "counts", "preservation_rate", "tasks", "files"],
  "properties": {"schema_version": {"const": "1.0"}, "from_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}, "to_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}, "counts": {"$ref": "#/$defs/counts"}, "preservation_rate": {"type": "number", "minimum": 0, "maximum": 1}, "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}, "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}, "pending_groups": {"type": "array", "items": {"$ref": "#/$defs/pendingGroup"}}, "re_adopt": {"type": "array", "items": {"$ref": "#/$defs/reAdopt"}}},
  "$defs": {
    "counts": {"type": "object", "additionalProperties": false, "required": ["inherit", "revalidate", "amend", "regenerate"], "properties": {"inherit": {"type": "integer", "minimum": 0}, "revalidate": {"type": "integer", "minimum": 0}, "amend": {"type": "integer", "minimum": 0}, "regenerate": {"type": "integer", "minimum": 0}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["old_task_id", "old_task_uid", "new_task_id", "new_task_uid", "classification", "reason", "old_attempts"], "properties": {"old_task_id": {"type": ["string", "null"], "pattern": "^T-[0-9]{3}$"}, "old_task_uid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"}, "merged_from": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}, "merged_from_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T-[0-9]{3}$"}}, "new_task_id": {"type": ["string", "null"], "pattern": "^T-[0-9]{3}$"}, "new_task_uid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"}, "classification": {"enum": ["INHERIT", "REVALIDATE", "AMEND", "REGENERATE"]}, "reason": {"type": "string", "minLength": 1}, "old_attempts": {"type": "integer", "minimum": 0}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "old_owner_uid", "new_owner_uid", "classification"], "properties": {"path": {"type": "string", "minLength": 1}, "old_owner_uid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"}, "new_owner_uid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"}, "classification": {"enum": ["INHERIT", "REVALIDATE", "AMEND", "REGENERATE"]}}},
    "pendingGroup": {"type": "object", "additionalProperties": false, "required": ["group_id", "member_task_uids", "affected_paths", "affected_symbols", "build_artifact_ids"], "properties": {"group_id": {"type": "string", "pattern": "^g-[1-9][0-9]*-[1-9][0-9]*$"}, "member_task_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}, "affected_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "affected_symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "build_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "reAdopt": {"type": "object", "additionalProperties": false, "required": ["quarantine_path", "target_path", "owner", "content_sha256"], "properties": {"quarantine_path": {"type": "string", "pattern": "^_orphan/E[1-9][0-9]*/.+$"}, "target_path": {"type": "string", "minLength": 1}, "owner": {"type": "object", "additionalProperties": false, "required": ["task_uid", "task_id"], "properties": {"task_uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}}}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
