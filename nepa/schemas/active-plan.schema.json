{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/active-plan.schema.json",
  "title": "NePA active Plan pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "path", "sha256", "revision_seq", "epoch"],
  "properties": {
    "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "path": {"type": "string", "pattern": "^plan/versions/plan-1\\.[0-9]+\\.[0-9]+\\.json$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision_seq": {"type": "integer", "minimum": 0},
    "epoch": {"type": "string", "pattern": "^E[0-9]+$"}
  }
}
