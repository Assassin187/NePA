{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/s6-validation.schema.json",
  "title": "NePA S6 deterministic revalidation record",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_uid", "evidence_seq", "migration_ref", "baseline_commit", "baseline_tree", "status", "build_result_refs", "smoke_result_refs", "failure_ref", "evidence_ref"],
  "properties": {
    "schema_version": {"const": "1.0"}, "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}, "task_uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "evidence_seq": {"type": "integer", "minimum": 1},
    "migration_ref": {"$ref": "#/$defs/migrationRef"}, "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "baseline_tree": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "status": {"enum": ["started", "failed", "succeeded"]},
    "build_result_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "smoke_result_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "failure_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "evidence_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "started"}}}, "then": {"properties": {"build_result_refs": {"maxItems": 0}, "smoke_result_refs": {"maxItems": 0}, "failure_ref": {"type": "null"}, "evidence_ref": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"required": ["failure_ref"], "properties": {"failure_ref": {"$ref": "#/$defs/ref"}, "evidence_ref": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"properties": {"build_result_refs": {"minItems": 1}, "smoke_result_refs": {"minItems": 1}, "failure_ref": {"type": "null"}, "evidence_ref": {"$ref": "#/$defs/ref"}}}}
  ],
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "migrationRef": {"type": "object", "additionalProperties": false, "required": ["revision_seq", "event_seq"], "properties": {"revision_seq": {"type": "integer", "minimum": 1}, "event_seq": {"type": "integer", "minimum": 1}}}
  }
}
