{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-prompt-version-bundle.schema.json","title":"M1-4a2 prompt bundle version","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","version","status","protocol_ref","bundle_ref","semantic_depth","base_trial_count","model_ids","repair_mode"],"properties":{"schema_version":{"const":"3.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version":{"enum":["v0","v1","v2","v3","v4"]},"status":{"enum":["admitted","assessed","selected","failed","invalid"]},"protocol_ref":{"$ref":"#/$defs/ref"},"bundle_ref":{"$ref":"#/$defs/ref"},"semantic_depth":{"const":2},"base_trial_count":{"const":3},"model_ids":{"const":["qwen","claude","deepseek"]},"repair_mode":{"const":"patch"}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
