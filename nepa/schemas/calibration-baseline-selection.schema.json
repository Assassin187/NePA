{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-baseline-selection.schema.json","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","status","selected_version","bundle_ref","assessment_ref","reason","comparison_tuples","assessment_refs"],"properties":{"schema_version":{"const":"4.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"status":{"enum":["selected","diagnostic"]},"selected_version":{"enum":["v0","v1","v2"]},"bundle_ref":{"$ref":"#/$defs/ref"},"assessment_ref":{"$ref":"#/$defs/ref"},"reason":{"type":"string","minLength":1},"comparison_tuples":{"type":"object","minProperties":1,"maxProperties":3,"patternProperties":{"^v[0-2]$":{"type":"array","minItems":5,"maxItems":5}},"additionalProperties":false},"assessment_refs":{"type":"object","minProperties":1,"maxProperties":3,"patternProperties":{"^v[0-2]$":{"$ref":"#/$defs/ref"}},"additionalProperties":false}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
