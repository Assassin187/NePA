{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/calibration-development-selection.schema.json",
  "title": "Prompt development selection or tie",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lineage_id", "status", "selected_version", "prompt_ref", "prompt_sha256", "assessment_ref", "reason", "comparison_tuples", "assessment_refs"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "lineage_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["selected", "selection-tie"]},
    "selected_version": {"type": ["string", "null"], "enum": ["v0", "v1", "v2", null]},
    "prompt_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "prompt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "assessment_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "reason": {"type": "string", "minLength": 1},
    "comparison_tuples": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {"^v[0-2]$": {"type": "array", "minItems": 4, "maxItems": 4}}
    },
    "assessment_refs": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {"^v[0-2]$": {"$ref": "#/$defs/ref"}}
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
