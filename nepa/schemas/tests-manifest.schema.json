{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/tests-manifest.schema.json",
  "title": "NePA tests_manifest.json v2.0",
  "description": "Versioned Test Bundle metadata. Planning consumes only the explicit visibility whitelist; layer remains execution-only.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "2.0" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/test_entry" }
    }
  },
  "required": ["schema_version", "tests"],
  "additionalProperties": false,
  "$defs": {
    "generic_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "req_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$"
    },
    "test_entry": {
      "type": "object",
      "properties": {
        "nodeid": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["l0", "l1", "l2", "l3"] },
        "req_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/req_id" }
        },
        "gate": { "enum": ["s5", "task", "s7_only"] },
        "required_contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/generic_id" }
        },
        "build_variant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/generic_id" }
        }
      },
      "required": [
        "nodeid",
        "description",
        "layer",
        "req_ids",
        "gate",
        "required_contracts"
      ],
      "additionalProperties": false
    }
  }
}
