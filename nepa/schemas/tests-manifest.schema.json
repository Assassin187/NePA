{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/tests-manifest.schema.json",
  "title": "NePA tests_manifest.json v1.0",
  "description": "设计文档 5.3：gold 测试清单，由收集脚本生成（M0-6）。5.3 描述为条目数组；按 5 章通用约定（顶层必须带 schema_version）包装为对象，条目置于 tests。",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "nodeid": {
            "description": "pytest nodeid",
            "type": "string",
            "minLength": 1
          },
          "layer": { "enum": ["l0", "l1", "l2", "l3"] },
          "req_ids": {
            "description": "5.3 规则 2：每个测试必须带 @pytest.mark.req 标注",
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$" }
          },
          "description": {
            "description": "测试函数 docstring 首行",
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["nodeid", "layer", "req_ids", "description"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "tests"],
  "additionalProperties": false
}
