{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NePA specification review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issues", "extraction_failed_segments", "unchecked_scope_exclusions", "passed"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "element", "description", "suggestion"],
        "properties": {
          "severity": {"enum": ["blocker", "major", "minor"]},
          "element": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "suggestion": {"type": "string", "minLength": 1}
        }
      }
    },
    "extraction_failed_segments": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "unchecked_scope_exclusions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "passed": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "issues": {
            "contains": {
              "properties": {"severity": {"const": "blocker"}}
            }
          }
        }
      },
      "then": {"properties": {"passed": {"const": false}}},
      "else": {"properties": {"passed": {"const": true}}}
    }
  ]
}
