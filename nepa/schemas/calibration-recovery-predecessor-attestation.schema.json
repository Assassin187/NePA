{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/calibration-recovery-predecessor-attestation.schema.json",
  "title": "Current-contract M1-4a2 tie attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "predecessor_lineage_id", "predecessor_graph_sha256", "protocol_status", "versions", "model_ids", "gate_ids", "assessment_refs", "comparison_tuples", "outcome", "selection_absent", "handoff_absent", "inventory"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "predecessor_lineage_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predecessor_graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_status": {"const": "initialized"},
    "versions": {"const": ["v0", "v1", "v2"]},
    "model_ids": {"const": ["qwen", "claude", "deepseek"]},
    "gate_ids": {"const": ["arch_01", "arch_02", "arch_03", "arch_04", "arch_05", "arch_06", "arch_07", "arch_08", "arch_09", "arch_10", "arch_11", "arch_12", "arch_13", "arch_14", "arch_15"]},
    "assessment_refs": {"$ref": "#/$defs/versionRefs"},
    "comparison_tuples": {"$ref": "#/$defs/versionTuples"},
    "outcome": {"const": "PROMPT_SELECTION_TIE"},
    "selection_absent": {"const": true},
    "handoff_absent": {"const": true},
    "inventory": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/workspaceRef"}}
  },
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "workspaceRef": {
      "type": "object", "additionalProperties": false, "required": ["workspace_path", "sha256"],
      "properties": {"workspace_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "versionRefs": {"type": "object", "additionalProperties": false, "required": ["v0", "v1", "v2"], "properties": {"v0": {"$ref": "#/$defs/ref"}, "v1": {"$ref": "#/$defs/ref"}, "v2": {"$ref": "#/$defs/ref"}}},
    "versionTuples": {"type": "object", "additionalProperties": false, "required": ["v0", "v1", "v2"], "properties": {"v0": {"type": "array", "minItems": 4, "maxItems": 4}, "v1": {"type": "array", "minItems": 4, "maxItems": 4}, "v2": {"type": "array", "minItems": 4, "maxItems": 4}}}
  }
}
