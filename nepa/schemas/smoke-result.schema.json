{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/smoke-result.schema.json",
  "title": "NePA E0 smoke result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tree_sha256", "variant", "artifact", "command", "dwell_seconds", "term_grace_seconds", "observed_exit_code", "normalized_exit_code", "stdout", "stderr", "timed_out", "sanitizer_clean", "status"],
  "properties": {
    "schema_version": {"const": "1.0"}, "tree_sha256": {"$ref": "#/$defs/sha256"}, "variant": {"type": "string", "minLength": 1}, "artifact": {"type": "string", "minLength": 1}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "dwell_seconds": {"type": "integer", "minimum": 1}, "term_grace_seconds": {"type": "integer", "minimum": 1}, "observed_exit_code": {"type": ["integer", "null"]}, "normalized_exit_code": {"type": ["integer", "null"]}, "stdout": {"type": "string"}, "stderr": {"type": "string"}, "timed_out": {"type": "boolean"}, "sanitizer_clean": {"type": "boolean"}, "status": {"enum": ["passed", "failed"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
