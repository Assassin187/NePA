{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/plan-state.schema.json",
  "title": "NePA Plan State v1.0",
  "description": "设计文档 5.2.4：S6 可变执行账本。",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_ref": { "$ref": "#/$defs/file_ref" },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task_state" }
    }
  },
  "required": ["schema_version", "plan_ref", "tasks"],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "nullable_file_ref": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/file_ref" }
      ]
    },
    "nullable_commit_sha": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      ]
    },
    "acceptance_evidence": {
      "type": "object",
      "properties": {
        "task_evidence_ref": { "$ref": "#/$defs/nullable_file_ref" }
      },
      "required": ["task_evidence_ref"],
      "additionalProperties": false
    },
    "task_state": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T-[0-9]{3,}$"
        },
        "status": {
          "enum": ["pending", "in_progress", "done", "blocked", "blocked_by_dependency"]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "notes": { "type": "string" },
        "commit_sha": { "$ref": "#/$defs/nullable_commit_sha" },
        "last_error": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "acceptance_evidence": { "$ref": "#/$defs/acceptance_evidence" }
      },
      "required": [
        "id",
        "status",
        "attempts",
        "notes",
        "commit_sha",
        "last_error",
        "acceptance_evidence"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pending" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "attempts": { "const": 0 },
              "notes": { "const": "" },
              "commit_sha": { "type": "null" },
              "last_error": { "type": "null" },
              "acceptance_evidence": {
                "properties": {
                  "task_evidence_ref": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "in_progress" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "attempts": { "minimum": 1 },
              "commit_sha": { "type": "null" },
              "last_error": { "type": "null" },
              "acceptance_evidence": {
                "properties": {
                  "task_evidence_ref": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "done" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "attempts": { "minimum": 1 },
              "commit_sha": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              },
              "last_error": { "type": "null" },
              "acceptance_evidence": {
                "properties": {
                  "task_evidence_ref": { "$ref": "#/$defs/file_ref" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "blocked" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "attempts": { "minimum": 1 },
              "commit_sha": { "type": "null" },
              "last_error": { "type": "string", "minLength": 1 },
              "acceptance_evidence": {
                "properties": {
                  "task_evidence_ref": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "blocked_by_dependency" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "attempts": { "const": 0 },
              "notes": { "const": "" },
              "commit_sha": { "type": "null" },
              "last_error": { "type": "string", "minLength": 1 },
              "acceptance_evidence": {
                "properties": {
                  "task_evidence_ref": { "type": "null" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
