{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/specs-requirements.schema.json",
  "title": "NePA Spec IR v3.0",
  "description": "设计文档 5.1：只承载可由协议文档直接支持的协议事实。实现建模、测试设计和反向覆盖关系不属于 Spec IR。",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "transport": {
      "$ref": "#/$defs/transport"
    },
    "types": {
      "type": "array",
      "items": { "$ref": "#/$defs/type_def" }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/message" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "required": ["schema_version", "protocol", "types", "messages", "requirements"],
  "additionalProperties": false,
  "$defs": {
    "generic_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "req_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$"
    },
    "req_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/req_id" }
    },
    "protocol": {
      "description": "协议文档直接给出的协议身份和参与角色；运行来源、时间与实现范围记录在 run.json/scope 配置中。",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/generic_id" }
        }
      },
      "required": ["name", "version", "roles"],
      "additionalProperties": false
    },
    "transport": {
      "description": "仅在文档明确给出时记录；未说明的端口或字节序不得猜测。",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "default_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "byte_order": { "enum": ["big_endian", "little_endian"] },
        "req_ids": { "$ref": "#/$defs/req_ids" }
      },
      "required": ["name", "req_ids"],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "const": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "min_len": { "type": "integer", "minimum": 0 },
        "max_len": { "type": "integer", "minimum": 0 },
        "charset": { "type": "string", "minLength": 1 },
        "enum": { "type": "array", "minItems": 1, "uniqueItems": true }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "presence": {
      "type": "object",
      "properties": {
        "when": {
          "type": "object",
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "equals": {}
          },
          "required": ["field", "equals"],
          "additionalProperties": false
        }
      },
      "required": ["when"],
      "additionalProperties": false
    },
    "derived": {
      "description": "文档明确规定的线上值关系；不得由提取智能体自行推导。",
      "type": "object",
      "properties": {
        "kind": { "enum": ["length_of"] },
        "of": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["kind", "of"],
      "additionalProperties": false
    },
    "bit": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "constraint": { "$ref": "#/$defs/constraint" }
      },
      "required": ["name", "offset", "width"],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "constraint": { "$ref": "#/$defs/constraint" },
        "presence": { "$ref": "#/$defs/presence" }
      },
      "required": ["name", "type"],
      "additionalProperties": false
    },
    "varint_encoding": {
      "type": "object",
      "properties": {
        "kind": { "const": "varint" },
        "max_bytes": { "type": "integer", "minimum": 1 },
        "data_bits": { "type": "integer", "minimum": 1 },
        "continuation_bit": { "type": "integer", "minimum": 0 }
      },
      "required": ["kind"],
      "additionalProperties": false
    },
    "length_prefixed_string_encoding": {
      "type": "object",
      "properties": {
        "kind": { "const": "length_prefixed_string" },
        "length_type": { "type": "string", "minLength": 1 },
        "charset": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "length_type", "charset"],
      "additionalProperties": false
    },
    "length_prefixed_bytes_encoding": {
      "type": "object",
      "properties": {
        "kind": { "const": "length_prefixed_bytes" },
        "length_type": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "length_type"],
      "additionalProperties": false
    },
    "sequence_encoding": {
      "type": "object",
      "properties": {
        "kind": { "const": "sequence" },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/member" }
        }
      },
      "required": ["kind", "members"],
      "additionalProperties": false
    },
    "repeat_encoding": {
      "type": "object",
      "properties": {
        "kind": { "const": "repeat" },
        "item_type": { "type": "string", "minLength": 1 },
        "min_items": { "type": "integer", "minimum": 0 },
        "max_items": { "type": "integer", "minimum": 1 }
      },
      "required": ["kind", "item_type"],
      "additionalProperties": false
    },
    "enum_encoding": {
      "type": "object",
      "properties": {
        "kind": { "const": "enum" },
        "base_type": { "type": "string", "minLength": 1 },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": ["string", "number", "integer", "boolean"] }
        }
      },
      "required": ["kind", "base_type", "values"],
      "additionalProperties": false
    },
    "encoding": {
      "oneOf": [
        { "$ref": "#/$defs/varint_encoding" },
        { "$ref": "#/$defs/length_prefixed_string_encoding" },
        { "$ref": "#/$defs/length_prefixed_bytes_encoding" },
        { "$ref": "#/$defs/sequence_encoding" },
        { "$ref": "#/$defs/repeat_encoding" },
        { "$ref": "#/$defs/enum_encoding" }
      ]
    },
    "type_def": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/generic_id" },
        "name": { "type": "string", "minLength": 1 },
        "encoding": { "$ref": "#/$defs/encoding" },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraint" }
        },
        "req_ids": { "$ref": "#/$defs/req_ids" }
      },
      "required": ["id", "name", "encoding", "req_ids"],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "loc": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "bits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bit" }
        },
        "presence": { "$ref": "#/$defs/presence" },
        "constraint": { "$ref": "#/$defs/constraint" },
        "derived": { "$ref": "#/$defs/derived" },
        "req_ids": { "$ref": "#/$defs/req_ids" }
      },
      "required": ["name", "loc", "type", "req_ids"],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/generic_id" },
        "name": { "type": "string", "minLength": 1 },
        "senders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/generic_id" }
        },
        "receivers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/generic_id" }
        },
        "wire_layout": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        },
        "req_ids": { "$ref": "#/$defs/req_ids" }
      },
      "required": ["id", "name", "senders", "receivers", "wire_layout", "fields", "req_ids"],
      "additionalProperties": false
    },
    "requirement": {
      "description": "一条带直接文档证据的原子陈述；分类、可测试性和实现分解由后续阶段决定。",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/req_id" },
        "text": { "type": "string", "minLength": 1 },
        "level": { "enum": ["DEFINITION", "MUST", "MUST NOT", "SHOULD", "MAY"] },
        "values": {
          "description": "原文明确给出的、需要机器消费的命名标量；不得填写计算结果或实现默认值。",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": ["string", "number", "integer", "boolean"] }
        },
        "source_ref": {
          "type": "object",
          "properties": {
            "section": { "type": "string", "minLength": 1 },
            "quote": { "type": "string", "minLength": 1 },
            "segment_id": { "type": "string", "pattern": "^seg-[0-9]+$" },
            "doc_id": { "type": "string", "minLength": 1 }
          },
          "required": ["section", "quote"],
          "additionalProperties": false
        }
      },
      "required": ["id", "text", "level", "source_ref"],
      "additionalProperties": false
    }
  }
}
