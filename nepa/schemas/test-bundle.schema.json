{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NePA Test Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle", "tests"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "default_build_variant_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "default_build_variant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeid", "layer", "req_ids", "description", "gate"],
        "properties": {
          "nodeid": {
            "type": "string",
            "pattern": "^tests/[^:]+::[^:]+$"
          },
          "layer": {"enum": ["l0", "l1", "l2", "l3"]},
          "req_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "description": {"type": "string", "minLength": 1},
          "gate": {"enum": ["s5", "task", "s7_only"]},
          "build_variant_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
