{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/flat-plan-draft.schema.json",
  "title": "NePA FlatPlanDraft v1.0",
  "description": "A9 消融专用 FlatPlanBaseline 的单次结构化输出（设计 6.4）。字段与 layered 的 ArchitectureDraft/TaskShard 完全同形，只是在一次调用内给出全部语义；tasks 自带 work_package_id 供控制器确定性拆入同一 PlanDraftIR。禁止最终 T-###、input hash、blueprint hash、coverage、review 与运行状态。",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0" },
    "architecture": { "$ref": "#/$defs/architecture" },
    "work_packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/work_package" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "required": ["schema_version", "architecture", "work_packages", "tasks"],
  "additionalProperties": false,
  "$defs": {
    "generic_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "module_owner": { "type": "string", "pattern": "^(?!s5$)[a-z0-9][a-z0-9_-]*$" },
    "req_id": { "type": "string", "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$" },
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "id_set": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/generic_id" }
    },
    "file_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safe_relative_path" }
    },
    "context_ref": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["message", "type", "requirement", "interface_file"] },
        "id": { "type": "string", "minLength": 1 }
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "context_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/context_ref" }
    },
    "requirement_responsibility": {
      "type": "object",
      "properties": {
        "req_id": { "$ref": "#/$defs/req_id" },
        "role": { "enum": ["primary", "supporting"] }
      },
      "required": ["req_id", "role"],
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "properties": { "outcome": { "type": "string", "minLength": 1 } },
      "required": ["outcome"],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/generic_id" },
        "topic": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "context_refs": { "$ref": "#/$defs/context_refs" }
      },
      "required": ["id", "topic", "statement", "context_refs"],
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/generic_id" },
        "statement": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "context_refs": { "$ref": "#/$defs/context_refs" }
      },
      "required": ["id", "statement", "rationale", "context_refs"],
      "additionalProperties": false
    },
    "s5_contract": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/generic_id" },
        "kind": { "enum": ["external", "internal"] },
        "purpose": { "type": "string", "minLength": 1 },
        "owner": { "const": "s5" },
        "interface_files": { "$ref": "#/$defs/file_set" },
        "ready_gate": { "const": "s5" }
      },
      "required": ["id", "kind", "purpose", "owner", "interface_files", "ready_gate"],
      "additionalProperties": false
    },
    "task_contract": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/generic_id" },
        "kind": { "enum": ["external", "internal"] },
        "purpose": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/module_owner" },
        "interface_files": { "$ref": "#/$defs/file_set" },
        "ready_gate": { "const": "task" },
        "provider_work_package_id": { "$ref": "#/$defs/generic_id" }
      },
      "required": [
        "id",
        "kind",
        "purpose",
        "owner",
        "interface_files",
        "ready_gate",
        "provider_work_package_id"
      ],
      "additionalProperties": false
    },
    "contract": {
      "oneOf": [{ "$ref": "#/$defs/s5_contract" }, { "$ref": "#/$defs/task_contract" }]
    },
    "module": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/generic_id" },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "non_goals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "owns_files": { "$ref": "#/$defs/file_set" },
        "provides_contracts": { "$ref": "#/$defs/id_set" },
        "consumes_contracts": { "$ref": "#/$defs/id_set" }
      },
      "required": [
        "id",
        "name",
        "purpose",
        "responsibilities",
        "non_goals",
        "owns_files",
        "provides_contracts",
        "consumes_contracts"
      ],
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "properties": {
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
        "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contract" }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/module" }
        }
      },
      "required": ["decisions", "assumptions", "contracts", "modules"],
      "additionalProperties": false
    },
    "work_package": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/generic_id" },
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "module": { "$ref": "#/$defs/generic_id" },
        "kind": { "enum": ["codec", "state", "logic", "transport", "app", "integration"] },
        "context_refs": { "$ref": "#/$defs/context_refs" },
        "requirement_responsibilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement_responsibility" }
        },
        "allowed_files": { "$ref": "#/$defs/file_set" },
        "provides_contracts": { "$ref": "#/$defs/id_set" },
        "consumes_contracts": { "$ref": "#/$defs/id_set" },
        "depends_on": { "$ref": "#/$defs/id_set" },
        "acceptance": { "$ref": "#/$defs/acceptance" }
      },
      "required": [
        "id",
        "title",
        "goal",
        "module",
        "kind",
        "context_refs",
        "requirement_responsibilities",
        "allowed_files",
        "provides_contracts",
        "consumes_contracts",
        "depends_on",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "work_package_id": { "$ref": "#/$defs/generic_id" },
        "local_id": { "$ref": "#/$defs/generic_id" },
        "title": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["codec", "state", "logic", "transport", "app", "integration"] },
        "instructions": { "type": "string", "minLength": 1 },
        "deliverable_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safe_relative_path" }
        },
        "context_refs": { "$ref": "#/$defs/context_refs" },
        "requirement_responsibilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement_responsibility" }
        },
        "provides_contracts": { "$ref": "#/$defs/id_set" },
        "consumes_contracts": { "$ref": "#/$defs/id_set" },
        "depends_on": { "$ref": "#/$defs/id_set" },
        "acceptance": { "$ref": "#/$defs/acceptance" }
      },
      "required": [
        "work_package_id",
        "local_id",
        "title",
        "goal",
        "kind",
        "instructions",
        "deliverable_files",
        "context_refs",
        "requirement_responsibilities",
        "provides_contracts",
        "consumes_contracts",
        "depends_on",
        "acceptance"
      ],
      "additionalProperties": false
    }
  }
}
