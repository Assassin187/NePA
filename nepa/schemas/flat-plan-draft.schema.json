{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/flat-plan-draft.schema.json",
  "title": "NePA state-free flat Plan draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "architecture", "work_packages", "task_shards"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "architecture": {"$ref": "#/$defs/architecture"},
    "work_packages": {"type": "array", "items": {"$ref": "#/$defs/workPackage"}},
    "task_shards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shard"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "contextRef": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["requirement", "message", "type", "interface_file"]}, "id": {"type": "string", "minLength": 1}}},
    "responsibility": {"type": "object", "additionalProperties": false, "required": ["req_id", "role"], "properties": {"req_id": {"type": "string", "minLength": 1}, "role": {"enum": ["primary", "supporting"]}}},
    "packageAcceptance": {"type": "object", "additionalProperties": false, "required": ["outcome"], "properties": {"outcome": {"type": "string", "minLength": 1}}},
    "taskAcceptance": {"type": "object", "additionalProperties": false, "required": ["build_variant_ids", "tests"], "properties": {"build_variant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "tests": {"const": []}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["id", "topic", "statement", "context_refs"], "properties": {"id": {"$ref": "#/$defs/id"}, "topic": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "context_refs": {"type": "array", "items": {"$ref": "#/$defs/contextRef"}}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["id", "purpose", "owner", "interface_files", "ready_gate", "provider", "consumers"], "properties": {"id": {"$ref": "#/$defs/id"}, "purpose": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "interface_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "ready_gate": {"enum": ["s5", "task"]}, "provider": {"type": "string", "minLength": 1}, "consumers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "module": {"type": "object", "additionalProperties": false, "required": ["id", "name", "purpose", "responsibilities", "non_goals", "owns_files", "provides_contracts", "consumes_contracts"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "responsibilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "owns_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "provides_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "consumes_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "workPackage": {"type": "object", "additionalProperties": false, "required": ["id", "title", "goal", "module", "kind", "context_refs", "requirement_responsibilities", "allowed_files", "provides_contracts", "consumes_contracts", "depends_on", "acceptance"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1}, "goal": {"type": "string", "minLength": 1}, "module": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "minLength": 1}, "context_refs": {"type": "array", "items": {"$ref": "#/$defs/contextRef"}}, "requirement_responsibilities": {"type": "array", "items": {"$ref": "#/$defs/responsibility"}}, "allowed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "provides_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "consumes_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "acceptance": {"$ref": "#/$defs/packageAcceptance"}}},
    "layoutFile": {"type": "object", "additionalProperties": false, "required": ["slot_id", "path", "path_pattern", "expand_over", "class", "render_rule", "owner_module", "contract_id", "build_role", "purpose"], "properties": {"slot_id": {"$ref": "#/$defs/id"}, "path": {"type": ["string", "null"]}, "path_pattern": {"type": ["string", "null"]}, "expand_over": {"type": ["string", "null"], "enum": ["messages", "types", null]}, "class": {"enum": ["s5_frozen", "s6_owned"]}, "render_rule": {"enum": ["header", "source_stub", "build_file", "doc", "mechanical"]}, "owner_module": {"$ref": "#/$defs/id"}, "contract_id": {"type": ["string", "null"]}, "build_role": {"enum": ["link_source", "entry_point", "none"]}, "purpose": {"type": "string", "minLength": 1}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "output_path", "entry_file_slot", "link_source_slots"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "output_path": {"type": "string", "minLength": 1}, "entry_file_slot": {"$ref": "#/$defs/id"}, "link_source_slots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "layout": {"type": "object", "additionalProperties": false, "required": ["roots", "files", "build_graph"], "properties": {"roots": {"type": "object", "additionalProperties": false, "required": ["include", "source", "app", "build"], "properties": {"include": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "app": {"type": "string", "minLength": 1}, "build": {"type": "string", "minLength": 1}}}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layoutFile"}}, "build_graph": {"type": "object", "additionalProperties": false, "required": ["artifacts"], "properties": {"artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}}}}},
    "architecture": {"type": "object", "additionalProperties": false, "required": ["schema_version", "decisions", "assumptions", "contracts", "modules", "work_packages", "layout"], "properties": {"schema_version": {"const": "2.0"}, "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}}, "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}}, "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}}, "work_packages": {"type": "array", "items": {"$ref": "#/$defs/workPackage"}}, "layout": {"$ref": "#/$defs/layout"}}},
    "shardTask": {"type": "object", "additionalProperties": false, "required": ["local_id", "title", "goal", "kind", "instructions", "deliverable_files", "context_refs", "requirement_responsibilities", "provides_contracts", "consumes_contracts", "depends_on", "acceptance"], "properties": {"local_id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1}, "goal": {"type": "string", "minLength": 1}, "kind": {"enum": ["codec", "state", "logic", "transport", "app", "integration"]}, "instructions": {"type": "string", "minLength": 1}, "deliverable_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "context_refs": {"type": "array", "items": {"$ref": "#/$defs/contextRef"}}, "requirement_responsibilities": {"type": "array", "items": {"$ref": "#/$defs/responsibility"}}, "provides_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "consumes_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "acceptance": {"$ref": "#/$defs/taskAcceptance"}}},
    "shard": {"type": "object", "additionalProperties": false, "required": ["schema_version", "work_package_id", "tasks"], "properties": {"schema_version": {"const": "1.0"}, "work_package_id": {"$ref": "#/$defs/id"}, "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shardTask"}}}}
  }
}
