{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-recovery-attempt-declaration.schema.json","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","version","attempt","status","prompt_ref","trial_count","semantic_depth","model_ids","trial_ids"],"properties":{"schema_version":{"const":"2.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version":{"enum":["r0","r1","r2"]},"attempt":{"type":"integer","minimum":1},"status":{"const":"declared"},"prompt_ref":{"$ref":"#/$defs/ref"},"trial_count":{"const":5},"semantic_depth":{"const":1},"model_ids":{"const":["qwen","claude","deepseek"]},"trial_ids":{"type":"object","additionalProperties":false,"required":["qwen","claude","deepseek"],"properties":{"qwen":{"$ref":"#/$defs/trials"},"deepseek":{"$ref":"#/$defs/trials"},"claude":{"$ref":"#/$defs/trials"}}}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},"trials":{"type":"array","minItems":5,"maxItems":5,"uniqueItems":true,"items":{"type":"string","pattern":"^trial_[0-9]{3}$"}}}}
