{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/revision-rehearsal.schema.json",
  "title": "NePA F3 revision rehearsal evidence",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "level", "baseline_commit", "baseline_tree", "candidate_plan_ref", "blueprint_ref", "migration_ref", "runs", "file_differences", "group_attribution", "verdict"],
  "properties": {
    "schema_version": {"const": "1.0"}, "candidate_id": {"type": "string", "pattern": "^candidate-[1-9][0-9]*$"}, "level": {"const": "F3"},
    "baseline_commit": {"$ref": "#/$defs/commit"}, "baseline_tree": {"$ref": "#/$defs/commit"},
    "candidate_plan_ref": {"$ref": "#/$defs/ref"}, "blueprint_ref": {"$ref": "#/$defs/ref"}, "migration_ref": {"$ref": "#/$defs/ref"},
    "runs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/run"}},
    "file_differences": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "action", "before_sha256", "after_sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "action": {"enum": ["add", "preserve", "quarantine", "re_adopt"]}, "before_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "after_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}}},
    "group_attribution": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["group_id", "failure_refs", "complete"], "properties": {"group_id": {"type": "string", "pattern": "^g-[1-9][0-9]*-[1-9][0-9]*$"}, "failure_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "complete": {"const": true}}}},
    "verdict": {"enum": ["ready", "pending_repair", "fail"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "run": {"type": "object", "additionalProperties": false, "required": ["tree", "result_sha256", "build_result_refs", "smoke_result_refs"], "properties": {"tree": {"$ref": "#/$defs/commit"}, "result_sha256": {"$ref": "#/$defs/sha256"}, "build_result_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "smoke_result_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}}}
  }
}
