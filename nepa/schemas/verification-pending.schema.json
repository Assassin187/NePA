{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/verification-pending.schema.json",
  "title": "NePA S6 verification WAL",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "task_id", "task_uid", "attempt", "evidence_seq", "old_state", "new_state", "old_file_ledger", "new_file_ledger", "old_revision_ledger", "new_revision_ledger", "evidence_ref", "candidate_ref", "candidate_file_refs", "changed_files", "build_result_refs", "smoke_result_refs", "notes", "expected_tree", "expected_git_tree", "expected_commit", "commit_message", "commit_timestamp", "expected_parent", "expected_trailers", "phase", "commit_sha"],
  "properties": {
    "schema_version": {"const": "2.0"}, "kind": {"const": "normal"}, "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}, "task_uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 4}, "evidence_seq": {"type": "integer", "minimum": 1},
    "old_state": {"$ref": "#/$defs/state"}, "new_state": {"$ref": "#/$defs/state"}, "old_file_ledger": {"$ref": "#/$defs/fileLedger"}, "new_file_ledger": {"$ref": "#/$defs/fileLedger"}, "old_revision_ledger": {"$ref": "#/$defs/revisionLedger"}, "new_revision_ledger": {"$ref": "#/$defs/revisionLedger"},
    "evidence_ref": {"$ref": "#/$defs/ref"}, "candidate_ref": {"$ref": "#/$defs/ref"}, "candidate_file_refs": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/ref"}}, "changed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}, "build_result_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "smoke_result_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "notes": {"type": "string"}, "expected_tree": {"$ref": "#/$defs/sha256"}, "expected_git_tree": {"$ref": "#/$defs/commit"}, "expected_commit": {"$ref": "#/$defs/commit"}, "commit_message": {"type": "string", "minLength": 1}, "commit_timestamp": {"type": "string", "format": "date-time"}, "expected_parent": {"$ref": "#/$defs/commit"},
    "expected_trailers": {"type": "object", "additionalProperties": false, "required": ["NePA-Task", "NePA-Task-UID", "NePA-Plan", "NePA-Epoch", "NePA-Attempt", "NePA-Evidence-Seq", "NePA-Evidence-SHA256"], "properties": {"NePA-Task": {"type": "string"}, "NePA-Task-UID": {"type": "string"}, "NePA-Plan": {"type": "string"}, "NePA-Epoch": {"type": "string"}, "NePA-Attempt": {"type": "string"}, "NePA-Evidence-Seq": {"type": "string"}, "NePA-Evidence-SHA256": {"$ref": "#/$defs/sha256"}}},
    "phase": {"enum": ["prepared", "candidate_installed", "committed", "reconciled"]}, "commit_sha": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["schema_version", "plan_ref", "tasks", "evidence_counters", "s6_attempts_used"], "properties": {"schema_version": {"const": "2.0"}, "plan_ref": {"type": "object"}, "tasks": {"type": "array"}, "evidence_counters": {"type": "object"}, "s6_attempts_used": {"type": "integer", "minimum": 0}}},
    "fileLedger": {"type": "object", "additionalProperties": false, "required": ["schema_version", "files"], "properties": {"schema_version": {"const": "2.0"}, "files": {"type": "array"}}},
    "revisionLedger": {"type": "object", "additionalProperties": false, "required": ["schema_version", "entries"], "properties": {"schema_version": {"const": "2.0"}, "entries": {"type": "array"}}}
  }
}
