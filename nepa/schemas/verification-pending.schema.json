{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/verification-pending.schema.json",
  "title": "NePA S6 verification WAL v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "old_state", "new_state", "old_file_ledger", "new_file_ledger", "old_revision_ledger", "new_revision_ledger", "changed_files", "build_result_refs", "smoke_result_refs", "notes", "expected_tree", "expected_git_tree", "expected_commit", "commit_message", "commit_timestamp", "expected_parent", "expected_trailers", "phase", "commit_sha"],
  "properties": {
    "schema_version": {"const": "2.0"}, "kind": {"enum": ["normal", "lease", "group"]},
    "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}, "task_uid": {"$ref": "#/$defs/uid"}, "attempt": {"type": "integer", "minimum": 0, "maximum": 4}, "evidence_seq": {"type": "integer", "minimum": 1},
    "old_state": {"$ref": "#/$defs/state"}, "allocated_state": {"$ref": "#/$defs/state"}, "new_state": {"$ref": "#/$defs/state"}, "old_file_ledger": {"$ref": "#/$defs/fileLedger"}, "new_file_ledger": {"$ref": "#/$defs/fileLedger"}, "old_revision_ledger": {"$ref": "#/$defs/revisionLedger"}, "new_revision_ledger": {"$ref": "#/$defs/revisionLedger"},
    "evidence_ref": {"$ref": "#/$defs/ref"}, "candidate_ref": {"$ref": "#/$defs/ref"}, "candidate_file_refs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/ref"}},
    "changed_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}, "build_result_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "smoke_result_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "notes": {"type": "string"},
    "expected_tree": {"$ref": "#/$defs/sha256"}, "expected_git_tree": {"$ref": "#/$defs/commit"}, "expected_commit": {"$ref": "#/$defs/commit"}, "commit_message": {"type": "string", "minLength": 1}, "commit_timestamp": {"type": "string", "format": "date-time"}, "expected_parent": {"$ref": "#/$defs/commit"}, "expected_trailers": {"oneOf": [{"$ref": "#/$defs/normalTrailers"}, {"$ref": "#/$defs/jointTrailers"}]},
    "lease_id": {"type": "string", "pattern": "^lease-[1-9][0-9]*$"}, "lease_authorization_ref": {"$ref": "#/$defs/ref"}, "lease_start_event_ref": {"$ref": "#/$defs/eventRef"},
    "activation_ref": {"$ref": "#/$defs/eventRef"}, "group_id": {"type": "string", "pattern": "^g-[1-9][0-9]*-[1-9][0-9]*$"}, "epoch_checkpoint_commit": {"$ref": "#/$defs/commit"}, "epoch_checkpoint_tree": {"$ref": "#/$defs/commit"}, "baseline_commit": {"$ref": "#/$defs/commit"}, "baseline_tree": {"$ref": "#/$defs/sha256"},
    "joint_evidence_ref": {"$ref": "#/$defs/ref"}, "member_uids": {"$ref": "#/$defs/members"}, "member_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/member"}},
    "member_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/memberMode"}}, "candidate_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "failure_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "phase": {"enum": ["prepared", "candidate_installed", "committed", "reconciled"]}, "commit_sha": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "normal"}}}, "then": {"required": ["task_id", "task_uid", "attempt", "evidence_seq", "evidence_ref", "candidate_ref", "candidate_file_refs"], "properties": {"expected_trailers": {"$ref": "#/$defs/normalTrailers"}}, "not": {"anyOf": [{"required": ["allocated_state"]}, {"required": ["lease_id"]}, {"required": ["lease_authorization_ref"]}, {"required": ["lease_start_event_ref"]}, {"required": ["joint_evidence_ref"]}, {"required": ["member_uids"]}, {"required": ["member_evidence"]}, {"required": ["activation_ref"]}, {"required": ["group_id"]}, {"required": ["member_modes"]}, {"required": ["candidate_refs"]}, {"required": ["failure_refs"]}]}}},
    {"if": {"properties": {"kind": {"const": "lease"}}}, "then": {"required": ["task_id", "task_uid", "attempt", "evidence_seq", "evidence_ref", "candidate_ref", "candidate_file_refs", "allocated_state", "lease_id", "lease_authorization_ref", "lease_start_event_ref", "joint_evidence_ref", "member_uids", "member_evidence"], "properties": {"changed_files": {"minItems": 1}, "member_uids": {"minItems": 2}, "member_evidence": {"minItems": 2}, "expected_trailers": {"$ref": "#/$defs/jointTrailers"}}, "not": {"anyOf": [{"required": ["activation_ref"]}, {"required": ["group_id"]}, {"required": ["member_modes"]}, {"required": ["candidate_refs"]}, {"required": ["failure_refs"]}]}}},
    {"if": {"properties": {"kind": {"const": "group"}}}, "then": {"required": ["allocated_state", "activation_ref", "group_id", "epoch_checkpoint_commit", "epoch_checkpoint_tree", "baseline_commit", "baseline_tree", "joint_evidence_ref", "member_uids", "member_evidence", "member_modes", "candidate_refs", "failure_refs"], "properties": {"expected_trailers": {"$ref": "#/$defs/jointTrailers"}}, "not": {"anyOf": [{"required": ["lease_id"]}, {"required": ["lease_authorization_ref"]}, {"required": ["lease_start_event_ref"]}]}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}, "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "migrationRef": {"type": "object", "additionalProperties": false, "required": ["revision_seq", "event_seq"], "properties": {"revision_seq": {"type": "integer", "minimum": 1}, "event_seq": {"type": "integer", "minimum": 1}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["schema_version", "plan_ref", "tasks", "evidence_counters", "s6_attempts_used"], "properties": {"schema_version": {"const": "2.0"}, "plan_ref": {"type": "object"}, "tasks": {"type": "array"}, "evidence_counters": {"type": "object"}, "s6_attempts_used": {"type": "integer", "minimum": 0}}},
    "fileLedger": {"type": "object", "additionalProperties": false, "required": ["schema_version", "files"], "properties": {"schema_version": {"const": "2.0"}, "files": {"type": "array"}}}, "revisionLedger": {"type": "object", "additionalProperties": false, "required": ["schema_version", "entries"], "properties": {"schema_version": {"const": "2.0"}, "entries": {"type": "array"}}},
    "eventRef": {"type": "object", "additionalProperties": false, "required": ["event_seq"], "properties": {"event_seq": {"type": "integer", "minimum": 1}}}, "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/uid"}},
    "normalTrailers": {"type": "object", "additionalProperties": false, "required": ["NePA-Task", "NePA-Task-UID", "NePA-Plan", "NePA-Epoch", "NePA-Attempt", "NePA-Evidence-Seq", "NePA-Evidence-SHA256"], "properties": {"NePA-Task": {"type": "string"}, "NePA-Task-UID": {"type": "string"}, "NePA-Plan": {"type": "string"}, "NePA-Epoch": {"type": "string"}, "NePA-Attempt": {"type": "string"}, "NePA-Evidence-Seq": {"type": "string"}, "NePA-Evidence-SHA256": {"$ref": "#/$defs/sha256"}}},
    "jointTrailers": {"type": "object", "additionalProperties": false, "required": ["NePA-Verification-ID", "NePA-Joint-Evidence-SHA256"], "properties": {"NePA-Verification-ID": {"type": "string"}, "NePA-Joint-Evidence-SHA256": {"$ref": "#/$defs/sha256"}}},
    "member": {"type": "object", "additionalProperties": false, "required": ["task_uid", "task_id", "evidence_seq", "evidence_ref", "changed_files"], "properties": {"task_uid": {"$ref": "#/$defs/uid"}, "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}, "evidence_seq": {"type": "integer", "minimum": 1}, "evidence_ref": {"$ref": "#/$defs/ref"}, "changed_files": {"type": "array", "items": {"$ref": "#/$defs/file"}}}},
    "memberMode": {"type": "object", "additionalProperties": false, "required": ["task_uid", "execution_mode", "evidence_seq", "migration_ref"], "properties": {"task_uid": {"$ref": "#/$defs/uid"}, "execution_mode": {"enum": ["normal", "revalidate", "amend"]}, "evidence_seq": {"type": "integer", "minimum": 1}, "migration_ref": {"$ref": "#/$defs/migrationRef"}}}
  }
}
