{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/repair-log.schema.json",
  "title": "NePA repair/repair_log.json v1.0",
  "description": "设计文档 5.4：修复日志——每条记录 = 轮次、失败聚类签名、诊断结论、修复动作、验证结果、消耗。5.4 为散文描述，字段命名为合理设计；流程语义见 6.8。",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/repair_entry" }
    }
  },
  "required": ["schema_version", "entries"],
  "additionalProperties": false,
  "$defs": {
    "repair_entry": {
      "type": "object",
      "properties": {
        "round": {
          "description": "S8 修复轮次",
          "type": "integer",
          "minimum": 1
        },
        "cluster_signature": {
          "description": "失败聚类签名：失败测试集合的哈希（6.8 步骤 1）",
          "type": "string",
          "pattern": "^[0-9a-f]{8,64}$"
        },
        "diagnosis": {
          "description": "诊断结论：根因假设、涉及文件（Diagnoser 输出，目标文件 <= 3，6.8 步骤 2）",
          "type": "object",
          "properties": {
            "root_cause": { "type": "string", "minLength": 1 },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["root_cause", "files"],
          "additionalProperties": false
        },
        "repair": {
          "description": "修复动作：文件、diff 摘要",
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "diff_summary": { "type": "string", "minLength": 1 }
          },
          "required": ["files", "diff_summary"],
          "additionalProperties": false
        },
        "verification": {
          "description": "验证结果：簇内失败测试快验 + 全量回归（6.8 步骤 3）",
          "type": "object",
          "properties": {
            "quick_pass": { "type": "boolean" },
            "regression_pass": { "type": "boolean" }
          },
          "required": ["quick_pass"],
          "additionalProperties": false
        },
        "cost": {
          "description": "消耗：模型、token、耗时",
          "type": "object",
          "properties": {
            "model": {
              "description": "<provider>/<model>（5.5 约定）",
              "type": "string",
              "minLength": 1
            },
            "tokens_in": { "type": "integer", "minimum": 0 },
            "tokens_out": { "type": "integer", "minimum": 0 },
            "duration_ms": { "type": "number", "minimum": 0 },
            "cost_usd": { "type": "number", "minimum": 0 }
          },
          "required": ["model", "tokens_in", "tokens_out", "duration_ms"],
          "additionalProperties": false
        }
      },
      "required": ["round", "cluster_signature", "diagnosis", "repair", "verification", "cost"],
      "additionalProperties": false
    }
  }
}
