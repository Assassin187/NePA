{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/calibration-development-handoff.schema.json",
  "title": "M1-4a2 development handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lineage_id",
    "consumer",
    "selection_ref",
    "selected_version",
    "prompt_ref",
    "prompt_sha256",
    "assessment_ref",
    "selection_reason",
    "satisfies"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "lineage_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "consumer": {"const": "m1-4a3"},
    "selection_ref": {"$ref": "#/$defs/ref"},
    "selected_version": {"enum": ["v0", "v1", "v2"]},
    "prompt_ref": {"$ref": "#/$defs/ref"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assessment_ref": {"$ref": "#/$defs/ref"},
    "selection_reason": {"type": "string", "minLength": 1},
    "satisfies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m1_4a3_admission",
        "n10_qualification",
        "b1_b4",
        "production_freeze",
        "owner_signature",
        "formal_run",
        "s5_s6"
      ],
      "properties": {
        "m1_4a3_admission": {"const": true},
        "n10_qualification": {"const": false},
        "b1_b4": {"const": false},
        "production_freeze": {"const": false},
        "owner_signature": {"const": false},
        "formal_run": {"const": false},
        "s5_s6": {"const": false}
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
