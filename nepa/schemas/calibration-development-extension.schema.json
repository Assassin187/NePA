{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://nepa.local/schemas/calibration-development-extension.schema.json", "title": "Prompt development N10 extension", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "lineage_id", "version", "status", "reason", "base_refs", "trial_ids", "prompt_sha256", "semantic_depth", "attempt"],
  "properties": {"schema_version": {"const": "1.0"}, "lineage_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "version": {"enum": ["v1", "v2"]}, "status": {"enum": ["admitted", "complete", "infrastructure-invalid", "invalid"]}, "reason": {"enum": ["single_sample_sensitive", "metric_conflict"]}, "base_refs": {"type": "object", "additionalProperties": false, "required": ["qwen", "deepseek"], "properties": {"qwen": {"$ref": "#/$defs/ref"}, "deepseek": {"$ref": "#/$defs/ref"}}}, "trial_ids": {"const": ["trial_006", "trial_007", "trial_008", "trial_009", "trial_010"]}, "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "semantic_depth": {"const": 1}, "attempt": {"type": "integer", "minimum": 1}},
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
