{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/revision-ledger.schema.json",
  "title": "NePA typed append-only revision ledger v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "callRef": {"type": "object", "additionalProperties": false, "required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "callRefs": {"type": "array", "items": {"$ref": "#/$defs/callRef"}},
    "eventRef": {"type": "object", "additionalProperties": false, "required": ["event_seq"], "properties": {"event_seq": {"type": "integer", "minimum": 1}}},
    "taskSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["task_uid", "mode", "ordinary_attempts_used", "amendment_used", "status"],
      "properties": {
        "task_uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "mode": {"enum": ["INHERIT", "REVALIDATE", "AMEND", "REGENERATE"]},
        "ordinary_attempts_used": {"type": "integer", "minimum": 0},
        "amendment_used": {"type": "boolean"},
        "status": {"enum": ["pending", "in_progress", "done", "blocked", "blocked_by_dependency"]}
      }
    },
    "boundaryKey": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "revision_seq", "tasks"],
      "properties": {
        "phase": {"enum": ["task_boundary", "provider_submission"]},
        "revision_seq": {"type": "integer", "minimum": 0},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/taskSnapshot"}}
      }
    },
    "trigger": {
      "type": "object", "additionalProperties": false,
      "required": ["boundary_key", "plan_ref", "hit_code", "route", "hit_signature", "evidence_refs", "selected", "reason"],
      "properties": {
        "boundary_key": {"$ref": "#/$defs/boundaryKey"},
        "plan_ref": {"$ref": "#/$defs/ref"},
        "hit_code": {"enum": ["TR-1", "TR-2", "TR-3", "TR-4", "TR-5", "TR-6", "TR-7", "TR-8"]},
        "route": {"enum": ["record_only", "F1", "F2", "F3", "F4", "submission_reject"]},
        "hit_signature": {"$ref": "#/$defs/sha256"},
        "evidence_refs": {"$ref": "#/$defs/refs"},
        "selected": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "candidateRejected": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "trigger_event_seq", "level", "failed_gate", "reason", "evidence_refs"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "trigger_event_seq": {"type": "integer", "minimum": 1},
        "level": {"enum": ["F2", "F3"]},
        "failed_gate": {"enum": ["RG-1", "RG-2", "RG-3", "RG-4", "RG-5"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/refs"}
      }
    },
    "migrationTask": {
      "type": "object", "additionalProperties": false,
      "required": ["old_task_id", "old_task_uid", "new_task_id", "new_task_uid", "classification", "reason", "old_attempts"],
      "properties": {
        "old_task_id": {"type": ["string", "null"]}, "old_task_uid": {"type": ["string", "null"]},
        "new_task_id": {"type": ["string", "null"]}, "new_task_uid": {"type": ["string", "null"]},
        "merged_from": {"type": "array", "items": {"type": "string"}}, "merged_from_ids": {"type": "array", "items": {"type": "string"}},
        "classification": {"enum": ["INHERIT", "REVALIDATE", "AMEND", "REGENERATE"]},
        "reason": {"type": "string", "minLength": 1}, "old_attempts": {"type": "integer", "minimum": 0}
      }
    },
    "migrationFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "old_owner_uid", "new_owner_uid", "classification"],
      "properties": {"path": {"type": "string", "minLength": 1}, "old_owner_uid": {"type": ["string", "null"]}, "new_owner_uid": {"type": ["string", "null"]}, "classification": {"enum": ["INHERIT", "REVALIDATE", "AMEND", "REGENERATE"]}}
    },
    "pendingGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["group_id", "member_task_uids", "affected_paths", "affected_symbols", "build_artifact_ids"],
      "properties": {
        "group_id": {"type": "string", "pattern": "^g-[1-9][0-9]*-[1-9][0-9]*$"},
        "member_task_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}},
        "affected_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "affected_symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "build_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "reAdopt": {
      "type": "object", "additionalProperties": false,
      "required": ["quarantine_path", "target_path", "owner", "content_sha256"],
      "properties": {
        "quarantine_path": {"type": "string", "pattern": "^_orphan/E[1-9][0-9]*/.+$"},
        "target_path": {"type": "string", "minLength": 1},
        "owner": {"type": "object", "additionalProperties": false, "required": ["task_uid", "task_id"], "properties": {"task_uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}}},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["counts", "tasks", "files"],
      "properties": {
        "counts": {"type": "object", "additionalProperties": false, "required": ["inherit", "revalidate", "amend", "regenerate"], "properties": {"inherit": {"type": "integer", "minimum": 0}, "revalidate": {"type": "integer", "minimum": 0}, "amend": {"type": "integer", "minimum": 0}, "regenerate": {"type": "integer", "minimum": 0}}},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/migrationTask"}},
        "files": {"type": "array", "items": {"$ref": "#/$defs/migrationFile"}},
        "pending_groups": {"type": "array", "items": {"$ref": "#/$defs/pendingGroup"}},
        "re_adopt": {"type": "array", "items": {"$ref": "#/$defs/reAdopt"}}
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["revision_seq", "from_version", "to_version", "from_plan_ref", "to_plan_ref", "level", "trigger_event_seq", "trigger_signature", "patch_ops", "migration", "preservation_rate", "rework_cost_estimate_usd", "gates", "epoch_after", "activated_at_commit", "binding_ref", "pending_materialization"],
      "properties": {
        "revision_seq": {"type": "integer", "minimum": 1}, "from_version": {"type": "string"}, "to_version": {"type": "string"},
        "from_plan_ref": {"$ref": "#/$defs/ref"}, "to_plan_ref": {"$ref": "#/$defs/ref"},
        "level": {"enum": ["F2", "F3"]}, "trigger_event_seq": {"type": "integer", "minimum": 1}, "trigger_signature": {"$ref": "#/$defs/sha256"},
        "patch_ops": {"type": "array", "items": {"type": "object", "additionalProperties": true}}, "migration": {"$ref": "#/$defs/migration"},
        "preservation_rate": {"type": "number", "minimum": 0, "maximum": 1}, "rework_cost_estimate_usd": {"type": "number", "minimum": 0},
        "gates": {"type": "object", "additionalProperties": false, "required": ["RG-1", "RG-2", "RG-3", "RG-4", "RG-5"], "properties": {"RG-1": {"const": "pass"}, "RG-2": {"const": "pass"}, "RG-3": {"const": "pass"}, "RG-4": {"const": "pass"}, "RG-5": {"enum": ["pass", "not_applicable"]}}},
        "epoch_after": {"type": "string", "pattern": "^E[0-9]+$"}, "activated_at_commit": {"$ref": "#/$defs/commit"},
        "binding_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "pending_materialization": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"level": {"const": "F2"}}, "required": ["level"]}, "then": {"properties": {"binding_ref": {"$ref": "#/$defs/ref"}, "pending_materialization": {"const": false}, "gates": {"properties": {"RG-5": {"const": "not_applicable"}}}}}},
        {"if": {"properties": {"level": {"const": "F3"}}, "required": ["level"]}, "then": {"properties": {"binding_ref": {"type": "null"}, "pending_materialization": {"const": true}, "gates": {"properties": {"RG-5": {"const": "pass"}}}}}}
      ]
    },
    "epoch": {
      "type": "object", "additionalProperties": false,
      "required": ["revision_seq", "epoch_receipt_ref", "binding_ref"],
      "properties": {"revision_seq": {"type": "integer", "minimum": 0}, "epoch_receipt_ref": {"$ref": "#/$defs/ref"}, "binding_ref": {"$ref": "#/$defs/ref"}}
    },
    "leaseStarted": {
      "type": "object", "additionalProperties": false,
      "required": ["lease_id", "task_uid", "leased_uids", "leased_paths", "baseline_commit", "execution_count", "authorization_ref"],
      "properties": {"lease_id": {"type": "string"}, "task_uid": {"type": "string"}, "leased_uids": {"type": "array", "items": {"type": "string"}}, "leased_paths": {"type": "array", "items": {"type": "string"}}, "baseline_commit": {"$ref": "#/$defs/commit"}, "execution_count": {"type": "integer", "minimum": 0}, "authorization_ref": {"$ref": "#/$defs/ref"}}
    },
    "leaseFinished": {
      "type": "object", "additionalProperties": false,
      "required": ["lease_id", "success", "reason", "joint_evidence_ref", "commit_sha", "call_refs"],
      "properties": {"lease_id": {"type": "string", "pattern": "^lease-[1-9][0-9]*$"}, "success": {"type": "boolean"}, "reason": {"type": ["string", "null"]}, "joint_evidence_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "commit_sha": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]}, "call_refs": {"$ref": "#/$defs/callRefs"}},
      "allOf": [
        {"if": {"properties": {"success": {"const": true}}}, "then": {"required": ["joint_evidence_ref", "commit_sha"], "properties": {"reason": {"type": "null"}, "joint_evidence_ref": {"$ref": "#/$defs/ref"}, "commit_sha": {"$ref": "#/$defs/commit"}}}},
        {"if": {"properties": {"success": {"const": false}}}, "then": {"properties": {"reason": {"type": "string", "minLength": 1}, "joint_evidence_ref": {"type": "null"}, "commit_sha": {"type": "null"}}}}
      ]
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["verification_id", "kind", "member_uids", "evidence_refs", "commit_sha", "revision_seq"],
      "properties": {"verification_id": {"type": "string"}, "kind": {"enum": ["normal", "lease", "group"]}, "member_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "evidence_refs": {"$ref": "#/$defs/refs"}, "commit_sha": {"$ref": "#/$defs/commit"}, "revision_seq": {"type": "integer", "minimum": 0}, "lease_id": {"type": "string", "pattern": "^lease-[1-9][0-9]*$"}, "group_id": {"type": "string", "pattern": "^g-[1-9][0-9]*-[1-9][0-9]*$"}, "joint_evidence_ref": {"$ref": "#/$defs/ref"}},
      "allOf": [
        {"if": {"properties": {"kind": {"const": "lease"}}}, "then": {"required": ["lease_id", "joint_evidence_ref"], "properties": {"member_uids": {"minItems": 2}, "evidence_refs": {"minItems": 2}}, "not": {"required": ["group_id"]}}},
        {"if": {"properties": {"kind": {"const": "group"}}}, "then": {"required": ["group_id", "joint_evidence_ref"], "not": {"required": ["lease_id"]}}},
        {"if": {"properties": {"kind": {"const": "normal"}}}, "then": {"not": {"anyOf": [{"required": ["lease_id"]}, {"required": ["group_id"]}, {"required": ["joint_evidence_ref"]}]}}}
      ]
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["revision_seq", "evaluated_at", "obligation_anchors", "resolved", "ineffective", "evidence_refs", "call_refs", "cost_usd"],
      "properties": {"revision_seq": {"type": "integer", "minimum": 0}, "evaluated_at": {"type": "string", "minLength": 1}, "obligation_anchors": {"type": "array", "items": {"type": "string"}}, "resolved": {"type": "boolean"}, "ineffective": {"type": "boolean"}, "evidence_refs": {"$ref": "#/$defs/refs"}, "call_refs": {"$ref": "#/$defs/callRefs"}, "cost_usd": {"type": "number", "minimum": 0}}
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["event_seq", "event_type", "prev_entry_sha256", "payload"],
      "properties": {
        "event_seq": {"type": "integer", "minimum": 1},
        "event_type": {"enum": ["trigger_evaluated", "candidate_rejected", "revision_activated", "epoch_materialized", "lease_started", "lease_finished", "verification_committed", "revision_evaluated"]},
        "prev_entry_sha256": {"$ref": "#/$defs/sha256"},
        "payload": {"type": "object"}
      },
      "oneOf": [
        {"properties": {"event_type": {"const": "trigger_evaluated"}, "payload": {"$ref": "#/$defs/trigger"}}},
        {"properties": {"event_type": {"const": "candidate_rejected"}, "payload": {"$ref": "#/$defs/candidateRejected"}}},
        {"properties": {"event_type": {"const": "revision_activated"}, "payload": {"$ref": "#/$defs/activation"}}},
        {"properties": {"event_type": {"const": "epoch_materialized"}, "payload": {"$ref": "#/$defs/epoch"}}},
        {"properties": {"event_type": {"const": "lease_started"}, "payload": {"$ref": "#/$defs/leaseStarted"}}},
        {"properties": {"event_type": {"const": "lease_finished"}, "payload": {"$ref": "#/$defs/leaseFinished"}}},
        {"properties": {"event_type": {"const": "verification_committed"}, "payload": {"$ref": "#/$defs/verification"}}},
        {"properties": {"event_type": {"const": "revision_evaluated"}, "payload": {"$ref": "#/$defs/evaluation"}}}
      ]
    }
  }
}
