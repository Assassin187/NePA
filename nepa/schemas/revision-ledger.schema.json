{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/revision-ledger.schema.json",
  "title": "NePA append-only revision ledger",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {"schema_version": {"const": "1.0"}, "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}},
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "trigger": {"type": "object", "additionalProperties": false, "required": ["code", "evidence_refs"], "properties": {"code": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}}},
    "patch": {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"enum": ["split_task", "merge_tasks", "rewrite_instructions", "add_contract", "remove_contract", "re_adopt"]}, "target_uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "into": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}, "merged_from": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["inherit", "revalidate", "amend", "regenerate"], "properties": {"inherit": {"type": "integer", "minimum": 0}, "revalidate": {"type": "integer", "minimum": 0}, "amend": {"type": "integer", "minimum": 0}, "regenerate": {"type": "integer", "minimum": 0}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["old_task_id", "old_task_uid", "new_task_id", "new_task_uid", "classification", "reason", "old_attempts"], "properties": {"old_task_id": {"type": ["string", "null"], "pattern": "^T-[0-9]{3}$"}, "old_task_uid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"}, "merged_from": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}, "merged_from_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T-[0-9]{3}$"}}, "new_task_id": {"type": ["string", "null"], "pattern": "^T-[0-9]{3}$"}, "new_task_uid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"}, "classification": {"enum": ["INHERIT", "REVALIDATE", "AMEND", "REGENERATE"]}, "reason": {"type": "string", "minLength": 1}, "old_attempts": {"type": "integer", "minimum": 0}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "old_owner_uid", "new_owner_uid", "classification"], "properties": {"path": {"type": "string", "minLength": 1}, "old_owner_uid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"}, "new_owner_uid": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"}, "classification": {"enum": ["INHERIT", "REVALIDATE", "AMEND", "REGENERATE"]}}},
    "migration": {"type": "object", "additionalProperties": false, "required": ["counts", "tasks", "files"], "properties": {"counts": {"$ref": "#/$defs/counts"}, "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}, "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}}},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["revision_seq", "prev_entry_sha256", "from_plan_ref", "to_plan_ref", "from_version", "to_version", "level", "trigger", "trigger_signature", "patch_ops", "migration", "preservation_rate", "gates", "epoch_after", "activated_at_commit", "cost_usd"],
      "properties": {
        "revision_seq": {"type": "integer", "minimum": 1}, "prev_entry_sha256": {"$ref": "#/$defs/sha256"}, "from_plan_ref": {"$ref": "#/$defs/ref"}, "to_plan_ref": {"$ref": "#/$defs/ref"}, "from_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}, "to_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}, "level": {"enum": ["F1", "F2", "F3"]}, "trigger": {"$ref": "#/$defs/trigger"}, "trigger_signature": {"$ref": "#/$defs/sha256"}, "patch_ops": {"type": "array", "items": {"$ref": "#/$defs/patch"}}, "migration": {"$ref": "#/$defs/migration"}, "preservation_rate": {"type": "number", "minimum": 0, "maximum": 1}, "gates": {"type": "object", "additionalProperties": false, "required": ["RG-1", "RG-2", "RG-3", "RG-4", "RG-5"], "properties": {"RG-1": {"enum": ["pass", "fail"]}, "RG-2": {"enum": ["pass", "fail"]}, "RG-3": {"enum": ["pass", "fail"]}, "RG-4": {"enum": ["pass", "fail"]}, "RG-5": {"enum": ["pass", "fail"]}}}, "epoch_after": {"type": "string", "pattern": "^E[0-9]+$"}, "activated_at_commit": {"$ref": "#/$defs/commit"}, "cost_usd": {"type": "number", "minimum": 0}
      }
    }
  }
}
