{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-attempt-declaration.schema.json","title":"Patch prompt development attempt declaration","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","version","attempt","status","prompt_ref","prompt_sha256","trial_count","semantic_depth","repair_mode","model_ids","initial_trial_ids"],"properties":{"schema_version":{"const":"2.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version":{"enum":["v0","v1","v2","v3","v4"]},"attempt":{"type":"integer","minimum":1},"status":{"const":"declared"},"prompt_ref":{"$ref":"#/$defs/ref"},"prompt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"trial_count":{"const":3},"semantic_depth":{"const":2},"repair_mode":{"const":"patch"},"model_ids":{"const":["qwen","claude","deepseek"]},"initial_trial_ids":{"type":"object","additionalProperties":false,"required":["qwen","claude","deepseek"],"properties":{"qwen":{"const":["trial_001","trial_002","trial_003"]},"claude":{"const":["trial_001","trial_002","trial_003"]},"deepseek":{"const":["trial_001","trial_002","trial_003"]}}}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
