{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/segments.schema.json",
  "title": "NePA doc/segments.json v1.0",
  "description": "设计文档 5.6.1：文档分片索引（S1 输出）。覆盖率 >= 0.95 为 S1 验收标准（6.1），不在 schema 内强制。",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0" },
    "doc": {
      "description": "源文档元数据",
      "type": "object",
      "properties": {
        "doc_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "format": { "enum": ["pdf", "txt", "html"] },
        "char_count": {
          "description": "清理后全文字符数",
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["doc_id", "filename", "sha256", "format", "char_count"],
      "additionalProperties": false
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/segment" }
    },
    "coverage_ratio": {
      "description": "分片总字符 / 清理后全文字符",
      "type": "number",
      "minimum": 0
    }
  },
  "required": ["schema_version", "doc", "segments", "coverage_ratio"],
  "additionalProperties": false,
  "$defs": {
    "segment": {
      "type": "object",
      "properties": {
        "segment_id": { "type": "string", "pattern": "^seg-[0-9]+$" },
        "section_path": {
          "description": "章节路径，如 3.1.2/part2",
          "type": "string",
          "minLength": 1
        },
        "title": { "type": "string" },
        "text": { "type": "string", "minLength": 1 },
        "token_count": { "type": "integer", "minimum": 0 },
        "has_table": { "type": "boolean" },
        "page_range": {
          "description": "[起, 止]，PDF 才有",
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "warnings": {
          "description": "抽取警告",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["segment_id", "section_path", "title", "text", "token_count", "has_table", "warnings"],
      "additionalProperties": false
    }
  }
}
