{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/calibration-report.schema.json",
  "title": "NePA Calibration Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lineage_id", "prompt_version", "prompt_sha256", "model_id", "trial_count", "status", "metrics", "gates", "gate_stages", "failure_cooccurrence", "repairs", "usage", "model_identity", "trials", "trial_metrics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "lineage_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_id": {"enum": ["claude", "qwen", "deepseek"]},
    "trial_count": {"type": "integer", "minimum": 1},
    "status": {"enum": ["complete", "incomplete", "infrastructure-invalid"]},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_first_pass_rate", "schema_after_format_repair_rate", "arch_raw_first_pass_rate", "arch_semantic_first_pass_rate", "p0", "p1", "p2", "p1_reason", "p2_reason"],
      "properties": {
        "schema_first_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "schema_after_format_repair_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "arch_raw_first_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "arch_semantic_first_pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "p0": {"type": "number", "minimum": 0, "maximum": 1},
        "p1": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "p2": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "p1_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reason"}]},
        "p2_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reason"}]}
      }
    },
    "gates": {"$ref": "#/$defs/gate_map", "required": ["arch_01", "arch_02", "arch_03", "arch_04", "arch_05", "arch_06", "arch_07", "arch_08", "arch_09", "arch_10"]},
    "gate_stages": {"$ref": "#/$defs/gate_stage_map"},
    "failure_cooccurrence": {"$ref": "#/$defs/cooccurrence_map"},
    "repairs": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "format_usage", "semantic", "semantic_usage", "gain", "stage_gain"],
      "properties": {
        "format": {"type": "integer", "minimum": 0},
        "format_usage": {"$ref": "#/$defs/usage"},
        "semantic": {"$ref": "#/$defs/semantic_repair_counts"},
        "semantic_usage": {"$ref": "#/$defs/usage"},
        "gain": {"type": "object", "additionalProperties": {"$ref": "#/$defs/gain"}},
        "stage_gain": {"$ref": "#/$defs/stage_gain_map"}
      }
    },
    "usage": {"$ref": "#/$defs/usage"},
    "model_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "versions", "parameter_support"],
      "properties": {
        "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1},
        "versions": {"type": "array"}, "parameter_support": {"type": "object"}
      }
    },
    "trials": {"type": "array", "items": {"type": "string", "pattern": "^trial_[0-9]{3}$"}},
    "trial_metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trial_metric"}}
  },
  "$defs": {
    "reason": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}},
    "gate": {
      "type": "object", "additionalProperties": false, "required": ["passed", "denominator", "rate"],
      "properties": {"passed": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 1}, "rate": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "gate_map": {
      "type": "object", "additionalProperties": false,
      "required": ["arch_01", "arch_02", "arch_03", "arch_04", "arch_05", "arch_06", "arch_07", "arch_08", "arch_09", "arch_10"],
      "properties": {"arch_01": {"$ref": "#/$defs/gate"}, "arch_02": {"$ref": "#/$defs/gate"}, "arch_03": {"$ref": "#/$defs/gate"}, "arch_04": {"$ref": "#/$defs/gate"}, "arch_05": {"$ref": "#/$defs/gate"}, "arch_06": {"$ref": "#/$defs/gate"}, "arch_07": {"$ref": "#/$defs/gate"}, "arch_08": {"$ref": "#/$defs/gate"}, "arch_09": {"$ref": "#/$defs/gate"}, "arch_10": {"$ref": "#/$defs/gate"}}
    },
    "stage_gate": {
      "type": "object", "additionalProperties": false, "required": ["passed", "denominator", "rate"],
      "properties": {"passed": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 1}, "rate": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "gate_stage": {
      "type": "object", "additionalProperties": false, "required": ["p0", "p1", "p2"],
      "properties": {"p0": {"$ref": "#/$defs/stage_gate"}, "p1": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/stage_gate"}]}, "p2": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/stage_gate"}]}}
    },
    "gate_stage_map": {
      "type": "object", "additionalProperties": false,
      "required": ["arch_01", "arch_02", "arch_03", "arch_04", "arch_05", "arch_06", "arch_07", "arch_08", "arch_09", "arch_10"],
      "properties": {"arch_01": {"$ref": "#/$defs/gate_stage"}, "arch_02": {"$ref": "#/$defs/gate_stage"}, "arch_03": {"$ref": "#/$defs/gate_stage"}, "arch_04": {"$ref": "#/$defs/gate_stage"}, "arch_05": {"$ref": "#/$defs/gate_stage"}, "arch_06": {"$ref": "#/$defs/gate_stage"}, "arch_07": {"$ref": "#/$defs/gate_stage"}, "arch_08": {"$ref": "#/$defs/gate_stage"}, "arch_09": {"$ref": "#/$defs/gate_stage"}, "arch_10": {"$ref": "#/$defs/gate_stage"}}
    },
    "cooccurrence": {
      "type": "object", "additionalProperties": false,
      "properties": {"arch_01": {"type": "integer", "minimum": 0}, "arch_02": {"type": "integer", "minimum": 0}, "arch_03": {"type": "integer", "minimum": 0}, "arch_04": {"type": "integer", "minimum": 0}, "arch_05": {"type": "integer", "minimum": 0}, "arch_06": {"type": "integer", "minimum": 0}, "arch_07": {"type": "integer", "minimum": 0}, "arch_08": {"type": "integer", "minimum": 0}, "arch_09": {"type": "integer", "minimum": 0}, "arch_10": {"type": "integer", "minimum": 0}}
    },
    "cooccurrence_map": {
      "type": "object", "additionalProperties": false,
      "properties": {"arch_01": {"$ref": "#/$defs/cooccurrence"}, "arch_02": {"$ref": "#/$defs/cooccurrence"}, "arch_03": {"$ref": "#/$defs/cooccurrence"}, "arch_04": {"$ref": "#/$defs/cooccurrence"}, "arch_05": {"$ref": "#/$defs/cooccurrence"}, "arch_06": {"$ref": "#/$defs/cooccurrence"}, "arch_07": {"$ref": "#/$defs/cooccurrence"}, "arch_08": {"$ref": "#/$defs/cooccurrence"}, "arch_09": {"$ref": "#/$defs/cooccurrence"}, "arch_10": {"$ref": "#/$defs/cooccurrence"}}
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["calls", "tokens_in", "tokens_out", "cost_usd", "latency_ms", "finish_reasons", "truncated"],
      "properties": {"calls": {"type": "integer", "minimum": 0}, "tokens_in": {"type": "integer", "minimum": 0}, "tokens_out": {"type": "integer", "minimum": 0}, "cost_usd": {"type": "number", "minimum": 0}, "latency_ms": {"type": "integer", "minimum": 0}, "finish_reasons": {"type": "object"}, "truncated": {"type": "integer", "minimum": 0}}
    },
    "semantic_repair_counts": {"type": "object", "additionalProperties": false, "properties": {"p1": {"type": "integer", "minimum": 0}, "p2": {"type": "integer", "minimum": 0}}},
    "gain": {
      "type": "object", "additionalProperties": false,
      "required": ["initial_passed", "final_passed", "denominator", "initial_rate", "final_rate", "gain"],
      "properties": {"initial_passed": {"type": "integer", "minimum": 0}, "final_passed": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 1}, "initial_rate": {"type": "number", "minimum": 0, "maximum": 1}, "final_rate": {"type": "number", "minimum": 0, "maximum": 1}, "gain": {"type": "number", "minimum": -1, "maximum": 1}}
    },
    "stage_transition": {
      "type": "object", "additionalProperties": false, "required": ["improved", "regressed", "unchanged", "denominator", "before_passed", "after_passed", "gain"],
      "properties": {"improved": {"type": "integer", "minimum": 0}, "regressed": {"type": "integer", "minimum": 0}, "unchanged": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 1}, "before_passed": {"type": "integer", "minimum": 0}, "after_passed": {"type": "integer", "minimum": 0}, "gain": {"type": "number", "minimum": -1, "maximum": 1}}
    },
    "stage_gain": {"type": "object", "additionalProperties": false, "required": ["p0_to_p1", "p1_to_p2"], "properties": {"p0_to_p1": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/stage_transition"}]}, "p1_to_p2": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/stage_transition"}]}}},
    "stage_gain_map": {
      "type": "object", "additionalProperties": false,
      "required": ["arch_01", "arch_02", "arch_03", "arch_04", "arch_05", "arch_06", "arch_07", "arch_08", "arch_09", "arch_10"],
      "properties": {"arch_01": {"$ref": "#/$defs/stage_gain"}, "arch_02": {"$ref": "#/$defs/stage_gain"}, "arch_03": {"$ref": "#/$defs/stage_gain"}, "arch_04": {"$ref": "#/$defs/stage_gain"}, "arch_05": {"$ref": "#/$defs/stage_gain"}, "arch_06": {"$ref": "#/$defs/stage_gain"}, "arch_07": {"$ref": "#/$defs/stage_gain"}, "arch_08": {"$ref": "#/$defs/stage_gain"}, "arch_09": {"$ref": "#/$defs/stage_gain"}, "arch_10": {"$ref": "#/$defs/stage_gain"}}
    },
    "trial_gate": {"type": "object", "additionalProperties": false, "required": ["initial_passed", "final_passed"], "properties": {"initial_passed": {"type": "boolean"}, "final_passed": {"type": "boolean"}}},
    "trial_stage_gate": {"type": "object", "additionalProperties": false, "required": ["p0", "p1", "p2"], "properties": {"p0": {"type": "boolean"}, "p1": {"type": ["boolean", "null"]}, "p2": {"type": ["boolean", "null"]}}},
    "trial_gate_change": {"type": "object", "additionalProperties": false, "required": ["p0_to_p1", "p1_to_p2"], "properties": {"p0_to_p1": {"enum": ["improved", "regressed", "unchanged", "not_declared"]}, "p1_to_p2": {"enum": ["improved", "regressed", "unchanged", "not_declared"]}}},
    "trial_metric": {
      "type": "object", "additionalProperties": false,
      "required": ["trial_id", "terminal", "first_passing_depth", "schema_first_pass", "schema_after_format_repair", "semantic_first_pass", "p0", "p1", "p2", "gates", "gate_stages", "gate_changes", "usage", "repairs"],
      "properties": {
        "trial_id": {"type": "string", "pattern": "^trial_[0-9]{3}$"}, "terminal": {"enum": ["pass", "semantic-fail", "schema-fail", "infrastructure-invalid"]}, "first_passing_depth": {"type": ["integer", "null"], "minimum": 0, "maximum": 2},
        "schema_first_pass": {"type": "boolean"}, "schema_after_format_repair": {"type": "boolean"}, "semantic_first_pass": {"type": "boolean"}, "p0": {"type": "boolean"}, "p1": {"type": ["boolean", "null"]}, "p2": {"type": ["boolean", "null"]},
        "gates": {"type": "object", "additionalProperties": false, "required": ["arch_01", "arch_02", "arch_03", "arch_04", "arch_05", "arch_06", "arch_07", "arch_08", "arch_09", "arch_10"], "properties": {"arch_01": {"$ref": "#/$defs/trial_gate"}, "arch_02": {"$ref": "#/$defs/trial_gate"}, "arch_03": {"$ref": "#/$defs/trial_gate"}, "arch_04": {"$ref": "#/$defs/trial_gate"}, "arch_05": {"$ref": "#/$defs/trial_gate"}, "arch_06": {"$ref": "#/$defs/trial_gate"}, "arch_07": {"$ref": "#/$defs/trial_gate"}, "arch_08": {"$ref": "#/$defs/trial_gate"}, "arch_09": {"$ref": "#/$defs/trial_gate"}, "arch_10": {"$ref": "#/$defs/trial_gate"}}},
        "gate_stages": {"type": "object", "additionalProperties": false, "required": ["arch_01", "arch_02", "arch_03", "arch_04", "arch_05", "arch_06", "arch_07", "arch_08", "arch_09", "arch_10"], "properties": {"arch_01": {"$ref": "#/$defs/trial_stage_gate"}, "arch_02": {"$ref": "#/$defs/trial_stage_gate"}, "arch_03": {"$ref": "#/$defs/trial_stage_gate"}, "arch_04": {"$ref": "#/$defs/trial_stage_gate"}, "arch_05": {"$ref": "#/$defs/trial_stage_gate"}, "arch_06": {"$ref": "#/$defs/trial_stage_gate"}, "arch_07": {"$ref": "#/$defs/trial_stage_gate"}, "arch_08": {"$ref": "#/$defs/trial_stage_gate"}, "arch_09": {"$ref": "#/$defs/trial_stage_gate"}, "arch_10": {"$ref": "#/$defs/trial_stage_gate"}}},
        "gate_changes": {"type": "object", "additionalProperties": false, "required": ["arch_01", "arch_02", "arch_03", "arch_04", "arch_05", "arch_06", "arch_07", "arch_08", "arch_09", "arch_10"], "properties": {"arch_01": {"$ref": "#/$defs/trial_gate_change"}, "arch_02": {"$ref": "#/$defs/trial_gate_change"}, "arch_03": {"$ref": "#/$defs/trial_gate_change"}, "arch_04": {"$ref": "#/$defs/trial_gate_change"}, "arch_05": {"$ref": "#/$defs/trial_gate_change"}, "arch_06": {"$ref": "#/$defs/trial_gate_change"}, "arch_07": {"$ref": "#/$defs/trial_gate_change"}, "arch_08": {"$ref": "#/$defs/trial_gate_change"}, "arch_09": {"$ref": "#/$defs/trial_gate_change"}, "arch_10": {"$ref": "#/$defs/trial_gate_change"}}},
        "usage": {"$ref": "#/$defs/usage"},
        "repairs": {"type": "object", "additionalProperties": false, "required": ["format", "format_usage", "semantic", "semantic_usage"], "properties": {"format": {"type": "integer", "minimum": 0}, "format_usage": {"$ref": "#/$defs/usage"}, "semantic": {"$ref": "#/$defs/semantic_repair_counts"}, "semantic_usage": {"$ref": "#/$defs/usage"}}}
      }
    }
  }
}
