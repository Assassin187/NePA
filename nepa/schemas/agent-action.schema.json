{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "list_files"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": []
        }
      },
      "required": [
        "tool",
        "arguments"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "read_file"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24000
            },
            "json_pointer": {
              "type": "string"
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "path"
          ],
          "allOf": [
            {
              "if": {"required": ["start_line"]},
              "then": {"required": ["end_line"]}
            },
            {
              "if": {"required": ["end_line"]},
              "then": {"required": ["start_line"]}
            },
            {
              "not": {"required": ["json_pointer", "start_line"]}
            }
          ]
        }
      },
      "required": [
        "tool",
        "arguments"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "search"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "pattern"
          ]
        }
      },
      "required": [
        "tool",
        "arguments"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "write_file"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ]
        }
      },
      "required": [
        "tool",
        "arguments"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "replace_text"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "old": {
              "type": "string",
              "minLength": 1
            },
            "new": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "old",
            "new"
          ]
        }
      },
      "required": [
        "tool",
        "arguments"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "run_command"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "argv"
          ]
        }
      },
      "required": [
        "tool",
        "arguments"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "finish"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "claims": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "implemented",
                      "already_present",
                      "not_applicable"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "code_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "id",
                  "status",
                  "reason"
                ]
              }
            }
          },
          "required": [
            "summary",
            "claims"
          ]
        }
      },
      "required": [
        "tool",
        "arguments"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "const": "request_followup"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issue": {
              "type": "string",
              "minLength": 1
            },
            "requirement_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "diagnostic_refs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              }
            }
          },
          "required": [
            "issue",
            "requirement_ids",
            "diagnostic_refs"
          ]
        }
      },
      "required": [
        "tool",
        "arguments"
      ]
    }
  ]
}
