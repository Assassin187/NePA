{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/revision-candidate.schema.json",
  "title": "NePA unactivated revision candidate v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "selected_event_seq", "level", "source", "selected_trigger", "patch_ref", "plan_draft_ir_ref", "candidate_plan_ref", "blueprint_ref", "manifest_ref", "contract_map_ref", "lineage_ref", "obligation_mapping_ref", "migration_ref", "lint_report_ref", "invariant_report_ref", "content_hashes"],
  "properties": {
    "schema_version": {"const": "1.0"}, "candidate_id": {"type": "string", "pattern": "^candidate-[1-9][0-9]*$"}, "selected_event_seq": {"type": "integer", "minimum": 1}, "level": {"enum": ["F2", "F3"]},
    "source": {"type": "object", "additionalProperties": false, "required": ["plan_ref", "revision_seq", "ledger_prefix_sha256"], "properties": {"plan_ref": {"$ref": "#/$defs/ref"}, "revision_seq": {"type": "integer", "minimum": 0}, "ledger_prefix_sha256": {"$ref": "#/$defs/sha256"}}},
    "selected_trigger": {"type": "object", "additionalProperties": false, "required": ["code", "signature"], "properties": {"code": {"enum": ["TR-1", "TR-2", "TR-3", "TR-4", "TR-6", "TR-7"]}, "signature": {"$ref": "#/$defs/sha256"}}},
    "patch_ref": {"$ref": "#/$defs/ref"}, "plan_draft_ir_ref": {"$ref": "#/$defs/ref"}, "candidate_plan_ref": {"$ref": "#/$defs/ref"}, "blueprint_ref": {"$ref": "#/$defs/ref"}, "manifest_ref": {"$ref": "#/$defs/ref"}, "contract_map_ref": {"$ref": "#/$defs/ref"}, "lineage_ref": {"$ref": "#/$defs/ref"}, "obligation_mapping_ref": {"$ref": "#/$defs/ref"}, "migration_ref": {"$ref": "#/$defs/ref"}, "lint_report_ref": {"$ref": "#/$defs/ref"}, "invariant_report_ref": {"$ref": "#/$defs/ref"},
    "content_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}, "minProperties": 10}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
