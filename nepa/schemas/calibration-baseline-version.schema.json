{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-baseline-version.schema.json","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","version","status","protocol_ref","bundle_ref","semantic_depth","base_trial_count","model_slot","repair_mode"],"properties":{"schema_version":{"const":"4.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version":{"enum":["v0","v1","v2"]},"status":{"enum":["admitted","assessed","selected","failed","invalid"]},"protocol_ref":{"$ref":"#/$defs/ref"},"bundle_ref":{"$ref":"#/$defs/ref"},"semantic_depth":{"const":2},"base_trial_count":{"const":3},"model_slot":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"repair_mode":{"const":"patch"}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
