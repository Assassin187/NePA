{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/build-result.schema.json",
  "title": "NePA E0 build result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tree_sha256", "variant", "command", "exit_code", "stdout", "stderr", "duration_ms", "timed_out", "artifacts", "status"],
  "properties": {
    "schema_version": {"const": "1.0"}, "tree_sha256": {"$ref": "#/$defs/sha256"}, "variant": {"type": "string", "minLength": 1}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exit_code": {"type": ["integer", "null"]}, "stdout": {"type": "string"}, "stderr": {"type": "string"}, "duration_ms": {"type": "integer", "minimum": 0}, "timed_out": {"type": "boolean"}, "artifacts": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["passed", "failed"]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
