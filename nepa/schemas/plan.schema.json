{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/plan.schema.json",
  "title": "NePA plan.json v1.0",
  "description": "设计文档 5.2：计划工件（S4 输出）。DAG 无环、文件白名单互斥、acceptance 测试存在性由 plan_lint 检查；任务粒度（≤4 文件）为 SHOULD 级，亦由 plan_lint 检查。",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0" },
    "spec_ref": {
      "description": "5.2：所依据规格的路径 + 内容哈希（防错位）",
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "modules": {
      "description": "5.2：模块划分",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/$defs/generic_id" },
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "owns_files": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "required": ["id", "name", "purpose", "owns_files"],
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "required": ["schema_version", "spec_ref", "modules", "tasks"],
  "additionalProperties": false,
  "$defs": {
    "generic_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_id": {
      "description": "5.2：T-###，三位序号即建议执行序",
      "type": "string",
      "pattern": "^T-[0-9]{3}$"
    },
    "task": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/task_id" },
        "title": { "type": "string", "minLength": 1 },
        "goal": {
          "description": "一句话目标，可验证",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["scaffold", "codec", "state", "logic", "transport", "app", "integration"]
        },
        "module": {
          "description": "所属模块 id",
          "$ref": "#/$defs/generic_id"
        },
        "instructions": { "type": "string", "minLength": 1 },
        "deliverable_files": {
          "description": "本任务允许创建/修改的文件白名单",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "context_refs": {
          "description": "5.2：上下文切片引用",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": ["message", "type", "state_machine", "behavior", "interface_file"]
              },
              "id": { "type": "string", "minLength": 1 }
            },
            "required": ["kind", "id"],
            "additionalProperties": false
          }
        },
        "depends_on": {
          "type": "array",
          "items": { "$ref": "#/$defs/task_id" }
        },
        "acceptance": {
          "description": "5.2：机器可判验收：build + gold 测试清单中的 pytest nodeid",
          "type": "object",
          "properties": {
            "build": { "type": "boolean" },
            "tests": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["build", "tests"],
          "additionalProperties": false
        },
        "status": {
          "description": "5.2：status 枚举（含 blocked_by_dependency，6.6.1）",
          "enum": ["pending", "in_progress", "done", "blocked", "blocked_by_dependency"]
        },
        "attempts": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      },
      "required": [
        "id",
        "title",
        "goal",
        "kind",
        "module",
        "instructions",
        "deliverable_files",
        "context_refs",
        "depends_on",
        "acceptance",
        "status"
      ],
      "additionalProperties": false
    }
  }
}
