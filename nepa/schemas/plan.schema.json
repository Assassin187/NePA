{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/plan.schema.json",
  "title": "NePA Plan v4",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "input_refs", "delivery_blueprint_sha256", "architecture", "work_packages", "tasks", "coverage", "review"],
  "properties": {
    "schema_version": {"const": "4.0"}, "input_refs": {"$ref": "#/$defs/inputRefs"}, "delivery_blueprint_sha256": {"$ref": "#/$defs/sha256"},
    "architecture": {"$ref": "#/$defs/finalArchitecture"}, "work_packages": {"type": "array", "items": {"$ref": "#/$defs/workPackage"}},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}, "coverage": {"$ref": "#/$defs/coverage"}, "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "inputRefs": {"type": "object", "additionalProperties": false, "required": ["spec", "target_profile", "test_bundle"], "properties": {"spec": {"$ref": "#/$defs/ref"}, "target_profile": {"$ref": "#/$defs/ref"}, "test_bundle": {"$ref": "#/$defs/ref"}}},
    "contextRef": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["requirement", "message", "type", "interface_file"]}, "id": {"type": "string", "minLength": 1}}},
    "responsibility": {"type": "object", "additionalProperties": false, "required": ["req_id", "role"], "properties": {"req_id": {"type": "string", "minLength": 1}, "role": {"enum": ["primary", "supporting"]}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["id", "topic", "statement", "context_refs"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "topic": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "context_refs": {"type": "array", "items": {"$ref": "#/$defs/contextRef"}}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["id", "purpose", "owner", "interface_files", "ready_gate", "provider", "consumers"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "purpose": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "interface_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "ready_gate": {"enum": ["s5", "task"]}, "provider": {"type": "string", "minLength": 1}, "consumers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}, "provider_task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}}},
    "module": {"type": "object", "additionalProperties": false, "required": ["id", "name", "purpose", "responsibilities", "non_goals", "owns_files", "provides_contracts", "consumes_contracts"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "name": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "responsibilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "owns_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "provides_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}, "consumes_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}}},
    "workPackage": {"type": "object", "additionalProperties": false, "required": ["id", "title", "goal", "module", "kind", "context_refs", "requirement_responsibilities", "allowed_files", "provides_contracts", "consumes_contracts", "depends_on", "acceptance"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "title": {"type": "string", "minLength": 1}, "goal": {"type": "string", "minLength": 1}, "module": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "kind": {"type": "string", "minLength": 1}, "context_refs": {"type": "array", "items": {"$ref": "#/$defs/contextRef"}}, "requirement_responsibilities": {"type": "array", "items": {"$ref": "#/$defs/responsibility"}}, "allowed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "provides_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}, "consumes_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}, "acceptance": {"type": "object", "additionalProperties": false, "required": ["outcome"], "properties": {"outcome": {"type": "string", "minLength": 1}}}}},
    "layoutFile": {"type": "object", "additionalProperties": false, "required": ["slot_id", "path", "path_pattern", "expand_over", "class", "render_rule", "owner_module", "contract_id", "build_role", "purpose"], "properties": {"slot_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "path": {"type": ["string", "null"]}, "path_pattern": {"type": ["string", "null"]}, "expand_over": {"type": ["string", "null"], "enum": ["messages", "types", null]}, "class": {"enum": ["s5_frozen", "s6_owned"]}, "render_rule": {"enum": ["header", "source_stub", "build_file", "doc", "mechanical"]}, "owner_module": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "contract_id": {"type": ["string", "null"]}, "build_role": {"enum": ["link_source", "entry_point", "none"]}, "purpose": {"type": "string", "minLength": 1}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "output_path", "entry_file_slot", "link_source_slots"], "properties": {"artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "output_path": {"type": "string", "minLength": 1}, "entry_file_slot": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "link_source_slots": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}}},
    "layout": {"type": "object", "additionalProperties": false, "required": ["roots", "files", "build_graph"], "properties": {"roots": {"type": "object", "additionalProperties": false, "required": ["include", "source", "app", "build"], "properties": {"include": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "app": {"type": "string", "minLength": 1}, "build": {"type": "string", "minLength": 1}}}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layoutFile"}}, "build_graph": {"type": "object", "additionalProperties": false, "required": ["artifacts"], "properties": {"artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}}}}},
    "finalArchitecture": {"type": "object", "additionalProperties": false, "required": ["schema_version", "decisions", "assumptions", "contracts", "modules", "layout"], "properties": {"schema_version": {"const": "2.0"}, "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}}, "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}}, "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}}, "layout": {"$ref": "#/$defs/layout"}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["build_variant_ids", "tests"], "properties": {"build_variant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "tests": {"const": []}}},
    "task": {
      "type": "object", "additionalProperties": false, "required": ["id", "work_package", "title", "goal", "kind", "instructions", "deliverable_files", "context_refs", "requirement_responsibilities", "provides_contracts", "consumes_contracts", "depends_on", "acceptance"],
      "properties": {
        "id": {"type": "string", "pattern": "^T-[0-9]{3}$"}, "work_package": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "goal": {"type": "string", "minLength": 1}, "kind": {"enum": ["codec", "state", "logic", "transport", "app", "integration"]}, "instructions": {"type": "string", "minLength": 1},
        "deliverable_files": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "context_refs": {"type": "array", "items": {"$ref": "#/$defs/contextRef"}}, "requirement_responsibilities": {"type": "array", "items": {"$ref": "#/$defs/responsibility"}}, "provides_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "consumes_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T-[0-9]{3}$"}}, "acceptance": {"$ref": "#/$defs/acceptance"}
      }
    },
    "coverage": {"type": "object", "additionalProperties": false, "required": ["requirements", "tests"], "properties": {"requirements": {"type": "array", "items": {"$ref": "#/$defs/requirementCoverage"}}, "tests": {"type": "array", "items": {"$ref": "#/$defs/testCoverage"}}}},
    "requirementCoverage": {"type": "object", "additionalProperties": false, "required": ["req_id", "primary_work_package_id", "primary_task_id", "supporting_task_ids", "test_nodeids"], "properties": {"req_id": {"type": "string", "minLength": 1}, "primary_work_package_id": {"type": ["string", "null"]}, "primary_task_id": {"type": ["string", "null"]}, "supporting_task_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^T-[0-9]{3}$"}}, "test_nodeids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "testCoverage": {"type": "object", "additionalProperties": false, "required": ["nodeid", "gate", "enabled", "task_id"], "properties": {"nodeid": {"type": "string", "minLength": 1}, "gate": {"enum": ["s5", "task", "s7_only"]}, "enabled": {"type": "boolean"}, "task_id": {"type": ["string", "null"], "pattern": "^T-[0-9]{3}$"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["verdict", "unresolved_minor_issues"], "properties": {"verdict": {"const": "pass"}, "unresolved_minor_issues": {"type": "array", "items": {"type": "object", "additionalProperties": true}}}}
  }
}
