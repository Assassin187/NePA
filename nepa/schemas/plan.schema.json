{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "6.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "input_hashes": {
      "type": "object",
      "properties": {
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "spec",
        "target"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "bootstrap",
              "wire",
              "message",
              "requirements",
              "integration",
              "followup"
            ]
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "object"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "goal",
          "context",
          "requirement_ids",
          "depends_on"
        ],
        "additionalProperties": false
      }
    },
    "primary_tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "revision",
    "reason",
    "input_hashes",
    "tasks",
    "primary_tasks"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
