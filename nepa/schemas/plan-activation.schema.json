{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/plan-activation.schema.json",
  "title": "NePA Plan revision activation WAL v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "selected_event_seq", "revision_seq", "level", "phase", "old", "new", "candidate_plan", "candidate_plan_ref", "binding", "pending_materialization", "gates_ref", "rehearsal_ref", "hashes"],
  "properties": {
    "schema_version": {"const": "2.0"}, "candidate_id": {"type": "string", "pattern": "^candidate-[1-9][0-9]*$"},
    "selected_event_seq": {"type": "integer", "minimum": 1}, "revision_seq": {"type": "integer", "minimum": 1}, "level": {"enum": ["F2", "F3"]},
    "phase": {"enum": ["prepared", "plan_published", "binding_published", "state_published", "file_ledger_published", "revision_ledger_published", "pointer_committed", "projections_published", "reconciled"]},
    "old": {"$ref": "#/$defs/view"}, "new": {"$ref": "#/$defs/view"}, "candidate_plan": {"type": "object"}, "candidate_plan_ref": {"$ref": "#/$defs/ref"},
    "binding": {"anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]}, "pending_materialization": {"type": "boolean"},
    "gates_ref": {"$ref": "#/$defs/ref"}, "rehearsal_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "hashes": {"type": "object", "additionalProperties": false, "required": ["old", "new", "candidate_plan", "binding"], "properties": {"old": {"$ref": "#/$defs/viewHashes"}, "new": {"$ref": "#/$defs/viewHashes"}, "candidate_plan": {"$ref": "#/$defs/sha256"}, "binding": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}}
  },
  "allOf": [
    {"if": {"properties": {"level": {"const": "F2"}}, "required": ["level"]}, "then": {"properties": {"binding": {"$ref": "#/$defs/binding"}, "pending_materialization": {"const": false}, "rehearsal_ref": {"type": "null"}}}},
    {"if": {"properties": {"level": {"const": "F3"}}, "required": ["level"]}, "then": {"properties": {"binding": {"type": "null"}, "pending_materialization": {"const": true}, "rehearsal_ref": {"$ref": "#/$defs/ref"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "view": {"type": "object", "additionalProperties": false, "required": ["pointer", "state", "file_ledger", "revision_ledger", "run", "manifest", "contract_map"], "properties": {"pointer": {"type": "object"}, "state": {"type": "object"}, "file_ledger": {"type": "object"}, "revision_ledger": {"type": "object"}, "run": {"type": "object"}, "manifest": {"type": "object"}, "contract_map": {"type": "object"}}},
    "viewHashes": {"type": "object", "additionalProperties": false, "required": ["pointer", "state", "file_ledger", "revision_ledger", "run", "manifest", "contract_map"], "properties": {"pointer": {"$ref": "#/$defs/sha256"}, "state": {"$ref": "#/$defs/sha256"}, "file_ledger": {"$ref": "#/$defs/sha256"}, "revision_ledger": {"$ref": "#/$defs/sha256"}, "run": {"$ref": "#/$defs/sha256"}, "manifest": {"$ref": "#/$defs/sha256"}, "contract_map": {"$ref": "#/$defs/sha256"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["manifest", "contract_map", "receipt", "manifest_ref", "contract_map_ref", "receipt_ref"], "properties": {"manifest": {"type": "object"}, "contract_map": {"type": "object"}, "receipt": {"type": "object"}, "manifest_ref": {"$ref": "#/$defs/ref"}, "contract_map_ref": {"$ref": "#/$defs/ref"}, "receipt_ref": {"$ref": "#/$defs/ref"}}}
  }
}
