{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/s4-commitment.schema.json",
  "title": "NePA S4 commitment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_refs", "config_snapshot_sha256", "strategy", "requirements", "test_manifest", "build_variant_ids", "budgets", "layer_switches"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "input_refs": {"$ref": "#/$defs/inputRefs"},
    "config_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "strategy": {"enum": ["layered", "flat"]},
    "requirements": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "level"], "properties": {"id": {"type": "string", "minLength": 1}, "level": {"enum": ["MUST", "MUST NOT", "SHOULD", "SHOULD NOT", "DEFINITION"]}}}},
    "test_manifest": {"type": "object", "additionalProperties": false, "required": ["schema_version", "bundle", "tests", "build_variant_ids"], "properties": {"schema_version": {"const": "1.0"}, "bundle": {"$ref": "#/$defs/bundle"}, "tests": {"type": "array", "items": {"$ref": "#/$defs/test"}}, "build_variant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "build_variant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "budgets": {"$ref": "#/$defs/budgets"},
    "layer_switches": {"type": "object", "additionalProperties": false, "required": ["l0", "l1", "l2", "l3"], "properties": {"l0": {"type": "boolean"}, "l1": {"type": "boolean"}, "l2": {"type": "boolean"}, "l3": {"type": "boolean"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "inputRefs": {"type": "object", "additionalProperties": false, "required": ["spec", "target_profile", "test_bundle"], "properties": {"spec": {"$ref": "#/$defs/ref"}, "target_profile": {"$ref": "#/$defs/ref"}, "test_bundle": {"$ref": "#/$defs/ref"}}},
    "bundle": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "test": {"type": "object", "additionalProperties": false, "required": ["nodeid", "layer", "description", "req_ids", "gate", "build_variant_ids"], "properties": {"nodeid": {"type": "string", "minLength": 1}, "layer": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "req_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "gate": {"enum": ["s5", "task", "s7_only"]}, "build_variant_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["plan_architecture_repairs", "plan_task_shard_repairs", "plan_critic_repairs", "plan_global_replans", "max_task_files", "context_safety_margin_ratio"], "properties": {"plan_architecture_repairs": {"type": "integer", "minimum": 0}, "plan_task_shard_repairs": {"type": "integer", "minimum": 0}, "plan_critic_repairs": {"type": "integer", "minimum": 0}, "plan_global_replans": {"type": "integer", "minimum": 0}, "max_task_files": {"type": "integer", "minimum": 1}, "context_safety_margin_ratio": {"type": "number", "minimum": 0, "maximum": 1}}}
  }
}
