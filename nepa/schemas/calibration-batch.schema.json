{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-batch.schema.json","title":"NePA Calibration Batch","type":"object","additionalProperties":false,"required":["schema_version","status","lineage_id","prompt_version","prompt_sha256","prompt_template_ref","model_id","provider","model","temperature","max_tokens","trial_count","semantic_depth","context_window_tokens","trials","attempt"],"properties":{"schema_version":{"const":"2.0"},"status":{"enum":["declared","complete","incomplete","infrastructure-invalid"]},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"prompt_version":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},"prompt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"prompt_template_ref":{"$ref":"#/$defs/ref"},"model_id":{"enum":["qwen","claude","deepseek"]},"provider":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"temperature":{"type":"number","minimum":0},"max_tokens":{"const":65536},"trial_count":{"type":"integer","minimum":1},"semantic_depth":{"type":"integer","minimum":0,"maximum":2},"context_window_tokens":{"type":"integer","minimum":1},"trials":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^trial_[0-9]{3}$"},"uniqueItems":true},"attempt":{"type":"integer","minimum":1},"batch_kind":{"enum":["base","extension"]},"trial_start":{"type":"integer","minimum":1},"root_path":{"type":"string","pattern":"^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
