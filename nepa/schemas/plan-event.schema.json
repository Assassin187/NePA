{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/plan-event.schema.json",
  "title": "NePA Plan State event v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event", "task_id"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "event": {"enum": ["attempt_started", "attempt_succeeded", "attempts_exhausted", "amendment_started", "amendment_succeeded", "amendment_failed", "validation_started", "revalidation_passed", "revalidation_failed", "dependency_blocked", "reopened_by_revision", "reconciled_commit", "amended_under_lease", "group_verified", "group_exhausted", "reconciled_group"]},
    "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}, "attempt": {"type": "integer", "minimum": 1, "maximum": 4}, "previous_error": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "evidence_ref": {"$ref": "#/$defs/ref"}, "error": {"type": "string", "minLength": 1},
    "group_id": {"type": "string", "pattern": "^g-[1-9][0-9]*-[1-9][0-9]*$"}, "member_task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^T-[0-9]{3}$"}}, "member_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "verification_id": {"type": "string", "minLength": 1}, "notes": {"type": "string"},
    "proof": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {
      "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "baseline_tree": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "s6_attempts_used": {"type": "integer", "minimum": 0}, "evidence_seq": {"type": "integer", "minimum": 1},
      "migration_ref": {"$ref": "#/$defs/migrationRef"}, "activation_ref": {"$ref": "#/$defs/migrationRef"}, "group_id": {"type": "string", "pattern": "^g-[1-9][0-9]*-[1-9][0-9]*$"},
      "previous_failure_ref": {"$ref": "#/$defs/ref"}, "evidence_ref": {"$ref": "#/$defs/ref"}, "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "file_ledger_ref": {"$ref": "#/$defs/ref"}, "revision_ledger_ref": {"$ref": "#/$defs/ref"}, "event_ref": {"type": "object", "additionalProperties": false, "required": ["event_seq"], "properties": {"event_seq": {"type": "integer", "minimum": 1}}},
      "kind": {"type": "string", "minLength": 1}, "verification_id": {"type": "string", "minLength": 1}, "workspace_tree": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "parent_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "member_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}}, "member_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
    }}
  },
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "migrationRef": {"type": "object", "additionalProperties": false, "required": ["revision_seq", "event_seq"], "properties": {"revision_seq": {"type": "integer", "minimum": 1}, "event_seq": {"type": "integer", "minimum": 1}}}
  },
  "allOf": [
    {"if": {"properties": {"event": {"const": "amended_under_lease"}}}, "then": {"properties": {"member_task_ids": {"minItems": 2}, "member_evidence_refs": {"minItems": 2}, "proof": {"properties": {"member_uids": {"minItems": 2}, "member_evidence_refs": {"minItems": 2}}}}}},
    {"if": {"properties": {"event": {"enum": ["amended_under_lease", "group_verified", "reconciled_group"]}}}, "then": {"required": ["member_task_ids", "member_evidence_refs", "commit_sha", "verification_id", "evidence_ref", "proof"], "properties": {"proof": {"required": ["kind", "commit_sha", "verification_id", "workspace_tree", "parent_sha", "member_uids", "member_evidence_refs"]}}}},
    {"if": {"properties": {"event": {"enum": ["group_verified", "group_exhausted", "reconciled_group"]}}}, "then": {"required": ["group_id", "member_task_ids", "proof"], "properties": {"proof": {"required": ["group_id", "activation_ref", "member_uids"]}}}}
  ]
}
