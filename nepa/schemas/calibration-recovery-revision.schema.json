{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-recovery-revision.schema.json","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","version","previous_version","previous_prompt_sha256","new_prompt_sha256","hypothesis","evidence_refs","unified_diff","expected_effect","stopping_conclusion"],"properties":{"schema_version":{"const":"1.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version":{"enum":["r1","r2"]},"previous_version":{"enum":["r0","r1"]},"previous_prompt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"new_prompt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"hypothesis":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ref"}},"unified_diff":{"type":"string","minLength":1},"expected_effect":{"type":"object","additionalProperties":false,"required":["kind","name","direction"],"properties":{"kind":{"enum":["metric","gate","locality"]},"name":{"type":"string","minLength":1},"direction":{"enum":["increase","decrease","pass"]}}},"stopping_conclusion":{"type":"string","minLength":1}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
