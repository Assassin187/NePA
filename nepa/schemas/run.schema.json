{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/run.schema.json",
  "title": "NePA run.json v1.0",
  "description": "设计文档 5.6.2：运行元数据。outcome 判定规则见 9.1.2；exit_code 约定见 8.7；run_id 命名见 4.4。",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": {
      "description": "4.4：<UTC时间戳>_<协议>_<入口>，与运行目录名一致",
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{4}Z_[a-z0-9][a-z0-9.-]*_(spec-run|doc-run)$"
    },
    "entry": { "enum": ["spec-run", "doc-run"] },
    "created_at": { "$ref": "#/$defs/utc_timestamp" },
    "inputs": {
      "description": "5.6.2：spec_path 或 doc_path、scope_path（doc-run）及各自 sha256",
      "type": "object",
      "properties": {
        "spec_path": { "type": "string", "minLength": 1 },
        "spec_sha256": { "$ref": "#/$defs/sha256" },
        "doc_path": { "type": "string", "minLength": 1 },
        "doc_sha256": { "$ref": "#/$defs/sha256" },
        "scope_path": { "type": "string", "minLength": 1 },
        "scope_sha256": { "$ref": "#/$defs/sha256" }
      },
      "oneOf": [
        { "required": ["spec_path", "spec_sha256"] },
        { "required": ["doc_path", "doc_sha256"] }
      ],
      "dependentRequired": {
        "spec_path": ["spec_sha256"],
        "spec_sha256": ["spec_path"],
        "doc_path": ["doc_sha256"],
        "doc_sha256": ["doc_path"],
        "scope_path": ["scope_sha256"],
        "scope_sha256": ["scope_path"]
      },
      "additionalProperties": false
    },
    "config_snapshot": {
      "description": "解析后的完整配置，密钥只留环境变量名（8.3）；结构由配置系统定义，此处不限定",
      "type": "object"
    },
    "stages": {
      "description": "每阶段一项（4.8）",
      "type": "object",
      "properties": {
        "s1": { "$ref": "#/$defs/stage_state" },
        "s2": { "$ref": "#/$defs/stage_state" },
        "s3": { "$ref": "#/$defs/stage_state" },
        "s4": { "$ref": "#/$defs/stage_state" },
        "s5": { "$ref": "#/$defs/stage_state" },
        "s6": { "$ref": "#/$defs/stage_state" },
        "s7": { "$ref": "#/$defs/stage_state" },
        "s8": { "$ref": "#/$defs/stage_state" },
        "s9": { "$ref": "#/$defs/stage_state" }
      },
      "required": ["s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9"],
      "additionalProperties": false
    },
    "budget_used": {
      "description": "随运行原子更新",
      "type": "object",
      "properties": {
        "wall_clock_s": { "type": "number", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "tokens_in": { "type": "integer", "minimum": 0 },
        "tokens_out": { "type": "integer", "minimum": 0 }
      },
      "required": ["wall_clock_s", "cost_usd", "tokens_in", "tokens_out"],
      "additionalProperties": false
    },
    "flags": {
      "description": "degraded_segmentation 等运行标志（开放布尔标志集）",
      "type": "object",
      "properties": {
        "degraded_segmentation": { "type": "boolean" }
      },
      "additionalProperties": { "type": "boolean" }
    },
    "outcome": {
      "description": "9.1.2 三值，运行结束时写入",
      "enum": ["success", "degraded", "failed"]
    },
    "exit_code": {
      "description": "8.7：0 成功；10 受控降级；20 受控失败；1 NePA 自身错误",
      "enum": [0, 1, 10, 20]
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "entry",
    "created_at",
    "inputs",
    "config_snapshot",
    "stages",
    "budget_used"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "stage_state": {
      "type": "object",
      "properties": {
        "status": { "enum": ["pending", "running", "done", "failed", "skipped"] },
        "started_at": { "$ref": "#/$defs/utc_timestamp" },
        "ended_at": { "$ref": "#/$defs/utc_timestamp" },
        "error": { "type": "string" }
      },
      "required": ["status"],
      "additionalProperties": false
    }
  }
}
