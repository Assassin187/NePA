{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "7.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "number",
      "minimum": 0
    },
    "updated_at": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "success",
        "failed",
        "budget_exhausted",
        "interrupted",
        "invalid",
        "internal_error",
        "study_complete"
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "index": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "spec",
        "target",
        "index"
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "package_sha256": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "package_sha256",
        "files"
      ],
      "additionalProperties": false
    },
    "config_snapshot": {
      "type": "object"
    },
    "config_sha256": {
      "type": "string",
      "minLength": 1
    },
    "active_plan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "accepted_checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "pending",
              "running",
              "passed",
              "failed"
            ]
          },
          "sessions": {
            "type": "integer",
            "minimum": 0
          },
          "decisions": {
            "type": "integer",
            "minimum": 0
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "implemented",
                    "already_present",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "code_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "id",
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "checkpoint": {
            "type": "string",
            "minLength": 1
          },
          "last_feedback": {
            "type": "object"
          }
        },
        "required": [
          "status",
          "sessions",
          "decisions",
          "claims",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "current_task": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_action": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "working_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "cost_cny": {
          "type": "number",
          "minimum": 0
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "settled_cny": {
          "type": "object",
          "properties": {
            "peak": {
              "type": "number",
              "minimum": 0
            },
            "off_peak": {
              "type": "number",
              "minimum": 0
            },
            "unclassified": {
              "type": "number",
              "minimum": 0
            },
            "flat": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "peak",
            "off_peak",
            "unclassified",
            "flat"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cost_cny",
        "tokens_in",
        "tokens_out",
        "calls",
        "settled_cny"
      ],
      "additionalProperties": false
    },
    "call_counter": {
      "type": "integer",
      "minimum": 0
    },
    "pending_calls": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "reserved": {
            "type": "number",
            "minimum": 0
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "started_at": {
            "type": "number"
          },
          "phase": {
            "enum": [
              "capability",
              "public_tools",
              "generation"
            ]
          }
        },
        "required": [
          "reserved",
          "task_id",
          "started_at",
          "phase"
        ],
        "additionalProperties": false
      }
    },
    "followups": {
      "type": "integer",
      "minimum": 0
    },
    "final_repairs": {
      "type": "integer",
      "minimum": 0
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sandbox_image": {
      "type": "string",
      "minLength": 1
    },
    "last_response": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "final_checks": {
      "type": "object"
    },
    "delivery": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "files",
        "checkpoint"
      ],
      "additionalProperties": false
    },
    "reason": {
      "type": "string"
    },
    "private_inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "verification_policy": {
      "type": "object",
      "properties": {
        "exposure": {
          "const": "private_isolated"
        },
        "verifier_version": {
          "const": "private-isolated/1"
        },
        "randomization_version": {
          "const": "random-inputs/1"
        }
      },
      "required": [
        "exposure",
        "verifier_version",
        "randomization_version"
      ],
      "additionalProperties": false
    },
    "phase_cost_cny": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "number",
          "minimum": 0
        },
        "public_tools": {
          "type": "number",
          "minimum": 0
        },
        "generation": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "capability",
        "public_tools",
        "generation"
      ],
      "additionalProperties": false
    },
    "liability_overflow_cny": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "updated_at",
    "status",
    "exit_code",
    "inputs",
    "runtime",
    "config_snapshot",
    "config_sha256",
    "active_plan",
    "accepted_checkpoint",
    "tasks",
    "current_task",
    "pending_action",
    "working_hashes",
    "budget",
    "call_counter",
    "pending_calls",
    "followups",
    "final_repairs",
    "history",
    "private_inputs",
    "verification_policy",
    "phase_cost_cny",
    "liability_overflow_cny"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "study_complete"
          }
        }
      },
      "then": {
        "properties": {
          "config_snapshot": {
            "properties": {
              "campaign": {
                "properties": {
                  "phase": {
                    "enum": [
                      "capability",
                      "public_tools"
                    ]
                  }
                },
                "required": [
                  "phase"
                ]
              }
            },
            "required": [
              "campaign"
            ]
          }
        }
      }
    }
  ]
}
