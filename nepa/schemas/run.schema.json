{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/run.schema.json",
  "title": "NePA run.json v2.0",
  "description": "设计文档 5.6.2：嵌套冻结输入、阶段 receipts、配置摘要与条件化终态。",
  "type": "object",
  "properties": {
    "schema_version": { "const": "2.0" },
    "run_id": {
      "description": "4.4：<UTC时间戳>_<协议>_<入口>，与运行目录名一致",
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{4}Z(?:-[2-9][0-9]*)?_[a-z0-9][a-z0-9.-]*_(spec-run|doc-run)$"
    },
    "entry": { "enum": ["spec-run", "doc-run"] },
    "created_at": { "$ref": "#/$defs/utc_timestamp" },
    "inputs": {
      "type": "object",
      "properties": {
        "spec": { "$ref": "#/$defs/source_file_ref" },
        "doc": { "$ref": "#/$defs/source_file_ref" },
        "scope": { "$ref": "#/$defs/source_file_ref" },
        "target_profile": { "$ref": "#/$defs/target_profile_ref" },
        "language_profile": { "$ref": "#/$defs/language_profile_ref" },
        "test_bundle": { "$ref": "#/$defs/test_bundle_ref" }
      },
      "required": ["target_profile", "language_profile", "test_bundle"],
      "additionalProperties": false
    },
    "config_snapshot": {
      "description": "解析后的完整配置，密钥只留环境变量名（8.3）",
      "type": "object"
    },
    "config_snapshot_sha256": {
      "description": "config_snapshot 内存对象的项目 canonical SHA-256",
      "$ref": "#/$defs/sha256"
    },
    "stages": {
      "description": "每阶段一项（4.8）",
      "type": "object",
      "properties": {
        "s1": { "$ref": "#/$defs/stage_state" },
        "s2": { "$ref": "#/$defs/stage_state" },
        "s3": { "$ref": "#/$defs/stage_state" },
        "s4": { "$ref": "#/$defs/stage_state" },
        "s5": { "$ref": "#/$defs/stage_state" },
        "s6": { "$ref": "#/$defs/stage_state" },
        "s7": { "$ref": "#/$defs/stage_state" },
        "s8": { "$ref": "#/$defs/stage_state" },
        "s9": { "$ref": "#/$defs/stage_state" }
      },
      "required": ["s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8", "s9"],
      "additionalProperties": false
    },
    "budget_used": {
      "type": "object",
      "properties": {
        "wall_clock_s": { "type": "number", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "tokens_in": { "type": "integer", "minimum": 0 },
        "tokens_out": { "type": "integer", "minimum": 0 }
      },
      "required": ["wall_clock_s", "cost_usd", "tokens_in", "tokens_out"],
      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "properties": {
        "degraded_segmentation": { "type": "boolean" }
      },
      "additionalProperties": { "type": "boolean" }
    },
    "termination_request": { "$ref": "#/$defs/termination_request" },
    "termination_kind": {
      "enum": ["completed", "planned_stop", "controlled_exit", "internal_error"]
    },
    "outcome": { "enum": ["success", "degraded", "failed"] },
    "exit_code": { "enum": [0, 1, 10, 20] }
  },
  "required": [
    "schema_version",
    "run_id",
    "entry",
    "created_at",
    "inputs",
    "config_snapshot",
    "config_snapshot_sha256",
    "stages",
    "budget_used"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "entry": { "const": "spec-run" } },
        "required": ["entry"]
      },
      "then": {
        "properties": {
          "inputs": {
            "required": ["spec"],
            "properties": {
              "doc": false,
              "scope": false
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "entry": { "const": "doc-run" } },
        "required": ["entry"]
      },
      "then": {
        "properties": {
          "inputs": {
            "required": ["doc", "scope"],
            "properties": {
              "spec": false
            }
          }
        }
      }
    },
    {
      "if": { "required": ["termination_kind"] },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["outcome"] },
            { "required": ["exit_code"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "termination_kind": { "const": "completed" } },
        "required": ["termination_kind"]
      },
      "then": {
        "required": ["outcome", "exit_code"],
        "not": { "required": ["termination_request"] }
      }
    },
    {
      "if": {
        "properties": { "termination_kind": { "const": "controlled_exit" } },
        "required": ["termination_kind"]
      },
      "then": {
        "properties": {
          "outcome": { "enum": ["degraded", "failed"] }
        },
        "required": ["termination_request", "outcome", "exit_code"]
      }
    },
    {
      "if": {
        "properties": { "termination_kind": { "const": "planned_stop" } },
        "required": ["termination_kind"]
      },
      "then": {
        "properties": { "exit_code": { "const": 0 } },
        "required": ["exit_code"],
        "not": {
          "anyOf": [
            { "required": ["outcome"] },
            { "required": ["termination_request"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "termination_kind": { "const": "internal_error" } },
        "required": ["termination_kind"]
      },
      "then": {
        "properties": { "exit_code": { "const": 1 } },
        "required": ["exit_code"],
        "not": { "required": ["outcome"] }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "success" } },
        "required": ["outcome"]
      },
      "then": { "properties": { "exit_code": { "const": 0 } } }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "degraded" } },
        "required": ["outcome"]
      },
      "then": { "properties": { "exit_code": { "const": 10 } } }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "failed" } },
        "required": ["outcome"]
      },
      "then": { "properties": { "exit_code": { "const": 20 } } }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generic_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "reason": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["code", "detail"],
      "additionalProperties": false
    },
    "termination_request": {
      "type": "object",
      "properties": {
        "kind": { "const": "controlled_exit" },
        "stage": {
          "enum": ["s1", "s2", "s3", "s4", "s5", "s6", "s7", "s8"]
        },
        "requested_at": { "$ref": "#/$defs/utc_timestamp" },
        "reason": { "$ref": "#/$defs/reason" }
      },
      "required": ["kind", "stage", "requested_at", "reason"],
      "additionalProperties": false
    },
    "source_file_ref": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["path", "sha256"],
      "additionalProperties": false
    },
    "asset_ref": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/generic_id" },
        "version": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/safe_relative_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["id", "version", "path", "sha256"],
      "additionalProperties": false
    },
    "target_profile_ref": {
      "allOf": [
        { "$ref": "#/$defs/asset_ref" },
        { "properties": { "path": { "const": "inputs/target.json" } } }
      ]
    },
    "language_profile_ref": {
      "allOf": [
        { "$ref": "#/$defs/asset_ref" },
        { "properties": { "path": { "const": "inputs/language.json" } } }
      ]
    },
    "test_bundle_ref": {
      "allOf": [
        { "$ref": "#/$defs/asset_ref" },
        { "properties": { "path": { "const": "inputs/test_bundle.json" } } }
      ]
    },
    "stage_state": {
      "type": "object",
      "properties": {
        "status": { "enum": ["pending", "running", "done", "failed", "skipped"] },
        "started_at": { "$ref": "#/$defs/utc_timestamp" },
        "ended_at": { "$ref": "#/$defs/utc_timestamp" },
        "error": { "type": "string" },
        "output_refs": {
          "description": "阶段专用 receipt；具体字段由对应阶段 Schema/validator 约束",
          "type": "object",
          "minProperties": 1
        }
      },
      "required": ["status"],
      "additionalProperties": false
    }
  }
}
