{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/task-evidence.schema.json",
  "title": "NePA Task Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_uid", "task_id", "evidence_seq", "execution_kind", "attempt", "amendment_used", "plan_ref", "plan_version", "epoch", "binding_ref", "input_refs", "plan_sha256", "workspace_tree", "build_result_refs", "smoke_result_refs", "test_summary_refs", "changed_files", "accepted", "migration_ref"],
  "properties": {
    "schema_version": {"const": "2.0"}, "task_uid": {"$ref": "#/$defs/uid"}, "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}, "evidence_seq": {"type": "integer", "minimum": 1},
    "execution_kind": {"enum": ["normal", "revalidate", "amend", "lease", "group"]}, "attempt": {"type": "integer", "minimum": 0, "maximum": 4}, "amendment_used": {"type": "integer", "enum": [0, 1]},
    "plan_ref": {"$ref": "#/$defs/planRef"}, "plan_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}, "epoch": {"type": "string", "pattern": "^E[0-9]+$"}, "binding_ref": {"$ref": "#/$defs/ref"},
    "input_refs": {"type": "object", "additionalProperties": false, "required": ["spec", "target_profile", "test_bundle"], "properties": {"spec": {"$ref": "#/$defs/ref"}, "target_profile": {"$ref": "#/$defs/ref"}, "test_bundle": {"$ref": "#/$defs/ref"}}},
    "plan_sha256": {"$ref": "#/$defs/sha256"}, "workspace_tree": {"$ref": "#/$defs/sha256"}, "build_result_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "smoke_result_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "test_summary_refs": {"type": "array", "maxItems": 0},
    "lease_id": {"type": "string", "pattern": "^lease-[1-9][0-9]*$"}, "lease_authorization_ref": {"$ref": "#/$defs/ref"}, "joint_evidence_ref": {"$ref": "#/$defs/ref"}, "lease_member_uids": {"$ref": "#/$defs/leaseMembers"},
    "group_id": {"type": "string", "pattern": "^g-[1-9][0-9]*-[1-9][0-9]*$"}, "group_member_uids": {"$ref": "#/$defs/groupMembers"},
    "changed_files": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}, "accepted": {"const": true}, "migration_ref": {"anyOf": [{"$ref": "#/$defs/migrationRef"}, {"type": "null"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "leaseMembers": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/uid"}}, "groupMembers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/uid"}},
    "planRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "version", "revision_seq", "epoch"], "properties": {"path": {"type": "string", "pattern": "^plan/versions/plan-1\\.[0-9]+\\.[0-9]+\\.json$"}, "sha256": {"$ref": "#/$defs/sha256"}, "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}, "revision_seq": {"type": "integer", "minimum": 0}, "epoch": {"type": "string", "pattern": "^E[0-9]+$"}}},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "migrationRef": {"type": "object", "additionalProperties": false, "required": ["revision_seq", "event_seq"], "properties": {"revision_seq": {"type": "integer", "minimum": 1}, "event_seq": {"type": "integer", "minimum": 1}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  },
  "allOf": [
    {"if": {"properties": {"execution_kind": {"const": "normal"}}}, "then": {"properties": {"attempt": {"minimum": 1}, "amendment_used": {"const": 0}, "changed_files": {"minItems": 1}}, "not": {"anyOf": [{"required": ["lease_id"]}, {"required": ["lease_authorization_ref"]}, {"required": ["joint_evidence_ref"]}, {"required": ["lease_member_uids"]}, {"required": ["group_id"]}, {"required": ["group_member_uids"]}]}}},
    {"if": {"properties": {"execution_kind": {"const": "revalidate"}}}, "then": {"properties": {"attempt": {"const": 0}, "amendment_used": {"const": 0}, "changed_files": {"maxItems": 0}, "migration_ref": {"$ref": "#/$defs/migrationRef"}}, "not": {"anyOf": [{"required": ["lease_id"]}, {"required": ["lease_authorization_ref"]}, {"required": ["joint_evidence_ref"]}, {"required": ["lease_member_uids"]}, {"required": ["group_id"]}, {"required": ["group_member_uids"]}]}}},
    {"if": {"properties": {"execution_kind": {"const": "amend"}}}, "then": {"properties": {"amendment_used": {"const": 1}, "changed_files": {"minItems": 1}, "migration_ref": {"$ref": "#/$defs/migrationRef"}}, "not": {"anyOf": [{"required": ["lease_id"]}, {"required": ["lease_authorization_ref"]}, {"required": ["joint_evidence_ref"]}, {"required": ["lease_member_uids"]}, {"required": ["group_id"]}, {"required": ["group_member_uids"]}]}}},
    {"if": {"properties": {"execution_kind": {"const": "lease"}}}, "then": {"required": ["lease_id", "lease_authorization_ref", "lease_member_uids"], "properties": {"attempt": {"minimum": 1}, "amendment_used": {"const": 0}, "migration_ref": {"type": "null"}}, "not": {"anyOf": [{"required": ["group_id"]}, {"required": ["group_member_uids"]}]}}},
    {"if": {"properties": {"execution_kind": {"const": "group"}}}, "then": {"required": ["group_id", "group_member_uids"], "properties": {"migration_ref": {"$ref": "#/$defs/migrationRef"}}, "allOf": [{"if": {"properties": {"amendment_used": {"const": 1}}}, "then": {"properties": {"changed_files": {"minItems": 1}}}}, {"if": {"properties": {"amendment_used": {"const": 0}, "attempt": {"const": 0}}}, "then": {"properties": {"changed_files": {"maxItems": 0}}}}, {"if": {"properties": {"amendment_used": {"const": 0}, "attempt": {"minimum": 1}}}, "then": {"properties": {"changed_files": {"minItems": 1}}}}], "not": {"anyOf": [{"required": ["lease_id"]}, {"required": ["lease_authorization_ref"]}, {"required": ["lease_member_uids"]}]}}}
  ]
}
