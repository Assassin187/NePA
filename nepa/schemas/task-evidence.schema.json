{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/task-evidence.schema.json",
  "title": "NePA Task Evidence v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_uid", "task_id", "evidence_seq", "execution_kind", "attempt", "amendment_used", "plan_ref", "plan_version", "epoch", "binding_ref", "input_refs", "plan_sha256", "workspace_tree", "build_result_refs", "smoke_result_refs", "test_summary_refs", "changed_files", "accepted", "migration_ref"],
  "properties": {
    "schema_version": {"const": "2.0"}, "task_uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"}, "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
    "evidence_seq": {"type": "integer", "minimum": 1}, "execution_kind": {"enum": ["normal", "revalidate", "amend", "lease", "group"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 4}, "amendment_used": {"type": "integer", "enum": [0, 1]}, "plan_ref": {"$ref": "#/$defs/planRef"}, "plan_version": {"const": "1.0.0"}, "epoch": {"const": "E0"}, "binding_ref": {"$ref": "#/$defs/ref"}, "input_refs": {"type": "object", "additionalProperties": false, "required": ["spec", "target_profile", "test_bundle"], "properties": {"spec": {"$ref": "#/$defs/ref"}, "target_profile": {"$ref": "#/$defs/ref"}, "test_bundle": {"$ref": "#/$defs/ref"}}}, "plan_sha256": {"$ref": "#/$defs/sha256"}, "workspace_tree": {"$ref": "#/$defs/sha256"},
    "build_result_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "smoke_result_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "test_summary_refs": {"type": "array", "maxItems": 0},
    "changed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}, "accepted": {"const": true}, "migration_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "planRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "version", "revision_seq", "epoch"], "properties": {"path": {"type": "string", "pattern": "^plan/versions/plan-1\\.[0-9]+\\.[0-9]+\\.json$"}, "sha256": {"$ref": "#/$defs/sha256"}, "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}, "revision_seq": {"type": "integer", "minimum": 0}, "epoch": {"type": "string", "pattern": "^E[0-9]+$"}}},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
