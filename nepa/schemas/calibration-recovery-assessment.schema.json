{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-recovery-assessment.schema.json","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","version","attempt","status","model_reports","quality_audit_ref","screening_pass"],"properties":{"schema_version":{"const":"1.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version":{"enum":["r0","r1","r2"]},"attempt":{"type":"integer","minimum":1},"status":{"const":"complete"},"model_reports":{"type":"object","additionalProperties":false,"required":["qwen","deepseek"],"properties":{"qwen":{"$ref":"#/$defs/ref"},"deepseek":{"$ref":"#/$defs/ref"}}},"quality_audit_ref":{"$ref":"#/$defs/ref"},"screening_pass":{"type":"boolean"}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
