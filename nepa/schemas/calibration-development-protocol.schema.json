{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-development-protocol.schema.json","title":"M1-4a2 patch prompt development protocol","type":"object","additionalProperties":false,
  "required":["schema_version","lineage_id","status","model_ids","versions","repair_mode","semantic_depth","base_trial_count","max_revisions","initial_trial_ceiling","config_ref","context_limits_ref","api_key_env","metric_definition","screening","fallback_order","components"],
  "properties":{
    "schema_version":{"const":"2.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"status":{"enum":["initialized","selected","selection-tie","blocked"]},"model_ids":{"const":["qwen","claude","deepseek"]},"versions":{"const":["v0","v1","v2","v3","v4"]},"repair_mode":{"const":"patch"},"semantic_depth":{"const":2},"base_trial_count":{"const":3},"max_revisions":{"const":4},"initial_trial_ceiling":{"const":15},"config_ref":{"$ref":"#/$defs/ref"},"context_limits_ref":{"$ref":"#/$defs/ref"},"api_key_env":{"$ref":"#/$defs/api_keys"},"metric_definition":{"const":"m1-4a1-architecture-calibration-metrics-v1"},
    "screening":{"type":"object","additionalProperties":false,"required":["p2_threshold","max_truncations","require_infrastructure_valid","reference_p1_threshold","reference_relation"],"properties":{"p2_threshold":{"const":0.6},"max_truncations":{"const":0},"require_infrastructure_valid":{"const":true},"reference_p1_threshold":{"const":0.9},"reference_relation":{"const":"strictly_below"}}},
    "fallback_order":{"const":["min_model_p2","min_model_p1","min_model_arch_semantic_first_pass","min_model_schema_after_format_repair","lower_total_cost"]},"components":{"type":"object","additionalProperties":false,"minProperties":1,"patternProperties":{"^[a-z][a-z0-9_]*$":{"$ref":"#/$defs/ref"}}}
  },
  "$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},"api_keys":{"type":"object","additionalProperties":false,"required":["qwen","claude","deepseek"],"properties":{"qwen":{"const":"NEPA_QWEN_API_KEY"},"claude":{"const":"NEPA_CLAUDE_API_KEY"},"deepseek":{"const":"NEPA_DS_API_KEY"}}}}
}
