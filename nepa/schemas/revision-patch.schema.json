{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/revision-patch.schema.json",
  "title": "NePA revision patch v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source", "selected_trigger", "level", "patch_ops", "lineage", "obligation_mappings", "rationale", "expected_effect"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {"type": "object", "additionalProperties": false, "required": ["plan_ref", "revision_seq", "plan_draft_ir_sha256"], "properties": {"plan_ref": {"$ref": "#/$defs/ref"}, "revision_seq": {"type": "integer", "minimum": 0}, "plan_draft_ir_sha256": {"$ref": "#/$defs/sha256"}}},
    "selected_trigger": {"type": "object", "additionalProperties": false, "required": ["event_seq", "code", "signature"], "properties": {"event_seq": {"type": "integer", "minimum": 1}, "code": {"enum": ["TR-1", "TR-2", "TR-3", "TR-4", "TR-6", "TR-7"]}, "signature": {"$ref": "#/$defs/sha256"}}},
    "level": {"enum": ["F2", "F3"]},
    "patch_ops": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/op"}},
    "lineage": {"type": "array", "items": {"$ref": "#/$defs/lineage"}},
    "obligation_mappings": {"type": "array", "items": {"$ref": "#/$defs/obligation"}},
    "rationale": {"type": "string", "minLength": 1}, "expected_effect": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["old_task_uid", "new_task_uids"], "properties": {"old_task_uid": {"$ref": "#/$defs/uid"}, "new_task_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/uid"}}}},
    "obligation": {"type": "object", "additionalProperties": false, "required": ["old_task_uid", "old_obligation", "new_targets", "acceptance_not_weaker"], "properties": {"old_task_uid": {"$ref": "#/$defs/uid"}, "old_obligation": {"type": "string", "minLength": 1}, "new_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["new_task_uid", "new_obligation"], "properties": {"new_task_uid": {"$ref": "#/$defs/uid"}, "new_obligation": {"type": "string", "minLength": 1}}}}, "acceptance_not_weaker": {"const": true}}},
    "contextRef": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["requirement", "message", "type", "interface_file"]}, "id": {"type": "string", "minLength": 1}}},
    "responsibility": {"type": "object", "additionalProperties": false, "required": ["req_id", "role"], "properties": {"req_id": {"type": "string", "minLength": 1}, "role": {"enum": ["primary", "supporting"]}}},
    "taskDraft": {"type": "object", "additionalProperties": false, "required": ["local_id", "title", "goal", "kind", "instructions", "deliverable_files", "context_refs", "requirement_responsibilities", "provides_contracts", "consumes_contracts", "depends_on", "acceptance"], "properties": {"local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "title": {"type": "string", "minLength": 1}, "goal": {"type": "string", "minLength": 1}, "kind": {"enum": ["codec", "state", "logic", "transport", "app", "integration"]}, "instructions": {"type": "string", "minLength": 1}, "deliverable_files": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "context_refs": {"type": "array", "items": {"$ref": "#/$defs/contextRef"}}, "requirement_responsibilities": {"type": "array", "items": {"$ref": "#/$defs/responsibility"}}, "provides_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "consumes_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "acceptance": {"type": "object", "additionalProperties": false, "required": ["build_variant_ids", "tests"], "properties": {"build_variant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "tests": {"const": []}}}}},
    "export": {"type": "object", "additionalProperties": false, "required": ["interface_file", "symbol", "signature"], "properties": {"interface_file": {"type": "string", "minLength": 1}, "symbol": {"type": "string", "minLength": 1}, "signature": {"type": "string", "minLength": 1}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["id", "purpose", "owner", "interface_files", "exports", "ready_gate", "provider", "consumers"], "properties": {"id": {"type": "string"}, "purpose": {"type": "string"}, "owner": {"type": "string"}, "interface_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "exports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/export"}}, "ready_gate": {"enum": ["s5", "task"]}, "provider": {"type": "string"}, "consumers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "fileSlot": {"type": "object", "additionalProperties": false, "required": ["slot_id", "path", "path_pattern", "expand_over", "class", "render_rule", "owner_module", "contract_id", "build_role", "purpose"], "properties": {"slot_id": {"type": "string"}, "path": {"type": ["string", "null"]}, "path_pattern": {"type": ["string", "null"]}, "expand_over": {"enum": ["messages", "types", null]}, "class": {"enum": ["s5_frozen", "s6_owned"]}, "render_rule": {"enum": ["header", "source_stub", "build_file", "doc", "mechanical"]}, "owner_module": {"type": "string"}, "contract_id": {"type": ["string", "null"]}, "build_role": {"enum": ["link_source", "entry_point", "none"]}, "purpose": {"type": "string"}}},
    "workPackage": {"type": "object", "additionalProperties": false, "required": ["id", "title", "goal", "module", "kind", "context_refs", "requirement_responsibilities", "allowed_files", "provides_contracts", "consumes_contracts", "depends_on", "acceptance"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "goal": {"type": "string"}, "module": {"type": "string"}, "kind": {"type": "string"}, "context_refs": {"type": "array", "items": {"$ref": "#/$defs/contextRef"}}, "requirement_responsibilities": {"type": "array", "items": {"$ref": "#/$defs/responsibility"}}, "allowed_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "provides_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "consumes_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "acceptance": {"type": "object", "additionalProperties": false, "required": ["outcome"], "properties": {"outcome": {"type": "string"}}}}},
    "op": {"oneOf": [
      {"$ref": "#/$defs/splitTask"}, {"$ref": "#/$defs/mergeTasks"}, {"$ref": "#/$defs/moveResponsibility"}, {"$ref": "#/$defs/moveFileOwner"}, {"$ref": "#/$defs/rewriteInstructions"}, {"$ref": "#/$defs/insertTask"}, {"$ref": "#/$defs/reorderDependency"},
      {"$ref": "#/$defs/addContract"}, {"$ref": "#/$defs/extendContract"}, {"$ref": "#/$defs/addFileSlot"}, {"$ref": "#/$defs/addWorkPackage"}, {"$ref": "#/$defs/moveFileAcrossWp"}, {"$ref": "#/$defs/retireFileSlot"}, {"$ref": "#/$defs/reAdopt"}
    ]},
    "splitTask": {"type": "object", "additionalProperties": false, "required": ["op", "work_package_id", "source_task_uid", "successors"], "properties": {"op": {"const": "split_task"}, "work_package_id": {"type": "string"}, "source_task_uid": {"$ref": "#/$defs/uid"}, "successors": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/taskDraft"}}}},
    "mergeTasks": {"type": "object", "additionalProperties": false, "required": ["op", "work_package_id", "source_task_uids", "successor"], "properties": {"op": {"const": "merge_tasks"}, "work_package_id": {"type": "string"}, "source_task_uids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/uid"}}, "successor": {"$ref": "#/$defs/taskDraft"}}},
    "moveResponsibility": {"type": "object", "additionalProperties": false, "required": ["op", "work_package_id", "req_id", "role", "from_task_uid", "to_task_uid"], "properties": {"op": {"const": "move_responsibility"}, "work_package_id": {"type": "string"}, "req_id": {"type": "string"}, "role": {"enum": ["primary", "supporting"]}, "from_task_uid": {"$ref": "#/$defs/uid"}, "to_task_uid": {"$ref": "#/$defs/uid"}}},
    "moveFileOwner": {"type": "object", "additionalProperties": false, "required": ["op", "work_package_id", "path", "from_task_uid", "to_task_uid"], "properties": {"op": {"const": "move_file_owner"}, "work_package_id": {"type": "string"}, "path": {"type": "string"}, "from_task_uid": {"$ref": "#/$defs/uid"}, "to_task_uid": {"$ref": "#/$defs/uid"}}},
    "rewriteInstructions": {"type": "object", "additionalProperties": false, "required": ["op", "task_uid", "changes"], "properties": {"op": {"const": "rewrite_instructions"}, "task_uid": {"$ref": "#/$defs/uid"}, "changes": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"goal": {"type": "string", "minLength": 1}, "instructions": {"type": "string", "minLength": 1}, "context_refs": {"type": "array"}}}}},
    "insertTask": {"type": "object", "additionalProperties": false, "required": ["op", "work_package_id", "from_task_uid", "task"], "properties": {"op": {"const": "insert_task"}, "work_package_id": {"type": "string"}, "from_task_uid": {"$ref": "#/$defs/uid"}, "task": {"$ref": "#/$defs/taskDraft"}}},
    "reorderDependency": {"type": "object", "additionalProperties": false, "required": ["op", "work_package_id", "from_task_uid", "to_task_uid", "contract_id"], "properties": {"op": {"const": "reorder_dependency"}, "work_package_id": {"type": "string"}, "from_task_uid": {"$ref": "#/$defs/uid"}, "to_task_uid": {"$ref": "#/$defs/uid"}, "contract_id": {"type": "string"}}},
    "addContract": {"type": "object", "additionalProperties": false, "required": ["op", "contract", "implementation_slot_id", "provider_work_package_id", "consumer_work_package_ids"], "properties": {"op": {"const": "add_contract"}, "contract": {"$ref": "#/$defs/contract"}, "implementation_slot_id": {"type": "string"}, "provider_work_package_id": {"type": "string"}, "consumer_work_package_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "extendContract": {"type": "object", "additionalProperties": false, "required": ["op", "contract_id", "exports", "implementation_slot_ids", "provider_work_package_id", "consumer_work_package_ids"], "properties": {"op": {"const": "extend_contract"}, "contract_id": {"type": "string"}, "exports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/export"}}, "implementation_slot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "provider_work_package_id": {"type": "string"}, "consumer_work_package_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "addFileSlot": {"type": "object", "additionalProperties": false, "required": ["op", "file_slot", "work_package_id", "owner_task_uid", "build_artifact_ids"], "properties": {"op": {"const": "add_file_slot"}, "file_slot": {"$ref": "#/$defs/fileSlot"}, "work_package_id": {"type": "string"}, "owner_task_uid": {"$ref": "#/$defs/uid"}, "build_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "addWorkPackage": {"type": "object", "additionalProperties": false, "required": ["op", "work_package", "tasks"], "properties": {"op": {"const": "add_work_package"}, "work_package": {"$ref": "#/$defs/workPackage"}, "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/taskDraft"}}}},
    "moveFileAcrossWp": {"type": "object", "additionalProperties": false, "required": ["op", "path", "from_work_package_id", "to_work_package_id", "from_task_uid", "to_task_uid", "responsibility_ids", "provider_contract_ids"], "properties": {"op": {"const": "move_file_across_wp"}, "path": {"type": "string"}, "from_work_package_id": {"type": "string"}, "to_work_package_id": {"type": "string"}, "from_task_uid": {"$ref": "#/$defs/uid"}, "to_task_uid": {"$ref": "#/$defs/uid"}, "responsibility_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "provider_contract_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "retireFileSlot": {"type": "object", "additionalProperties": false, "required": ["op", "slot_id", "path", "successor_slot_ids", "successor_obligations", "successor_symbols", "quarantine_path"], "properties": {"op": {"const": "retire_file_slot"}, "slot_id": {"type": "string"}, "path": {"type": "string"}, "successor_slot_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "successor_obligations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "successor_symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "quarantine_path": {"type": "string", "pattern": "^_orphan/E[1-9][0-9]*/.+$"}}},
    "reAdopt": {"type": "object", "additionalProperties": false, "required": ["op", "quarantine_path", "content_sha256", "target_slot", "work_package_id", "owner_task_uid", "revalidation_obligations", "build_artifact_ids"], "properties": {"op": {"const": "re_adopt"}, "quarantine_path": {"type": "string", "pattern": "^_orphan/E[1-9][0-9]*/.+$"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "target_slot": {"$ref": "#/$defs/fileSlot"}, "work_package_id": {"type": "string"}, "owner_task_uid": {"$ref": "#/$defs/uid"}, "revalidation_obligations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "build_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  },
  "allOf": [
    {"if": {"properties": {"level": {"const": "F2"}}}, "then": {"properties": {"patch_ops": {"items": {"oneOf": [{"$ref": "#/$defs/splitTask"}, {"$ref": "#/$defs/mergeTasks"}, {"$ref": "#/$defs/moveResponsibility"}, {"$ref": "#/$defs/moveFileOwner"}, {"$ref": "#/$defs/rewriteInstructions"}, {"$ref": "#/$defs/insertTask"}, {"$ref": "#/$defs/reorderDependency"}]}}}}}
  ]
}
