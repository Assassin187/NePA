{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/epoch-receipt.schema.json",
  "title": "NePA E0 epoch receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "epoch", "materialized_plan_ref", "blueprint_sha256", "checkpoint_commit", "checkpoint_tree", "materialization_status", "build_result_refs", "smoke_result_refs", "pending_group_ids"],
  "properties": {
    "schema_version": {"const": "1.0"}, "epoch": {"const": "E0"}, "materialized_plan_ref": {"$ref": "#/$defs/ref"}, "blueprint_sha256": {"$ref": "#/$defs/sha256"}, "checkpoint_commit": {"$ref": "#/$defs/commit"}, "checkpoint_tree": {"$ref": "#/$defs/commit"}, "materialization_status": {"enum": ["ready", "pending_repair"]}, "build_result_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "smoke_result_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "pending_group_ids": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [{"if": {"properties": {"materialization_status": {"const": "ready"}}}, "then": {"properties": {"pending_group_ids": {"maxItems": 0}}}}],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}}
}
