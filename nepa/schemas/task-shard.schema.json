{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/task-shard.schema.json",
  "title": "NePA task shard",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "work_package_id", "tasks"],
  "properties": {"schema_version": {"const": "1.0"}, "work_package_id": {"$ref": "#/$defs/id"}, "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}},
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["requirement", "message", "type", "interface_file"]}, "id": {"type": "string", "minLength": 1}}},
    "responsibility": {"type": "object", "additionalProperties": false, "required": ["req_id", "role"], "properties": {"req_id": {"type": "string", "minLength": 1}, "role": {"enum": ["primary", "supporting"]}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["build_variant_ids", "tests"], "properties": {"build_variant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "tests": {"const": []}}},
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["local_id", "title", "goal", "kind", "instructions", "deliverable_files", "context_refs", "requirement_responsibilities", "provides_contracts", "consumes_contracts", "depends_on", "acceptance"],
      "properties": {
        "local_id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 1}, "goal": {"type": "string", "minLength": 1},
        "kind": {"enum": ["codec", "state", "logic", "transport", "app", "integration"]}, "instructions": {"type": "string", "minLength": 1},
        "deliverable_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "context_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "requirement_responsibilities": {"type": "array", "items": {"$ref": "#/$defs/responsibility"}},
        "provides_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "consumes_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "acceptance": {"$ref": "#/$defs/acceptance"}
      }
    }
  }
}
