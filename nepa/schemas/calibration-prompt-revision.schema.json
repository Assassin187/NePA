{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-prompt-revision.schema.json","title":"Patch prompt revision","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","version","previous_version","previous_prompt_sha256","new_prompt_sha256","hypothesis","evidence_refs","expected_gates","expected_metrics","unified_diff","stopping_conclusion","protocol_ref","status"],"properties":{"schema_version":{"const":"2.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version":{"enum":["v1","v2","v3","v4"]},"previous_version":{"enum":["v0","v1","v2","v3"]},"previous_prompt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"new_prompt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"hypothesis":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ref"}},"expected_gates":{"type":"array","uniqueItems":true,"items":{"enum":["arch_01","arch_02","arch_03","arch_04","arch_05","arch_06","arch_07","arch_08","arch_09","arch_10","arch_11","arch_12","arch_13","arch_14","arch_15"]}},"expected_metrics":{"type":"array","uniqueItems":true,"items":{"enum":["schema_after_format_repair_rate","p1","p2","arch_semantic_first_pass_rate"]}},"unified_diff":{"type":"string"},"stopping_conclusion":{"type":"string","minLength":1},"protocol_ref":{"$ref":"#/$defs/ref"},"status":{"const":"admitted"}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
