{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/trial-validation.schema.json",
  "title": "NePA Trial Validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lineage_id", "prompt_version", "model_id", "trial_id", "semantic_depth_declared", "attempts", "terminal", "first_passing_depth"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "lineage_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "model_id": {"enum": ["claude", "qwen", "deepseek"]},
    "trial_id": {"type": "string", "pattern": "^trial_[0-9]{3}$"},
    "semantic_depth_declared": {"type": "integer", "minimum": 0, "maximum": 2},
    "attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attempt"}},
    "terminal": {"enum": ["pass", "semantic-fail", "schema-fail", "infrastructure-invalid"]},
    "first_passing_depth": {"type": ["integer", "null"], "minimum": 0, "maximum": 2}
  },
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "nullableRef": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
    "call_metric": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "requested_model", "model", "parameter_support", "tokens_in", "tokens_out", "cost_usd", "transport_attempts", "finish_reason", "truncated"],
      "properties": {
        "provider": {"type": "string", "minLength": 1}, "requested_model": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1},
        "parameter_support": {"type": "object"}, "tokens_in": {"type": "integer", "minimum": 0}, "tokens_out": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}, "transport_attempts": {"type": "integer", "minimum": 1}, "finish_reason": {"type": ["string", "null"]}, "truncated": {"type": "boolean"}
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["depth", "schema_valid", "infrastructure_invalid", "format_repaired", "semantic_verdict", "candidate_ref", "validation_ref", "request_refs", "response_refs", "trace_ref", "call_count", "tokens_in", "tokens_out", "cost_usd", "latency_ms", "finish_reason", "truncated", "model", "parameter_support", "call_metrics", "gate_results", "prompt_sha256", "effective_prompt_sha256"],
      "properties": {
        "depth": {"type": "integer", "minimum": 0, "maximum": 2}, "schema_valid": {"type": "boolean"}, "infrastructure_invalid": {"type": "boolean"}, "format_repaired": {"type": "boolean"},
        "semantic_verdict": {"enum": ["pass", "fail", "not-evaluable"]}, "candidate_ref": {"$ref": "#/$defs/nullableRef"}, "validation_ref": {"$ref": "#/$defs/nullableRef"},
        "request_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "response_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}}, "request_ref": {"$ref": "#/$defs/nullableRef"}, "response_ref": {"$ref": "#/$defs/nullableRef"}, "trace_ref": {"$ref": "#/$defs/nullableRef"},
        "call_count": {"type": "integer", "minimum": 1}, "tokens_in": {"type": "integer", "minimum": 0}, "tokens_out": {"type": "integer", "minimum": 0}, "cost_usd": {"type": "number", "minimum": 0}, "latency_ms": {"type": "integer", "minimum": 0},
        "finish_reason": {"type": ["string", "null"]}, "truncated": {"type": "boolean"}, "model": {"type": "string", "minLength": 1}, "parameter_support": {"type": "object"},
        "call_metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/call_metric"}}, "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "effective_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gate_results": {"type": "object", "additionalProperties": false, "patternProperties": {"^arch_(0[1-9]|10)$": {"enum": ["pass", "fail"]}}, "unevaluatedProperties": false}
      }
    }
  }
}
