{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-prompt-revision-bundle.schema.json","title":"M1-4a2 prompt bundle revision","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","version","previous_version","previous_bundle_ref","new_bundle_ref","hypothesis","evidence_refs","expected_gates","expected_metrics","changed_stage","unified_diff","stopping_conclusion","protocol_ref","status"],"properties":{"schema_version":{"const":"3.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version":{"enum":["v1","v2","v3","v4"]},"previous_version":{"enum":["v0","v1","v2","v3"]},"previous_bundle_ref":{"$ref":"#/$defs/ref"},"new_bundle_ref":{"$ref":"#/$defs/ref"},"hypothesis":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ref"}},"expected_gates":{"type":"array","uniqueItems":true},"expected_metrics":{"type":"array","uniqueItems":true},"changed_stage":{"enum":["initial","repair"]},"unified_diff":{"type":"string"},"stopping_conclusion":{"type":"string","minLength":1},"protocol_ref":{"$ref":"#/$defs/ref"},"status":{"const":"admitted"}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
