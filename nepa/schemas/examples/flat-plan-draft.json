{
  "schema_version": "1.0",
  "architecture": {
    "decisions": [
      {
        "id": "separate-core-transport",
        "topic": "Protocol and transport separation",
        "statement": "Keep deterministic message processing separate from connection lifecycle handling.",
        "context_refs": [
          {
            "kind": "interface_file",
            "id": "include/proto/core_transport.h"
          }
        ]
      }
    ],
    "assumptions": [
      {
        "id": "bounded-input-storage",
        "statement": "Use the Target Profile resource limit for bounded connection storage.",
        "rationale": "The injected delivery constraint provides an explicit maximum and exhaustion policy.",
        "context_refs": []
      }
    ],
    "contracts": [
      {
        "id": "build-system",
        "kind": "external",
        "purpose": "Build every required variant.",
        "owner": "s5",
        "interface_files": [
          "Makefile"
        ],
        "ready_gate": "s5"
      },
      {
        "id": "codec-cli",
        "kind": "external",
        "purpose": "Expose message encoding and decoding to black-box tests.",
        "owner": "codec",
        "interface_files": [
          "include/proto/codec.h",
          "apps/codec_cli.c"
        ],
        "ready_gate": "task",
        "provider_work_package_id": "wp-codec"
      },
      {
        "id": "client-cli",
        "kind": "external",
        "purpose": "Expose the selected client command-line delivery.",
        "owner": "client",
        "interface_files": [
          "apps/client_app.c"
        ],
        "ready_gate": "task",
        "provider_work_package_id": "wp-client"
      },
      {
        "id": "core-transport",
        "kind": "internal",
        "purpose": "Connect protocol processing to transport lifecycle events.",
        "owner": "transport",
        "interface_files": [
          "include/proto/core_transport.h"
        ],
        "ready_gate": "task",
        "provider_work_package_id": "wp-transport"
      },
      {
        "id": "server-process",
        "kind": "external",
        "purpose": "Expose the foreground server process.",
        "owner": "server",
        "interface_files": [
          "apps/server_app.c"
        ],
        "ready_gate": "task",
        "provider_work_package_id": "wp-server"
      }
    ],
    "modules": [
      {
        "id": "codec",
        "name": "Codec",
        "purpose": "Translate between structured messages and wire bytes.",
        "responsibilities": [
          "Implement the selected message framing and field encodings."
        ],
        "non_goals": [
          "Do not perform network I/O."
        ],
        "owns_files": [
          "src/codec/codec_connect.c",
          "apps/codec_cli.c"
        ],
        "provides_contracts": [
          "codec-cli"
        ],
        "consumes_contracts": []
      },
      {
        "id": "client",
        "name": "Client application",
        "purpose": "Expose the selected client delivery through its public command contract.",
        "responsibilities": [
          "Compose the public codec with the selected client operation."
        ],
        "non_goals": [
          "Do not implement server-side connection lifecycle."
        ],
        "owns_files": [
          "apps/client_app.c"
        ],
        "provides_contracts": [
          "client-cli"
        ],
        "consumes_contracts": [
          "codec-cli"
        ]
      },
      {
        "id": "transport",
        "name": "Transport",
        "purpose": "Manage bounded connection lifecycle and byte movement.",
        "responsibilities": [
          "Provide the required connection event boundary."
        ],
        "non_goals": [
          "Do not define protocol state transitions."
        ],
        "owns_files": [
          "include/proto/core_transport.h",
          "src/net.c"
        ],
        "provides_contracts": [
          "core-transport"
        ],
        "consumes_contracts": []
      },
      {
        "id": "server",
        "name": "Server application",
        "purpose": "Compose protocol processing and transport into the selected server delivery.",
        "responsibilities": [
          "Expose the frozen server process contract."
        ],
        "non_goals": [],
        "owns_files": [
          "apps/server_app.c"
        ],
        "provides_contracts": [
          "server-process"
        ],
        "consumes_contracts": [
          "codec-cli",
          "core-transport"
        ]
      }
    ]
  },
