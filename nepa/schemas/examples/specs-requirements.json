{
  "schema_version": "3.0",
  "protocol": {
    "name": "MQTT",
    "version": "3.1.1",
    "roles": ["client", "broker"]
  },
  "transport": {
    "name": "TCP",
    "default_port": 1883,
    "byte_order": "big_endian",
    "req_ids": ["REQ-TRANSPORT-001"]
  },
  "types": [
    {
      "id": "mqtt_varint",
      "name": "MQTT Variable Byte Integer",
      "encoding": {
        "kind": "varint",
        "max_bytes": 4,
        "data_bits": 7,
        "continuation_bit": 7
      },
      "constraints": [{"max": 268435455}],
      "req_ids": ["REQ-FRAME-001"]
    },
    {
      "id": "mqtt_subscription_entry",
      "name": "MQTT subscription entry",
      "encoding": {
        "kind": "sequence",
        "members": [
          {"name": "topic_filter", "type": "mqtt_utf8_string"},
          {"name": "requested_qos", "type": "uint8", "constraint": {"enum": [0, 1, 2]}}
        ]
      },
      "req_ids": ["REQ-SUBSCRIBE-001"]
    },
    {
      "id": "mqtt_subscription_list",
      "name": "MQTT subscription entries",
      "encoding": {
        "kind": "repeat",
        "item_type": "mqtt_subscription_entry",
        "min_items": 1
      },
      "req_ids": ["REQ-SUBSCRIBE-001"]
    },
    {
      "id": "mqtt_utf8_string",
      "name": "MQTT UTF-8 encoded string",
      "encoding": {
        "kind": "length_prefixed_string",
        "length_type": "uint16_be",
        "charset": "utf-8"
      },
      "constraints": [{"max_len": 65535}],
      "req_ids": ["REQ-STRING-001"]
    }
  ],
  "messages": [
    {
      "id": "connect",
      "name": "CONNECT",
      "senders": ["client"],
      "receivers": ["broker"],
      "wire_layout": ["fixed_header", "variable_header", "payload"],
      "fields": [
        {
          "name": "packet_type",
          "loc": "fixed_header",
          "type": "bitfield8",
          "bits": [
            {"name": "type", "offset": 4, "width": 4, "constraint": {"const": 1}},
            {"name": "flags", "offset": 0, "width": 4, "constraint": {"const": 0}}
          ],
          "req_ids": ["REQ-FRAME-002"]
        },
        {
          "name": "remaining_length",
          "loc": "fixed_header",
          "type": "mqtt_varint",
          "derived": {
            "kind": "length_of",
            "of": ["variable_header", "payload"]
          },
          "req_ids": ["REQ-FRAME-001"]
        },
        {
          "name": "protocol_level",
          "loc": "variable_header",
          "type": "uint8",
          "constraint": {"const": 4},
          "req_ids": ["REQ-CONNECT-002"]
        }
      ],
      "req_ids": ["REQ-CONNECT-002"]
    }
  ],
  "requirements": [
    {
      "id": "REQ-TRANSPORT-001",
      "text": "MQTT uses an ordered, lossless, bidirectional transport; TCP port 1883 is registered for MQTT.",
      "level": "DEFINITION",
      "source_ref": {
        "section": "4.2 Network Connections",
        "quote": "TCP/IP port 1883 is registered with IANA for use with MQTT."
      }
    },
    {
      "id": "REQ-FRAME-001",
      "text": "Remaining Length uses MQTT variable-byte encoding and equals the bytes after the fixed header.",
      "level": "DEFINITION",
      "source_ref": {
        "section": "2.2.3 Remaining Length",
        "quote": "The Remaining Length is encoded using a variable length encoding scheme."
      }
    },
    {
      "id": "REQ-FRAME-002",
      "text": "CONNECT has Control Packet type 1 and reserved flags 0000.",
      "level": "DEFINITION",
      "source_ref": {
        "section": "2.2.2 MQTT Control Packet type",
        "quote": "CONNECT 1 Client to Server Client request to connect to Server"
      }
    },
    {
      "id": "REQ-STRING-001",
      "text": "An MQTT UTF-8 string has a two-byte big-endian length prefix followed by UTF-8 data.",
      "level": "DEFINITION",
      "source_ref": {
        "section": "1.5.4 UTF-8 encoded strings",
        "quote": "The character data MUST be well-formed UTF-8 as defined by the Unicode specification."
      }
    },
    {
      "id": "REQ-SUBSCRIBE-001",
      "text": "A SUBSCRIBE payload contains one or more Topic Filter and requested QoS pairs.",
      "level": "MUST",
      "source_ref": {
        "section": "3.8.3 SUBSCRIBE Payload",
        "quote": "The Payload MUST contain at least one Topic Filter and Subscription QoS pair."
      }
    },
    {
      "id": "REQ-CONNECT-002",
      "text": "If protocol_level is not 4, the server MUST send CONNACK return code 1 and then disconnect.",
      "level": "MUST",
      "source_ref": {
        "section": "3.1.2.2 Protocol Level",
        "quote": "The Server MUST respond to the CONNECT Packet with a CONNACK return code 0x01 and then disconnect the Client."
      }
    }
  ]
}
