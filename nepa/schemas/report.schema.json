        "configuration_changes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "schema_version": {
          "const": "5.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "input_verification_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "config_sha256": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "anyOf": [
