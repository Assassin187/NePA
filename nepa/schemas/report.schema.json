{
  "type": "object",
  "properties": {
    "configuration_changes": {"type": "array", "items": {"type": "object"}},
    "schema_version": {
      "const": "3.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string"
    },
    "exit_code": {
      "type": "integer"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "input_verification_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "config_sha256": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "sandbox_image": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "pending",
              "running",
              "passed",
              "failed"
            ]
          },
          "sessions": {
            "type": "integer",
            "minimum": 0
          },
          "decisions": {
            "type": "integer",
            "minimum": 0
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "implemented",
                    "already_present",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "code_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "id",
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "checkpoint": {
            "type": "string",
            "minLength": 1
          },
          "last_feedback": {
            "type": "object"
          }
        },
        "required": [
          "status",
          "sessions",
          "decisions",
          "claims",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "primary_task": {
            "type": "string",
            "minLength": 1
          },
          "agent_claim": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "verification_scope": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "primary_task",
          "agent_claim",
          "verification_scope"
        ],
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "cost_usd",
        "tokens_in",
        "tokens_out",
        "calls"
      ],
      "additionalProperties": false
    },
    "unknown_calls": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "cache_hits": {
      "const": 0
    },
    "final_checks": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "delivery": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "checkpoint": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "files",
            "checkpoint"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "status",
    "exit_code",
    "reason",
    "inputs",
    "input_verification_error",
    "config_sha256",
    "runtime",
    "sandbox_image",
    "plan",
    "tasks",
    "requirements",
    "budget",
    "unknown_calls",
    "cache_hits",
    "final_checks",
    "delivery",
    "limitations",
    "reproduction"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
