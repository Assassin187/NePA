                  "reason": {
                    "type": "string"
                  },
                  "scenarios": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "check_id",
                        "variant",
                        "required",
                        "status",
                        "returncode",
                        "evidence"
