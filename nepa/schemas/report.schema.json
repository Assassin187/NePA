{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NePA evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_availability", "termination_kind", "outcome", "termination_reason", "summary", "req_coverage", "test_final", "process", "assumptions", "known_defects", "reproduction"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_availability": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/artifactStatus"}
    },
    "termination_kind": {"enum": ["completed", "controlled_exit"]},
    "outcome": {"enum": ["success", "degraded", "failed"]},
    "termination_reason": {"$ref": "#/$defs/reason"},
    "summary": {"type": "string", "minLength": 1},
    "req_coverage": {"$ref": "#/$defs/availability"},
    "test_final": {"$ref": "#/$defs/availability"},
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_durations", "model_usage", "repair_rounds", "convergence"],
      "properties": {
        "stage_durations": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "model_usage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "model", "tokens_in", "tokens_out", "cost_usd"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "tokens_in": {"type": "integer", "minimum": 0},
              "tokens_out": {"type": "integer", "minimum": 0},
              "cost_usd": {"type": "number", "minimum": 0}
            }
          }
        },
        "repair_rounds": {"type": "integer", "minimum": 0},
        "convergence": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "assumptions": {"$ref": "#/$defs/availability"},
    "known_defects": {"$ref": "#/$defs/availability"},
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_snapshot_sha256"],
      "properties": {
        "config_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "delivery_blueprint_sha256": {"$ref": "#/$defs/sha256"},
        "git_commit": {"type": "string", "minLength": 1},
        "model_versions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "artifactStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "invalid", "unavailable", "not_run"]},
        "evidence": {"$ref": "#/$defs/ref"},
        "reason": {"$ref": "#/$defs/reason"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "available"}}},
          "then": {"not": {"required": ["reason"]}},
          "else": {"required": ["reason"]}
        }
      ]
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": {"enum": ["available", "invalid", "unavailable", "not_run"]},
        "value": {},
        "reason": {"$ref": "#/$defs/reason"}
      },
      "oneOf": [
        {
          "properties": {
            "status": {"const": "available"},
            "value": {"not": {"type": "null"}}
          },
          "not": {"required": ["reason"]}
        },
        {
          "properties": {
            "status": {"enum": ["invalid", "unavailable", "not_run"]},
            "value": {"type": "null"}
          },
          "required": ["reason"]
        }
      ]
    }
  }
}
