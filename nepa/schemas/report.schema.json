              },
              "verification": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason",
                  "scenarios"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "scenarios_passed",
                      "failed",
                      "incomplete",
                      "unverified"
