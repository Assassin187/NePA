              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "tasks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "running",
                  "passed",
                  "failed"
