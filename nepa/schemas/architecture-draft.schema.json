{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/architecture-draft.schema.json",
  "title": "NePA Architecture Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decisions", "assumptions", "contracts", "modules", "work_packages", "layout"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}},
    "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}},
    "work_packages": {"type": "array", "items": {"$ref": "#/$defs/workPackage"}},
    "layout": {"$ref": "#/$defs/layout"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "contextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["requirement", "message", "type", "interface_file"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "files", "build_graph"],
      "properties": {
        "roots": {"$ref": "#/$defs/roots"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layoutFile"}},
        "build_graph": {"$ref": "#/$defs/buildGraph"}
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "source", "app", "build"],
      "properties": {
        "include": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "app": {"type": "string", "minLength": 1},
        "build": {"type": "string", "minLength": 1}
      }
    },
    "layoutFileBase": {
      "type": "object",
      "required": ["slot_id", "class", "render_rule", "owner_module", "contract_id", "build_role", "purpose"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/id"},
        "class": {"enum": ["s5_frozen", "s6_owned"]},
        "render_rule": {"enum": ["header", "source_stub", "build_file", "doc", "mechanical"]},
        "owner_module": {"$ref": "#/$defs/id"},
        "contract_id": {"type": ["string", "null"]},
        "build_role": {"enum": ["link_source", "entry_point", "none"]},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "layoutFile": {
      "unevaluatedProperties": false,
      "oneOf": [
        {
          "allOf": [
            {"$ref": "#/$defs/layoutFileBase"},
            {"type": "object", "required": ["path", "path_pattern", "expand_over"], "properties": {"path": {"type": "string", "minLength": 1, "pattern": "^(?:[^{}])*$"}, "path_pattern": {"type": "null"}, "expand_over": {"type": "null"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/layoutFileBase"},
            {"type": "object", "required": ["path", "path_pattern", "expand_over"], "properties": {"path": {"type": "null"}, "path_pattern": {"type": "string", "pattern": "^(?=[^{}]*\\{message_id\\}[^{}]*$)(?:[^{}]|\\{message_id\\})*$"}, "expand_over": {"const": "messages"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/layoutFileBase"},
            {"type": "object", "required": ["path", "path_pattern", "expand_over"], "properties": {"path": {"type": "null"}, "path_pattern": {"type": "string", "pattern": "^(?=[^{}]*\\{type_id\\}[^{}]*$)(?:[^{}]|\\{type_id\\})*$"}, "expand_over": {"const": "types"}}}
          ]
        }
      ],
      "allOf": [
        {"if": {"properties": {"render_rule": {"const": "header"}}}, "then": {"properties": {"contract_id": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"render_rule": {"enum": ["build_file", "doc"]}}}, "then": {"properties": {"contract_id": {"type": "null"}}}},
        {"if": {"properties": {"render_rule": {"const": "source_stub"}}}, "then": {"properties": {"class": {"const": "s6_owned"}}}},
        {"if": {"properties": {"render_rule": {"enum": ["header", "build_file", "doc", "mechanical"]}}}, "then": {"properties": {"class": {"const": "s5_frozen"}}}}
      ]
    },
    "buildGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {"artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}}
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "output_path", "entry_file_slot", "link_source_slots"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "output_path": {"type": "string", "minLength": 1},
        "entry_file_slot": {"$ref": "#/$defs/id"},
        "link_source_slots": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "statement", "context_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "topic": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "context_refs": {"type": "array", "items": {"$ref": "#/$defs/contextRef"}}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "owner", "interface_files", "ready_gate", "provider", "consumers"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "purpose": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "interface_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "ready_gate": {"enum": ["s5", "task"]},
        "provider": {"type": "string", "minLength": 1},
        "consumers": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose", "responsibilities", "non_goals", "owns_files", "provides_contracts", "consumes_contracts"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "responsibilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "owns_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "provides_contracts": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "consumes_contracts": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
      }
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["req_id", "role"],
      "properties": {
        "req_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["primary", "supporting"]}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {"outcome": {"type": "string", "minLength": 1}}
    },
    "workPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "goal", "module", "kind", "context_refs", "requirement_responsibilities", "allowed_files", "provides_contracts", "consumes_contracts", "depends_on", "acceptance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "module": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "context_refs": {"type": "array", "items": {"$ref": "#/$defs/contextRef"}},
        "requirement_responsibilities": {"type": "array", "items": {"$ref": "#/$defs/responsibility"}},
        "allowed_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "provides_contracts": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "consumes_contracts": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "depends_on": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "acceptance": {"$ref": "#/$defs/acceptance"}
      }
    }
  }
}
