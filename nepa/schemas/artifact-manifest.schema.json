{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/artifact-manifest.schema.json","title":"NePA E0 artifact manifest v2","type":"object","additionalProperties":false,
  "required":["schema_version","plan_version","plan_sha256","delivery_blueprint_sha256","epoch","files","delivery_graph","exports"],
  "properties":{"schema_version":{"const":"2.0"},"plan_version":{"type":"string","pattern":"^1\\.[0-9]+\\.[0-9]+$"},"plan_sha256":{"$ref":"#/$defs/sha256"},"delivery_blueprint_sha256":{"$ref":"#/$defs/sha256"},"epoch":{"type":"string","pattern":"^E[0-9]+$"},"files":{"type":"array","items":{"$ref":"#/$defs/file"}},"delivery_graph":{"$ref":"#/$defs/graph"},"exports":{"type":"array","items":{"$ref":"#/$defs/export"}}},
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"strings":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "file":{"type":"object","additionalProperties":false,"required":["rule_id","path","kind","sha256","created_by_stage","mutability","owner_task_id","build_variant_ids"],"properties":{"rule_id":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"kind":{"enum":["app","source","header","build","documentation"]},"sha256":{"$ref":"#/$defs/sha256"},"created_by_stage":{"const":"s5"},"mutability":{"enum":["s5_frozen","s6_owned"]},"owner_task_id":{"type":["string","null"],"pattern":"^T-[0-9]{3}$"},"build_variant_ids":{"$ref":"#/$defs/strings"}},"allOf":[{"if":{"properties":{"mutability":{"const":"s6_owned"}}},"then":{"properties":{"owner_task_id":{"type":"string"}}}},{"if":{"properties":{"mutability":{"const":"s5_frozen"}}},"then":{"properties":{"owner_task_id":{"type":"null"}}}}]},
    "deliverable":{"type":"object","additionalProperties":false,"required":["id","title","kind","purpose"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"kind":{"type":"string"},"purpose":{"type":"string"}}},
    "artifact":{"type":"object","additionalProperties":false,"required":["id","deliverable_id","link_source_set_id","path","build_variant_ids","entry_file_slot"],"properties":{"id":{"type":"string"},"deliverable_id":{"type":"string"},"link_source_set_id":{"type":"string"},"path":{"type":"string"},"build_variant_ids":{"$ref":"#/$defs/strings"},"entry_file_slot":{"type":"string"}}},
    "sourceSet":{"type":"object","additionalProperties":false,"required":["id","file_rule_ids"],"properties":{"id":{"type":"string"},"file_rule_ids":{"$ref":"#/$defs/strings"}}},
    "graph":{"type":"object","additionalProperties":false,"required":["deliverables","build_artifacts","link_source_sets"],"properties":{"deliverables":{"type":"array","items":{"$ref":"#/$defs/deliverable"}},"build_artifacts":{"type":"array","items":{"$ref":"#/$defs/artifact"}},"link_source_sets":{"type":"array","items":{"$ref":"#/$defs/sourceSet"}}}},
    "export":{"type":"object","additionalProperties":false,"required":["contract_id","symbol","signature","interface_file","kind","implementation_file"],"properties":{"contract_id":{"type":"string","minLength":1},"symbol":{"type":"string","minLength":1},"signature":{"type":"string","minLength":1},"interface_file":{"type":"string","minLength":1},"kind":{"enum":["function","type","constant"]},"implementation_file":{"type":["string","null"]}}}
  }
}
