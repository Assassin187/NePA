{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/artifact-manifest.schema.json",
  "title": "NePA S5 Artifact Manifest v1.0",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0" },
    "delivery_blueprint_sha256": { "$ref": "#/$defs/sha256" },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    },
    "build_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/build_artifact" }
    }
  },
  "required": [
    "schema_version",
    "delivery_blueprint_sha256",
    "files",
    "build_artifacts"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "nullable_task": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^T-[0-9]{3,}$" }
      ]
    },
    "file": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "rule_id": { "$ref": "#/$defs/id" },
        "path": { "$ref": "#/$defs/path" },
        "kind": {
          "enum": [
            "build",
            "documentation",
            "public_header",
            "internal_header",
            "source",
            "app"
          ]
        },
        "created_by_stage": { "const": "s5" },
        "mutability": { "enum": ["s5_frozen", "s6_owned"] },
        "owner_task_id": { "$ref": "#/$defs/nullable_task" },
        "producer": {
          "enum": [
            "target_template",
            "language_template",
            "mechanical_spec",
            "stub"
          ]
        }
      },
      "required": [
        "id",
        "rule_id",
        "path",
        "kind",
        "created_by_stage",
        "mutability",
        "owner_task_id",
        "producer"
      ],
      "additionalProperties": false
    },
    "build_artifact": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "deliverable_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["executable", "static_library", "shared_library"] },
        "path": { "$ref": "#/$defs/path" },
        "link_source_set_id": { "$ref": "#/$defs/id" },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "build_variant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "required": [
        "id",
        "deliverable_id",
        "kind",
        "path",
        "link_source_set_id",
        "source_paths",
        "build_variant_ids"
      ],
      "additionalProperties": false
    }
  }
}
