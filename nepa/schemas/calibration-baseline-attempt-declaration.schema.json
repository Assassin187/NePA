{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-baseline-attempt-declaration.schema.json","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","version","attempt","status","bundle_ref","trial_count","semantic_depth","repair_mode","model_slot","initial_trial_ids"],"properties":{"schema_version":{"const":"4.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version":{"enum":["v0","v1","v2"]},"attempt":{"type":"integer","minimum":1},"status":{"const":"declared"},"bundle_ref":{"$ref":"#/$defs/ref"},"trial_count":{"const":3},"semantic_depth":{"const":2},"repair_mode":{"const":"patch"},"model_slot":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"initial_trial_ids":{"const":["trial_001","trial_002","trial_003"]},"retry":{"type":"object","additionalProperties":false,"required":["authorization","reason","parent_assessment_ref","trial_ids"],"properties":{"authorization":{"const":"explicit_user_authorization"},"reason":{"type":"string","minLength":1},"parent_assessment_ref":{"$ref":"#/$defs/ref"},"trial_ids":{"const":["trial_001","trial_002","trial_003"]}}}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
