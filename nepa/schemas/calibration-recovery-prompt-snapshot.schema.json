{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/calibration-recovery-prompt-snapshot.schema.json","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","version","prompt_ref","prompt_sha256","source_sha256","provider_render_sha256"],"properties":{"schema_version":{"const":"1.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"version":{"enum":["r0","r1","r2"]},"prompt_ref":{"$ref":"#/$defs/ref"},"prompt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"provider_render_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
