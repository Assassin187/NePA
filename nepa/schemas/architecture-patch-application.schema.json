{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/architecture-patch-application.schema.json",
  "title": "NePA Architecture patch application evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "patch_ref", "applied", "before_sha256", "model_operations", "derived_operations", "projection"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "patch_ref": {"$ref": "#/$defs/ref"},
    "applied": {"type": "boolean"},
    "rejection_reason": {"type": ["string", "null"]},
    "before_sha256": {"$ref": "#/$defs/hash"},
    "after_sha256": {"$ref": "#/$defs/hash"},
    "model_operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "derived_operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
    "projection": {"$ref": "#/$defs/projection"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}
    },
    "operation": {
      "type": "object", "additionalProperties": false, "required": ["op", "path", "expected_presence"],
      "properties": {
        "op": {"enum": ["add", "replace", "remove"]},
        "path": {"type": "string", "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])*)*$"},
        "expected_presence": {"enum": ["absent", "present"]},
        "value": {}
      },
      "allOf": [
        {"if": {"properties": {"op": {"enum": ["add", "replace"]}}}, "then": {"required": ["value"]}},
        {"if": {"properties": {"op": {"const": "remove"}}}, "then": {"properties": {"expected_presence": {"const": "present"}}}}
      ]
    },
    "mapping": {
      "type": "object", "additionalProperties": false, "required": ["old", "new"],
      "properties": {"old": {"type": "string", "minLength": 1}, "new": {"type": "string", "minLength": 1}}
    },
    "slot_mapping": {
      "type": "object", "additionalProperties": false, "required": ["slot_id", "expand_over", "pairs"],
      "properties": {
        "slot_id": {"type": "string", "minLength": 1},
        "expand_over": {"type": ["string", "null"]},
        "pairs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["path", "replaced"],
      "properties": {"path": {"type": "string", "minLength": 1}, "replaced": {"type": "array", "items": {"$ref": "#/$defs/mapping"}}}
    },
    "projection": {
      "type": "object", "additionalProperties": false, "required": ["policy_version", "mappings", "derived_paths"],
      "properties": {
        "policy_version": {"const": "m1-4a2-coupled-layout-projection-v1"},
        "mappings": {"type": "array", "items": {"$ref": "#/$defs/slot_mapping"}},
        "derived_paths": {"type": "array", "items": {"type": "string", "minLength": 2}},
        "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
      }
    }
  }
}
