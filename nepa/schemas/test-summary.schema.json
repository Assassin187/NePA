{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/test-summary.schema.json",
  "title": "NePA test_results/round_NNN/summary.json v1.0",
  "description": "设计文档 5.4：测试轮次摘要——轮次号、触发者（S6 任务/S7 全量/S8 回归）、构建配置、每用例结果、按需求聚合的通过矩阵。5.4 为散文描述，字段命名为合理设计；构建记录同时服务 9.1.4 的 build_ok。",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0" },
    "round": {
      "description": "轮次号 NNN，与目录名一致",
      "type": "integer",
      "minimum": 1
    },
    "trigger": {
      "description": "触发者：S6 任务 / S7 全量 / S8 回归",
      "enum": ["s6_task", "s7_full", "s8_regression"]
    },
    "task_id": {
      "description": "trigger 为 s6_task 时必填：触发本轮的任务",
      "type": "string",
      "pattern": "^T-[0-9]{3}$"
    },
    "build": {
      "description": "构建配置与结果：release 即 make，san 即 make SAN=1（7.4）",
      "type": "object",
      "properties": {
        "release": { "$ref": "#/$defs/build_result" },
        "san": { "$ref": "#/$defs/build_result" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "cases": {
      "description": "每用例结果：pass/fail/error(/skipped) + 耗时 + 失败输出摘录",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case_result" }
    },
    "req_matrix": {
      "description": "按需求聚合的通过矩阵",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "req_id": { "type": "string", "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$" },
          "tests": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "passed": {
            "description": "关联测试全部 pass 才为 true（9.1.4 口径）",
            "type": "boolean"
          }
        },
        "required": ["req_id", "tests", "passed"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "round", "trigger", "build", "cases", "req_matrix"],
  "if": {
    "properties": { "trigger": { "const": "s6_task" } },
    "required": ["trigger"]
  },
  "then": { "required": ["task_id"] },
  "additionalProperties": false,
  "$defs": {
    "build_result": {
      "type": "object",
      "properties": {
        "ok": {
          "description": "零警告零错误才为 true（9.1.4 build_ok 口径）",
          "type": "boolean"
        },
        "warnings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "output_excerpt": { "type": "string" }
      },
      "required": ["ok"],
      "additionalProperties": false
    },
    "case_result": {
      "type": "object",
      "properties": {
        "nodeid": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["l0", "l1", "l2", "l3"] },
        "result": { "enum": ["pass", "fail", "error", "skipped"] },
        "duration_ms": { "type": "number", "minimum": 0 },
        "failure_excerpt": {
          "description": "失败输出摘录；fail/error 时必填",
          "type": "string",
          "minLength": 1
        },
        "req_ids": {
          "description": "该用例 @pytest.mark.req 标注（5.3 规则 2）",
          "type": "array",
          "items": { "type": "string", "pattern": "^REQ-[A-Z0-9]+-[0-9]{3}$" }
        }
      },
      "required": ["nodeid", "result", "duration_ms"],
      "if": {
        "properties": { "result": { "enum": ["fail", "error"] } },
        "required": ["result"]
      },
      "then": { "required": ["failure_excerpt"] },
      "additionalProperties": false
    }
  }
}
