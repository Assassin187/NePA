{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NePA test round summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "round_id", "trigger", "workspace_head", "workspace_tree", "parent_round_id", "build_config", "build_results", "cases", "req_matrix", "plan_sha256", "delivery_blueprint_sha256", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "round_id": {"type": "string", "minLength": 1},
    "trigger": {"enum": ["s5_scaffold", "s6_task", "s7_full", "s8_cluster", "s8_regression"]},
    "task_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "repair_id": {"type": "string", "minLength": 1},
    "workspace_head": {"type": "string", "minLength": 1},
    "workspace_tree": {"type": "string", "minLength": 1},
    "parent_round_id": {"type": ["string", "null"]},
    "build_config": {"type": "object"},
    "build_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/buildResult"}
    },
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    },
    "req_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["req_id", "nodeids", "result"],
        "properties": {
          "req_id": {"type": "string", "minLength": 1},
          "nodeids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "result": {"enum": ["pass", "fail", "error", "skipped"]}
        }
      }
    },
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "delivery_blueprint_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "bundle_tree_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"trigger": {"const": "s6_task"}}},
      "then": {
        "required": ["task_id", "attempt"],
        "not": {"required": ["repair_id"]}
      },
      "else": {
        "if": {"properties": {"trigger": {"enum": ["s8_cluster", "s8_regression"]}}},
        "then": {
          "required": ["repair_id"],
          "not": {"anyOf": [{"required": ["task_id"]}, {"required": ["attempt"]}]}
        },
        "else": {
          "not": {"anyOf": [{"required": ["task_id"]}, {"required": ["attempt"]}, {"required": ["repair_id"]}]}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "buildResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "result", "warnings", "errors"],
      "properties": {
        "variant_id": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "error"]},
        "warnings": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "failure_excerpt": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "pass"}}},
          "then": {
            "properties": {"warnings": {"const": 0}, "errors": {"const": 0}},
            "not": {"required": ["failure_excerpt"]}
          },
          "else": {"required": ["failure_excerpt"]}
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeid", "req_ids", "result", "duration_ms"],
      "properties": {
        "nodeid": {"type": "string", "minLength": 1},
        "req_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "result": {"enum": ["pass", "fail", "error", "skipped"]},
        "duration_ms": {"type": "number", "minimum": 0},
        "failure_excerpt": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "pass"}}},
          "then": {"not": {"required": ["failure_excerpt"]}},
          "else": {"required": ["failure_excerpt"]}
        }
      ]
    }
  }
}
