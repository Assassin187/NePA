{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.dev/schemas/test-summary.schema.json",
  "title": "NePA test_results/round_NNN/summary.json v2.0",
  "description": "设计文档 5.4：测试轮次摘要、冻结输入哈希、构建结果、用例结果与需求矩阵。",
  "type": "object",
  "properties": {
    "schema_version": { "const": "2.0" },
    "round_id": { "type": "integer", "minimum": 1 },
    "trigger": {
      "enum": ["s5_scaffold", "s6_task", "s7_full", "s8_cluster", "s8_regression"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9]{3,}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "repair_id": {
      "type": "string",
      "pattern": "^R-[0-9]{3,}$"
    },
    "workspace_head": { "$ref": "#/$defs/git_oid" },
    "workspace_tree": { "$ref": "#/$defs/git_oid" },
    "parent_round_id": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "delivery_blueprint_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "bundle_tree_sha256": { "$ref": "#/$defs/sha256" },
    "build_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/build_result" }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case_result" }
    },
    "req_matrix": {
      "type": "array",
      "items": { "$ref": "#/$defs/req_result" }
    }
  },
  "required": [
    "schema_version",
    "round_id",
    "trigger",
    "workspace_head",
    "workspace_tree",
    "parent_round_id",
    "plan_sha256",
    "delivery_blueprint_sha256",
    "manifest_sha256",
    "bundle_tree_sha256",
    "build_results",
    "cases",
    "req_matrix"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "trigger": { "const": "s6_task" } },
        "required": ["trigger"]
      },
      "then": {
        "required": ["task_id", "attempt"],
        "not": { "required": ["repair_id"] }
      },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["task_id"] },
            { "required": ["attempt"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "trigger": { "enum": ["s8_cluster", "s8_regression"] }
        },
        "required": ["trigger"]
      },
      "then": { "required": ["repair_id"] },
      "else": { "not": { "required": ["repair_id"] } }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "reason_excerpt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "build_result": {
      "type": "object",
      "properties": {
        "variant_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "result": { "enum": ["pass", "fail", "error"] },
        "duration_ms": { "type": "number", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "output_excerpt": { "$ref": "#/$defs/reason_excerpt" }
      },
      "required": ["variant_id", "result", "duration_ms", "warnings", "errors"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "result": { "const": "pass" } },
            "required": ["result"]
          },
          "then": {
            "properties": {
              "warnings": { "const": 0 },
              "errors": { "const": 0 }
            },
            "not": { "required": ["output_excerpt"] }
          },
          "else": { "required": ["output_excerpt"] }
        }
      ]
    },
    "case_result": {
      "type": "object",
      "properties": {
        "nodeid": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["l0", "l1", "l2", "l3"] },
        "result": { "enum": ["pass", "fail", "error", "skipped"] },
        "duration_ms": { "type": "number", "minimum": 0 },
        "output_excerpt": { "$ref": "#/$defs/reason_excerpt" },
        "req_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^REQ-[A-Z0-9]+-[0-9]{3,}$"
          }
        }
      },
      "required": ["nodeid", "layer", "result", "duration_ms", "req_ids"],
      "additionalProperties": false,
      "if": {
        "properties": { "result": { "const": "pass" } },
        "required": ["result"]
      },
      "then": { "not": { "required": ["output_excerpt"] } },
      "else": { "required": ["output_excerpt"] }
    },
    "req_result": {
      "type": "object",
      "properties": {
        "req_id": {
          "type": "string",
          "pattern": "^REQ-[A-Z0-9]+-[0-9]{3,}$"
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "result": { "enum": ["pass", "fail", "error", "skipped"] }
      },
      "required": ["req_id", "tests", "result"],
      "additionalProperties": false
    }
  }
}
