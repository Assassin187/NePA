{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/joint-evidence.schema.json",
  "title": "NePA S6 Joint Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verification_id", "kind", "plan_ref", "plan_sha256", "workspace_tree", "parent_sha", "members"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "verification_id": {"type": "string", "pattern": "^v-[0-9a-f]{16}-[1-9][0-9]*$"},
    "kind": {"const": "lease"},
    "plan_ref": {"$ref": "#/$defs/planRef"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "workspace_tree": {"$ref": "#/$defs/sha256"},
    "parent_sha": {"$ref": "#/$defs/commit"},
    "members": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/member"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "planRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "version", "revision_seq", "epoch"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}, "revision_seq": {"type": "integer", "minimum": 0}, "epoch": {"type": "string", "pattern": "^E[0-9]+$"}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "sha256": {"$ref": "#/$defs/sha256"}, "owner_uid": {"$ref": "#/$defs/uid"}}},
    "member": {"type": "object", "additionalProperties": false, "required": ["task_uid", "task_id", "evidence_seq", "task_evidence_ref", "changed_files"], "properties": {"task_uid": {"$ref": "#/$defs/uid"}, "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}, "evidence_seq": {"type": "integer", "minimum": 1}, "task_evidence_ref": {"$ref": "#/$defs/ref"}, "changed_files": {"type": "array", "items": {"$ref": "#/$defs/file"}}}}
  }
}
