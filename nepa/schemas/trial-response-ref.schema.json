{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://nepa.local/schemas/trial-response-ref.schema.json","title":"NePA Trial Response Index","type":"object","additionalProperties":false,"required":["schema_version","lineage_id","prompt_version","model_id","trial_id","attempts","validation"],"properties":{"schema_version":{"const":"2.0"},"lineage_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"prompt_version":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$"},"model_id":{"enum":["claude","qwen","deepseek"]},"trial_id":{"type":"string","pattern":"^trial_[0-9]{3}$"},"attempts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/attempt"}},"validation":{"$ref":"#/$defs/ref"}},"$defs":{"ref":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},"nullableRef":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/ref"}]},"attempt":{"type":"object","additionalProperties":false,"required":["depth","kind","response","response_evidence","candidate","trace","effective_prompt_sha256"],"properties":{"depth":{"type":"integer","minimum":0,"maximum":2},"kind":{"enum":["initial","semantic_repair"]},"response":{"$ref":"#/$defs/ref"},"response_evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ref"}},"candidate":{"$ref":"#/$defs/nullableRef"},"trace":{"$ref":"#/$defs/ref"},"effective_prompt_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
