{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nepa.local/schemas/file-ledger.schema.json",
  "title": "NePA file implementation ledger v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "files": {"type": "array", "items": {"oneOf": [
      {"$ref": "#/$defs/slot"},
      {"$ref": "#/$defs/s5Realized"},
      {"$ref": "#/$defs/s6Realized"},
      {"$ref": "#/$defs/quarantined"}
    ]}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_version", "task_uid", "task_id"],
      "properties": {
        "plan_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "task_uid": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}
      }
    },
    "verified": {
      "type": "object", "additionalProperties": false,
      "required": ["build_variant_ids", "evidence_ref"],
      "properties": {
        "build_variant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "class", "state"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "class": {"enum": ["s5_frozen", "s6_owned"]},
        "state": {"const": "slot_only"}
      }
    },
    "s5Realized": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "class", "state", "created_in_epoch", "content_sha256", "last_commit_sha", "verified_by", "created_by_stage", "epoch_receipt_ref"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "class": {"const": "s5_frozen"},
        "state": {"const": "realized"},
        "created_in_epoch": {"type": "string", "pattern": "^E[0-9]+$"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "last_commit_sha": {"$ref": "#/$defs/commit"},
        "verified_by": {"$ref": "#/$defs/verified"},
        "created_by_stage": {"const": "s5"},
        "epoch_receipt_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "s6Realized": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "class", "state", "created_in_epoch", "content_sha256", "last_commit_sha", "verified_by", "owner_history"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "class": {"const": "s6_owned"},
        "state": {"const": "realized"},
        "created_in_epoch": {"type": "string", "pattern": "^E[0-9]+$"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "last_commit_sha": {"$ref": "#/$defs/commit"},
        "verified_by": {"$ref": "#/$defs/verified"},
        "owner_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/owner"}}
      }
    },
    "quarantined": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "class", "state", "created_in_epoch", "content_sha256", "last_commit_sha", "verified_by", "owner_history", "quarantined_in_epoch", "quarantine_path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "class": {"const": "s6_owned"},
        "state": {"const": "quarantined"},
        "created_in_epoch": {"type": "string", "pattern": "^E[0-9]+$"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "last_commit_sha": {"$ref": "#/$defs/commit"},
        "verified_by": {"$ref": "#/$defs/verified"},
        "owner_history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/owner"}},
        "quarantined_in_epoch": {"type": "string", "pattern": "^E[0-9]+$"},
        "quarantine_path": {"type": "string", "minLength": 1}
      }
    }
  }
}
